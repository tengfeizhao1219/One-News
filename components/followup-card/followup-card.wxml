<!-- 我的关注 — 跨模块聚合 Feed 覆盖层组件（One News + 情报官），UI 对齐 ui-demo/follow-up-demo.html -->
<view class="page {{themeClass}} {{visible ? 'is-open' : ''}}" style="{{revealStyle}} --nav-offset: {{navOffset}}px;"
  bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchCancel">

  <!-- 状态栏占位（BUG-20260828-005 回退：高度用 statusBarHeight 与详情页一致——
       用户反馈 menuTop 更高导致状态栏区域过高；menuTop~statusBarHeight 缝隙由 nav-bar
       底色覆盖，与详情页两段 fixed 层结构完全一致） -->
  <view class="status-bar-fill" style="height: {{statusBarHeight}}px; background-color: var(--bg-card);"></view>

  <!-- 导航栏：返回（左）+ 标题（中）·「全部标已读」移至计数行右侧（BUG-20260828-007） -->
  <view class="nav-bar" style="top: {{menuTop}}px; height: calc({{menuHeight}}px + 24rpx); background-color: var(--bg-card);">
    <view class="nav-back" bindtap="goBack" hover-class="nav-back--hover" style="top: calc({{menuHeight}}px / 2 - 32rpx);">
      <text class="nav-back-arrow">‹</text>
    </view>
    <view class="nav-title">我的关注</view>
  </view>

  <!-- 空态（BUG-20260828-004：flex 居中，无 padding-top 下推） -->
  <view class="empty-wrap" wx:if="{{isEmpty}}">
    <view class="empty-icon">🔔</view>
    <view class="empty-text">还没有关注任何话题</view>
    <view class="empty-hint">在资讯或情报详情页，长按正文即可「关注后续」</view>
    <view class="empty-btn" bindtap="goHome">去首页看看</view>
  </view>

  <!-- 列表：四态关注卡片（对齐 demo 的 follow-card 设计） -->
  <scroll-view class="list-scroll" scroll-y wx:if="{{!isEmpty}}">
    <view class="feed-head">
      <view class="fh-count">{{list.length}} 个话题 · {{unreadCount}} 条新进展</view>
      <!-- BUG-20260828-007：「全部标为已读」从导航栏移到计数行右侧（原在导航栏与胶囊重叠） -->
      <view class="fh-markall" wx:if="{{unreadCount > 0}}" bindtap="onMarkAllRead">全部标为已读</view>
    </view>

    <view class="follow-card {{item.status}}" wx:for="{{list}}" wx:key="itemId"
      data-id="{{item.itemId}}" data-module="{{item.module}}"
      bindtap="onItemTap" bindlongpress="onItemLongPress">

      <!-- 抬头：标题 + 状态徽标 -->
      <view class="fc-top">
        <view class="fc-title">{{item.title}}</view>
        <view class="fc-badge status-{{item.status}}">{{item.statusText}}</view>
      </view>

      <!-- owner 2026-09-08：话题介绍——关注时捕获的原文摘要作简短背景，
           标题下先给上下文，最新进展在此之上按时间展开 -->
      <view class="fc-intro" wx:if="{{item.knownSummary}}">{{item.knownSummary}}</view>

      <!-- 元信息：来源标签 · 追踪时间 · 已关注天数 -->
      <view class="fc-meta">
        <text class="src-tag {{item.module}}">{{item.module === 'intel' ? '情报官' : '资讯'}}</text>
        <view class="dot"></view>
        <text>每天 {{item.trackTime}} 追踪</text>
        <view class="dot"></view>
        <text>已关注 {{item.followDays}} 天</text>
      </view>

      <!-- 最新更新高亮框：有更新/已读时展示最新一条（无更新静默留白，不再展示检索提示话术） -->
      <view class="fc-summary" wx:if="{{item.latestSummary}}">
        <text class="fc-summary-date">{{item.latestDate}} 更新：</text>{{item.latestSummary}}
      </view>

      <!-- 历史时间线（点击展开） -->
      <view class="tl" wx:if="{{expanded[item.itemId]}}">
        <view class="tl-item" wx:for="{{item.timeline}}" wx:for-item="tl" wx:key="date">
          <view class="tl-date">{{tl.date}} · AI 全网追踪</view>
          <view class="tl-body">{{tl.summary}}</view>
          <view class="tl-src">来源：{{tl.sourcesCount}} 篇报道</view>
        </view>
      </view>

      <!-- 展开/收起历史 -->
      <view class="link-row" wx:if="{{item.timeline.length > 0}}">{{expanded[item.itemId] ? '收起 ▴' : '展开历史更新 ▾'}}</view>
    </view>

    <!-- owner 2026-09-08：logo 条横向铺满屏幕（回退 BUG-20260828-006 的 200rpx 收缩） -->
    <view class="brand-footer">
      <view class="brand-card">
        <logo id="fu-logo" mode="splash" fluid="{{true}}"></logo>
      </view>
      <view class="brand-text">一页 · 简单到极致</view>
    </view>
  </scroll-view>

  <!-- 长按操作面板（owner 2026-09-08：自定义底部面板——无系统「取消」按钮，点蒙层关闭） -->
  <view class="sheet-mask" wx:if="{{sheetShow}}" bindtap="onSheetMaskTap"></view>
  <view class="sheet {{sheetShow ? 'sheet--show' : ''}}" wx:if="{{sheetShow}}" catchtap="noop">
    <block wx:if="{{sheetMode === 'actions'}}">
      <view class="sheet-title">{{sheetTitle}}</view>
      <view class="sheet-item" hover-class="sheet-item--hover" bindtap="onSheetMarkRead">标记已读</view>
      <view class="sheet-item" hover-class="sheet-item--hover" bindtap="onSheetTrackTime">改追踪时间</view>
      <view class="sheet-item sheet-item--danger" hover-class="sheet-item--hover" bindtap="onSheetUnfollow">取消关注</view>
    </block>
    <block wx:if="{{sheetMode === 'tracktime'}}">
      <view class="sheet-title">每天追踪时间</view>
      <view class="sheet-item" hover-class="sheet-item--hover" wx:for="{{trackTimeOptions}}" wx:key="*this" data-v="{{item}}" bindtap="onSheetPickTime">每天 {{item}}</view>
    </block>
  </view>
</view>
