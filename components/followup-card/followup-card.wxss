/* 我的关注 — 聚合页覆盖层样式（复用 favorites 页布局语言，自包含） */

.page {
  /* overlay：固定铺满视口，覆盖在首页之上，无系统转场 */
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100vw;
  height: 100vh;
  z-index: 999;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
  /* 未展开时收为 0% 且不拦截触摸，避免盖住首页手势 */
  pointer-events: none;
  /* 圆形绽放 reveal 过渡（进入 clip-path 0%→150%；返回 150%→0%）
     0.96s = 原 0.64s 的 1.5 倍（owner 2026-08-28 要求放慢，避免视觉上“划过去”的廉价感） */
  transition: clip-path 0.96s ease, -webkit-clip-path 0.96s ease;
}
/* 展开态才接收触摸事件 */
.page.is-open {
  pointer-events: auto;
}

.status-bar-fill {
  flex-shrink: 0;
}

/* 导航栏（与胶囊对齐） */
.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 22;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.nav-back {
  position: absolute;
  left: 12rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.nav-back--hover {
  background-color: var(--bg-subtle);
}
.nav-back-arrow {
  font-size: 52rpx;
  color: var(--text-primary);
  line-height: 1;
  margin-top: -8rpx;
}

/* 空态 */
.empty-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  /* BUG-20260828-004：去掉 padding-top: var(--nav-offset)——
     flex:1 已占满导航栏下方区域且垂直居中，再加 padding-top 会把内容下推约 100px，
     导致空态图标/文字/按钮整体偏下不居中（像素采样实测偏移）。 */
}
.empty-icon {
  font-size: 96rpx;
  opacity: 0.45;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}
.empty-hint {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}
.empty-btn {
  font-size: 28rpx;
  color: var(--primary);
  padding: 14rpx 48rpx;
  border-radius: 40rpx;
  background: var(--tag-bg);
}

/* 列表 */
.list-scroll {
  /* absolute 从导航栏底部开始（nav-bar top+height），内容紧贴导航栏，无空隙遮挡 */
  position: absolute;
  left: 0;
  right: 0;
  top: calc(var(--nav-offset, 0px));
  bottom: 0;
  overflow-y: auto;
  padding: 0 0 40rpx;
  /* 顶部无 padding：内容紧贴导航栏，去绿色窄条 */
  padding-top: 0;
}

/* 汇总计数行（对齐 demo feed-head .c；BUG-20260828-007：flex 两端对齐，右侧放「全部标为已读」） */
.feed-head {
  padding: 4rpx 32rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.fh-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
}
.fh-markall {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
  flex-shrink: 0;
}

/* 关注卡片（对齐 demo .follow-card：圆角卡 + 细描边 + 轻投影） */
.follow-card {
  margin: 0 32rpx 24rpx;
  padding: 28rpx 32rpx;
  background-color: var(--bg-card);
  border-radius: 16rpx;
  border: 1rpx solid var(--divider);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  transition: opacity 0.2s;
}
.follow-card:active {
  background-color: rgba(0, 0, 0, 0.04);
}
.page--dark .follow-card:active {
  background-color: rgba(255, 255, 255, 0.06);
}

/* 抬头：标题 + 状态徽标 */
.fc-top {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.fc-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--text-primary);
}
.fc-badge {
  flex-shrink: 0;
  margin-top: 4rpx;
  font-size: 21rpx;
  font-weight: 700;
  color: #fff;
  background: var(--color-favorite); /* 有更新：红 */
  padding: 4rpx 16rpx;
  border-radius: 99rpx;
  white-space: nowrap;
}
.fc-badge.status-read { /* 已读完：绿 */
  background: #34C759;
}
.fc-badge.status-none { /* 已是最新：灰 */
  background: var(--tag-bg);
  color: var(--text-tertiary);
}

/* 元信息：来源标签 · 追踪时间 · 已关注天数 */
.fc-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  flex-wrap: wrap;
}
.src-tag {
  font-size: 21rpx;
  font-weight: 600;
  padding: 2rpx 14rpx;
  border-radius: 99rpx;
  background: var(--tag-bg);
  color: var(--text-secondary);
}
.src-tag.intel { /* 情报官紫 */
  background: var(--flash-world-tint, rgba(88, 86, 214, 0.12));
  color: var(--flash-world, #5856D6);
}
.dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--text-tertiary);
  opacity: 0.6;
}

/* owner 2026-09-08：话题介绍——关注时捕获的原文摘要作简短背景（标题下，最多 3 行截断） */
/* 话题摘要：裁切必须加在块级容器上——微信 <text> 是内联元素，max-height/overflow 在内联上不生效
   （2026-09-08 修复：此前加在 .fc-intro-text(<text>) 上导致折叠失效、整篇全展示） */
.fc-intro {
  position: relative;         /* 折叠箭头按本块定位 */
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  word-break: break-word;
}
/* 展开入口 · 圆形按钮（方案2 owner 2026-09-09 定稿+两次微调）：
   按钮是摘要末行末尾的流内元素（内联跟在截断文本/全文之后，不盖字、不占行）；
   SVG 描边箭头展开时旋转 180°，动效暗示开合。折叠文本由 JS 估宽截断（见 js introFoldText），
   故不再需要 max-height 裁切与渐隐遮罩。 */
.fc-intro-toggle {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--bg-subtle);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  vertical-align: middle;
  margin-left: 8rpx;
}
.fc-intro-toggle-icon {
  width: 20rpx;
  height: 20rpx;
  transition: transform 0.25s ease;
}
.fc-intro-toggle-icon--open {
  transform: rotate(180deg);
}

/* 最新更新高亮框（对齐 demo .fc-summary：浅底圆角卡） */
.fc-summary {
  margin-top: 20rpx;
  font-size: 25rpx;
  color: var(--text-body);
  line-height: 1.7;
  background: var(--bg-subtle);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
}
.fc-summary-date {
  font-weight: 700;
  color: var(--primary);
}

/* 历史时间线（对齐 demo .tl：左侧竖线 + 圆点） */
.tl {
  margin-top: 20rpx;
  border-left: 4rpx solid var(--divider);
  padding-left: 28rpx;
}
.tl-item {
  position: relative;
  padding-bottom: 28rpx;
}
.tl-item:last-child {
  padding-bottom: 0;
}
.tl-item::before {
  content: "";
  position: absolute;
  left: -38rpx;
  top: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--primary);
  border: 4rpx solid var(--bg-card);
}
.tl-date {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--primary);
}
.tl-body {
  font-size: 25rpx;
  color: var(--text-body);
  line-height: 1.7;
  margin-top: 6rpx;
}
.tl-src {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
}

/* 展开/收起历史 */
.link-row {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
}

/* owner 2026-09-08：logo 条横向铺满屏幕（全出血，无左右留白；回退 BUG-20260828-006 的 200rpx 收缩） */
.brand-footer {
  margin-top: 8rpx;
  padding: 0 0 60rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}
.brand-card {
  width: 100%;
  overflow: hidden;
}
.brand-text {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
  text-align: center;
}

/* owner 2026-09-08：长按操作面板（自定义底部面板——无系统「取消」按钮，点蒙层关闭） */
.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  background: var(--bg-card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 12rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
}
.sheet-item {
  padding: 26rpx 8rpx;
  font-size: 30rpx;
  color: var(--text-body);
  text-align: center;
  border-bottom: 1rpx solid var(--divider);
}
.sheet-item:last-child {
  border-bottom: none;
}
.sheet-item--hover {
  background: var(--bg-subtle);
}
.sheet-item--danger {
  color: var(--color-favorite);
}
