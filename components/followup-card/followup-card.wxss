/* 我的关注 — 聚合页覆盖层样式（复用 favorites 页布局语言，自包含） */

.page {
  /* overlay：固定铺满视口，覆盖在首页之上，无系统转场 */
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100vw;
  height: 100vh;
  z-index: 999;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
  /* 未展开时收为 0% 且不拦截触摸，避免盖住首页手势 */
  pointer-events: none;
  /* 圆形绽放 reveal 过渡（进入 clip-path 0%→150%；返回 150%→0%） */
  transition: clip-path 0.32s ease, -webkit-clip-path 0.32s ease;
}
/* 展开态才接收触摸事件 */
.page.is-open {
  pointer-events: auto;
}

.status-bar-fill {
  flex-shrink: 0;
}

/* 导航栏（与胶囊对齐） */
.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 22;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.nav-back {
  position: absolute;
  left: 12rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.nav-back--hover {
  background-color: var(--bg-subtle);
}
.nav-back-arrow {
  font-size: 52rpx;
  color: var(--text-primary);
  line-height: 1;
  margin-top: -8rpx;
}
.nav-markall {
  position: absolute;
  right: 24rpx;
  font-size: 26rpx;
  color: var(--primary);
}

/* 空态 */
.empty-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
}
.empty-icon {
  font-size: 96rpx;
  opacity: 0.45;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}
.empty-hint {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}
.empty-btn {
  font-size: 28rpx;
  color: var(--primary);
  padding: 14rpx 48rpx;
  border-radius: 40rpx;
  background: var(--tag-bg);
}

/* 列表 */
.list-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 16rpx 0 40rpx;
}

.fu-item {
  margin: 0 32rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--divider);
  background-color: var(--bg-card);
  transition: opacity 0.2s;
}
.fu-item:active {
  background-color: rgba(0, 0, 0, 0.04);
}
.page--dark .fu-item:active {
  background-color: rgba(255, 255, 255, 0.06);
}

.fu-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.fu-module {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--tag-bg);
  color: var(--tag-text);
}
.fu-module.intel {
  color: var(--flash-world); /* 情报官紫 #5856D6 */
}
.fu-module.onenews {
  color: var(--primary); /* One News 蓝 */
}
.fu-title {
  flex: 1;
  font-size: 34rpx;
  color: var(--text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.fu-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-wrap: wrap;
}
.fu-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--text-tertiary);
  flex-shrink: 0;
}
.fu-item.hasUpdate .fu-dot {
  background: var(--color-favorite); /* 红 #FF3B30 */
}
.fu-item.read .fu-dot {
  background: #34C759; /* 绿 --success */
}
.fu-item.hasUpdate .fu-status {
  color: var(--color-favorite);
  font-weight: 500;
}
.fu-item.read .fu-status {
  color: #34C759;
}
.fu-track {
  color: var(--text-tertiary);
}

/* 时间线 */
.fu-timeline {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--divider);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.fu-tl-date {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 6rpx;
}
.fu-tl-summary {
  font-size: 28rpx;
  color: var(--text-body);
  line-height: 1.6;
}
.fu-tl-src {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
}
.fu-tl-empty {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 底部品牌 */
.brand-footer {
  margin-top: 24rpx;
  padding: 0 32rpx 40rpx;
}
.brand-card {
  width: 100%;
  background: var(--bg-card);
  border-radius: 18rpx;
  overflow: hidden;
}
.brand-text {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
  text-align: center;
}
