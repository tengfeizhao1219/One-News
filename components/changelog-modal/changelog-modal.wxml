<!-- changelog-modal v1.0 · 品牌弹窗（FS 2026-08-09）
     依赖 logo 组件渲染 wordmark 主标（自动跟随深浅模式）
     数据源 config/changelog.js，由 properties.latest 传入或自动取 currentVersion -->
<view class="cm-overlay {{visible ? 'cm-show' : ''}} {{animShow ? 'cm-fade' : ''}}" bindtap="onOverlayTap">
  <view class="cm-card" catchtap="onCardTap">

    <!-- 顶部横向 header：logo 左 + 版本号/日期 右（2026-08-26 用户确认） -->
    <view class="cm-header">
      <view class="cm-logo">
        <logo id="modal-logo" mode="wordmark" size="240"></logo>
      </view>
      <view class="cm-header-right">
        <view class="cm-version">{{version}}</view>
        <view class="cm-date" wx:if="{{date}}">{{date}}</view>
      </view>
    </view>

    <!-- 顶部横条进度(2026-08-26 家族化,替代侧边滚动条) -->
    <view class="cm-progress"><view class="cm-progress-bar" style="width: {{progressPercent}}%;"></view></view>

    <!-- 滚动日志内容（下方区域） -->
    <scroll-view scroll-y class="cm-body" enhanced show-scrollbar="{{false}}" bindscroll="onScroll">
          <block wx:for="{{sections}}" wx:key="label" wx:for-item="section">
            <view class="cm-section-title cm-{{section.type}}">{{section.label}}</view>
            <view class="cm-item" wx:for="{{section.items}}" wx:key="title" wx:for-item="item">
              <view class="cm-dot cm-dot--{{section.type}}"></view>
              <view class="cm-item-body">
                <view class="cm-item-title">{{item.title}}</view>
                <view class="cm-item-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
              </view>
            </view>
          </block>
    </scroll-view>

    <!-- 底部：知道了按钮 -->
    <view class="cm-footer">
      <view class="cm-btn" hover-class="cm-btn--hover" hover-stay-time="100" bindtap="onKnowTap">知道了</view>
    </view>
  </view>
</view>
