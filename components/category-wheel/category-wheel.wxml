<!-- 左侧垂直分类滚轮（RQ-15-D / UI-B7 §3.2） -->
<!-- v5.3-final：选中项固定顶部第二行锚定；触摸实时切分类 + 松手 snap + 震动 -->
<view
  class="wheel {{touching ? 'active' : ''}}"
  style="height: {{wheelHeight}}rpx;"
  catchtouchstart="onTouchStart"
  catchtouchmove="onTouchMove"
  catchtouchend="onTouchEnd"
  catchtouchcancel="onTouchEnd">

  <view class="wheel-list" style="height: {{listHeight}}rpx; transform: translateY({{translateY}}rpx); transition: {{touching ? 'none' : 'transform 300ms cubic-bezier(.4,0,.2,1)'}};">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="wheel-item {{item.id === activeId ? 'active' : ''}}"
      style="height: {{itemHeight}}rpx; line-height: {{itemHeight}}rpx;">
      <text class="wheel-label {{item.id === activeId ? 'active' : ''}}">{{item.name}}</text>
    </view>
  </view>
</view>
