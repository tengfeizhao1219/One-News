/* 左侧垂直分类滚轮（RQ-15-D / UI-B7 §3.2 · v5.3-final） */
/* FE-3（2026-08-05）：硬编码 rgba → D-02 §5 Token 表 --wheel-* 变量 */
/* BUG-20260806-005（2026-08-06）：选中态字体淡蓝 --primary + 去背景高亮（owner 11:52 追修裁定） */
/* D-07 S2（G-03）：组件默认 styleIsolation=isolated，页面根节点的 .page--dark .wheel-label
   选择器无法命中组件内部；改用 CSS 变量继承（var() 穿透样式隔离）——
   --wheel-* 深色/浅色值定义在 app.wxss 的 .page--dark/.page--light 变量块，
   手动深色 + 系统浅色时组件文字取深色值，保证可见。勿改回 media query 或前缀选择器。 */

.wheel {
  position: relative;
  overflow: hidden;
  width: 128rpx;
  /* BUG-20260806-013 (FE): 撑满父容器（父 .panel-wheel 高度=panel-body 高度，大屏约 1300px），
     触摸热区覆盖整个面板左侧，分类下方空白也能上下滑动切换分类。
     配合下面的 flex 居中让 .wheel-list 垂直居中显示。 */
  height: 100%;
  display: flex;
  align-items: center;
  /* BUG-20260806-008②（AC-RQ15-19）+ BUG-20260806-010②（owner 18:34）: 触摸热区外扩 ——
     视觉宽度不变（box-sizing + padding），但触摸命中区域向右扩展 112rpx（128+112=240rpx，
     覆盖面板左 ~64%），空白/行间隙均可滚动；.panel-scroll left:128rpx 不变（视觉滚轮仍 128rpx） */
  padding-right: 112rpx;
  margin-right: -112rpx;
  box-sizing: content-box;
  opacity: var(--wheel-opacity-idle, 0.35);          /* idle 默认态 */
  transition: opacity 300ms ease-out;
}

.wheel.active {
  opacity: var(--wheel-opacity-active, 0.92);        /* active 激活态 */
}

/* 列表整体（高度由内部 item 自然撑开，flex 居中使列表在容器中央） */
.wheel-list {
  width: 100%;
  will-change: transform;
}

/* 单项 */
.wheel-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.wheel-label {
  font-size: 24rpx;
  color: var(--wheel-text-selected, rgba(0, 0, 0, 0.5));  /* idle 态用选中色（v2.2 颜色不加深） */
  font-weight: 500;
  padding: 0 8rpx;
  border-radius: 10rpx;
  transition: color 300ms ease-out;
}

/* BUG-20260806-005（owner 2026-08-06 08:02 首裁 + 11:52 追修）：选中态字体淡蓝 --primary（浅 #007AFF / 暗 #0A84FF），
   背景高亮去除（不再使用 --wheel-bg-selected）。token 由 app.wxss .page--dark/.page--light 变量块注入，
   var() 穿透样式隔离；未定义时回退 var(--primary)。 */
.wheel-label.active {
  color: var(--wheel-text-selected-color, var(--primary, #007AFF));
  font-size: 24rpx;
  font-weight: 500;
}

/* 激活态（触摸中）：仅温和放大，颜色字号均不变 */
.wheel.active .wheel-label.active {
  transform: scale(var(--wheel-scale-active, 1.08));
  transform-origin: center center;
  transition: transform 150ms ease-out;
}
