<!-- 详情页 - 跨分类阅读模式 + 底部操作栏 -->
<!-- UX-FIX-F13: 根节点注入 --font-scale / --font-scale-meta，修复缩放变量从未进入 DOM 的断链 -->
<view
  class="page {{themeClass}}"
  data-font-scale="{{fontScaleTier}}"
  style="--font-scale: {{_fontScaleValue}}; --font-scale-meta: {{_metaScaleValue}}; --page-h: {{pageH}}px; --nav-offset: {{navOffset}}px;">

  <!-- 顶部导航栏：返回（左）+ 进度指示（右）· D-09 v1.2（BUG-20260806-007）
       top=menuTop（无上呼吸）；height=menuHeight+24rpx（仅下扩展 12px） -->
  <view class="nav-bar" style="top: {{menuTop}}px; height: calc({{menuHeight}}px + 24rpx);">
    <!-- BUG-20260806-003: 第 3 层（detail）使用返回按钮（navigateBack），非主页按钮
         D-09 v1.2: explicit 锚定胶囊中心（按钮中心 = 胶囊中心，不依赖条带内居中） -->
    <!-- BUG-20260806-009: 按钮高 64rpx，中心对齐胶囊中心 → top = menuTop + menuHeight/2 - 64rpx/2 -->
    <view class="nav-back" bindtap="goBack" hover-class="nav-back--hover" style="top: calc({{menuTop}}px + {{menuHeight}}px / 2 - 32rpx);">
      <text class="nav-back-icon">‹</text>
    </view>
    <view class="nav-position" wx:if="{{total > 1}}">
      <text>{{positionText}}</text>
      <text wx:if="{{showCrossingCategory}}" class="position-category" style="color: {{flashColor}};"> · {{showCrossingCategory}}</text>
    </view>
    <!-- 阅读进度条置于导航栏底部（D-09 v1.2: 无底槽，胶囊下 12px） -->
    <view class="nav-progress" wx:if="{{pageState === 'ready'}}">
      <view class="nav-progress-bar" style="width: {{progressPercent}}%;"></view>
    </view>
  </view>

  <!-- 骨架屏（加载中） -->
  <view class="detail-skeleton" wx:if="{{pageState === 'loading'}}">
    <view class="sk-block sk-title"></view>
    <view class="sk-block sk-line" style="width: 80%"></view>
    <view class="sk-block sk-line" style="width: 65%"></view>
    <view class="sk-block sk-line" style="width: 90%"></view>
    <view class="sk-block sk-line" style="width: 50%"></view>
  </view>

  <!-- 错误 / 空状态 -->
  <view class="state-container" wx:if="{{pageState === 'error' || pageState === 'empty'}}">
    <view class="state-icon">{{pageState === 'empty' ? '-' : '!'}}</view>
    <view class="state-message">{{errorMessage || '加载失败，请返回重试'}}</view>
    <view class="state-retry" bindtap="goBack">返回</view>
  </view>

  <!-- 内容 -->
  <!-- UX-FIX: 把 touch 事件直接绑在 scroll-view 上，避免 enhanced 模式下事件冒泡到外层 page 不一致 -->
  <scroll-view
    wx:if="{{pageState === 'ready'}}"
    class="content"
    scroll-y
    scroll-top="{{scrollTop}}"
    enhanced
    show-scrollbar="{{false}}"
    upper-threshold="10"
    lower-threshold="50"
    bindscroll="onContentScroll"
    bindscrolltoupper="onScrollToUpper"
    bindscrolltolower="onScrollToLower"
    bindtouchstart="onTouchStart"
    bindtouchend="onTouchEnd">

    <view class="article {{animClass}}">
      <view class="detail-body">
        <!-- 标题 -->
        <view class="detail-title {{news.title ? '' : 'detail-title--empty'}}">{{news.title || '无标题'}}</view>

        <!-- 元信息 -->
        <view class="detail-meta">
          <view class="category-tag">{{news.categoryName}}</view>
          <text wx:if="{{news.source}}">{{news.source}}</text>
          <text wx:if="{{news.source && news.time}}">·</text>
          <text>{{news.time}}</text>
          <!-- S7: owner 2026-08-02 决策，删除原文链接入口 -->
        </view>

        <!-- 正文 -->
        <view class="detail-text">
          <block wx:for="{{paragraphs}}" wx:key="*this">
            <view class="text-p">{{item}}</view>
          </block>
        </view>

        <!-- 底部返回已移除 -->
      </view>
    </view>
  </scroll-view>


  <!-- 网络兜底 Toast -->
  <view class="network-toast {{networkToastVisible ? 'show' : ''}}" wx:if="{{networkToastVisible}}">
    <text>🟡 网络开小差，下拉重试</text>
  </view>

  <!-- 底部固定滑动提示条（UI-B7 §3.5，固定于操作栏上方，不随内容滚动） -->
  <view class="fixed-swipe-hint {{showSwipeHint ? '' : 'hide'}}" wx:if="{{pageState === 'ready'}}">
    <image class="fixed-swipe-hint-icon-img" src="/assets/icons/swipe{{isDark ? '-dark' : ''}}.svg" mode="aspectFit"></image>
    <text class="fixed-swipe-hint-text">上滑阅读下一条</text>
  </view>

  <!-- 底部操作栏（收藏左 + 分享右） -->
  <view class="detail-bottom-bar" wx:if="{{pageState === 'ready'}}">
    <view class="bottom-bar-btn {{isFavorited ? 'is-favorited' : ''}} {{heartAnim ? 'heart-anim' : ''}}" bindtap="onToggleFavorite">
      <!-- BUG-FS-20260805-001: 深色模式用白色版星星（image 渲染 SVG 时 currentColor 不生效→黑色） -->
      <image wx:if="{{!isFavorited}}" class="bottom-bar-icon-img" src="/assets/icons/favorite{{isDark ? '-dark' : ''}}.svg" mode="aspectFit"></image>
      <image wx:if="{{isFavorited}}" class="bottom-bar-icon-img" src="/assets/icons/favorite-fill.svg" mode="aspectFit"></image>
      <!-- BUG-20260805-004：移除 inline style 让"已收藏"文字保持默认色，仅 icon 红色 -->
      <text class="bottom-bar-label">{{isFavorited ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="bottom-bar-btn share-btn-reset" open-type="share">
      <text class="bottom-bar-icon">↗</text>
      <text class="bottom-bar-label">分享</text>
    </button>
  </view>

  <!-- 隐藏 Canvas（分享占位图预生成） -->
  <share-card id="share-card" canvasWidth="{{400}}" canvasHeight="{{300}}"></share-card>
</view>
