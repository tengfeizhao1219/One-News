<!-- 详情页 - 跨分类阅读模式 + 底部操作栏 -->
<!-- UX-FIX-F13: 根节点注入 --font-scale / --font-scale-meta，修复缩放变量从未进入 DOM 的断链 -->
<view
  class="page {{themeClass}}"
  data-font-scale="{{fontScaleTier}}"
  style="--font-scale: {{_fontScaleValue}}; --font-scale-meta: {{_metaScaleValue}}; --page-fs: 0.875; --page-h: {{pageH}}px; --nav-offset: {{navOffset}}px; --status-bar-height: {{statusBarHeight}}px;">

  <!-- 顶部导航栏：返回（左）+ 进度指示（右）· D-09 v1.2（BUG-20260806-007）
       top=menuTop（无上呼吸）；height=menuHeight+24rpx（仅下扩展 12px） -->
  <!-- BUG-20260806-009 v3: 状态栏不透明背景层（custom 模式下 setNavigationBarColor 无效，
       用 fixed 等高背景层覆盖状态栏区域，背景色与页面一致） -->
  <view class="status-bar-fill" style="height: {{statusBarHeight}}px; background-color: var(--bg-card);"></view>

  <view class="nav-bar" style="top: {{menuTop}}px; height: calc({{menuHeight}}px + 24rpx); background-color: var(--bg-card);">
    <!-- BUG-20260806-027: 第 3 层（detail）顶部按钮由「返回」改为「首页」。
         原因：详情页可从分享卡片冷启动进入（页面栈无上级），navigateBack 失效；
         goHome 用 wx.reLaunch 重建首页，不依赖页面栈，任何入口都能返回首页。
         D-09 v1.2: explicit 锚定胶囊中心（按钮中心 = 胶囊中心，不依赖条带内居中） -->
    <!-- BUG-20260806-009 follow-up: 按钮是 .nav-bar 子元素 absolute 定位，相对 nav-bar 偏移。
         nav-bar.top = menuTop（屏幕坐标），按钮中心 = 胶囊中心（屏幕坐标 menuTop+menuHeight/2）
         → 按钮 top（相对 nav-bar）= menuHeight/2 - 32rpx（按钮半高）。
         之前公式多算了 menuTop（双重定位 bug）。 -->
    <view class="nav-home" bindtap="goHome" hover-class="nav-home--hover" style="top: calc({{menuHeight}}px / 2 - 32rpx);">
      <!-- BUG-FS-20260805-001: 深色模式切换白色版 icon -->
      <image class="nav-home-icon-img" src="/assets/icons/home{{isDark ? '-dark' : ''}}.svg" mode="aspectFit"></image>
    </view>
    <view class="nav-position" wx:if="{{total > 1}}">
      <text>{{positionText}}</text>
      <text wx:if="{{showCrossingCategory}}" class="position-category" style="color: {{flashColor}};"> · {{showCrossingCategory}}</text>
    </view>
    <!-- 阅读进度条置于导航栏底部（D-09 v1.2: 无底槽，胶囊下 12px） -->
    <view class="nav-progress" wx:if="{{pageState === 'ready'}}">
      <view class="nav-progress-bar" style="width: {{progressPercent}}%;"></view>
    </view>
  </view>

  <!-- 骨架屏（加载中）· D-04 v0.2 §4.1：复用版式骨架三段式——
       标题区 2 行灰块 + 元信息行细灰条 + 正文 4-5 段灰条，首段前留「AI 解读生成中，请稍后」弱提示 -->
  <view class="detail-skeleton" wx:if="{{pageState === 'loading'}}">
    <!-- 标题区：2 行灰块 -->
    <view class="sk-block sk-title"></view>
    <view class="sk-block sk-title sk-title--second"></view>
    <!-- 元信息行占位（代替 科技 | InfoQ · 时间 的 meta 行） -->
    <view class="sk-block sk-meta"></view>
    <!-- 正文区：首段前弱提示 + 4 段灰条 -->
    <view class="skeleton-ai-tip">AI 解读生成中，请稍后</view>
    <view class="sk-block sk-line" style="width: 100%"></view>
    <view class="sk-block sk-line" style="width: 92%"></view>
    <view class="sk-block sk-line" style="width: 96%"></view>
    <view class="sk-block sk-line" style="width: 78%"></view>
    <view class="sk-block sk-line" style="width: 88%"></view>
  </view>

  <!-- 空态 / 错误态 · D-04 v0.2 §4.2：去按钮、温和文案、居中 logo-avatar-circle。
       整体只有 logo + 主文案 + 副文案 三个元素，零操作负担（用户用顶部导航自决去留） -->
  <view class="state-container" wx:if="{{pageState === 'error' || pageState === 'empty'}}">
    <view class="state-avatar">
      <logo mode="avatar-circle" size="128" />
    </view>
    <view class="state-title" wx:if="{{pageState === 'empty'}}">这条内容不见了</view>
    <view class="state-title" wx:else>网络开了个小差</view>
    <view class="state-sub" wx:if="{{pageState === 'empty'}}">可能是发布方撤下了，不用着急，看看别的吧</view>
    <view class="state-sub" wx:else>等信号好的时候再回来，随时都在的</view>
  </view>

  <!-- 内容 -->
  <!-- UX-FIX: 把 touch 事件直接绑在 scroll-view 上，避免 enhanced 模式下事件冒泡到外层 page 不一致 -->
  <scroll-view
    wx:if="{{pageState === 'ready'}}"
    class="content {{animClass}}"
    scroll-y
    scroll-top="{{scrollTop}}"
    enhanced
    show-scrollbar="{{false}}"
    upper-threshold="10"
    lower-threshold="50"
    bindscroll="onContentScroll"
    bindscrolltoupper="onScrollToUpper"
    bindscrolltolower="onScrollToLower"
    bindtouchstart="onTouchStart"
    bindtouchend="onTouchEnd">

    <view class="article">
      <!-- 标题（2026-08-22：移到 detail-body 外固定，搜索面板推上时标题钉顶不动，对齐 intel 版） -->
      <view class="detail-title {{searchOpen ? 'is-search' : ''}} {{news.title ? '' : 'detail-title--empty'}}">{{news.title || '无标题'}}</view>

      <view class="detail-body rest {{searchOpen ? 'up' : ''}}">
        <!-- 元信息 -->
        <view class="detail-meta">
          <view class="category-tag">{{news.categoryName}}</view>
          <!-- 官方源：来源名由下方「出处」归因块承载，meta 行不重复显示（轻量化） -->
          <text wx:if="{{news.source && news.contentSource !== 'official_rss'}}">{{news.source}}</text>
          <text wx:if="{{news.source && news.contentSource !== 'official_rss' && news.time}}">·</text>
          <text>{{news.time}}</text>
        </view>

        <!-- 正文 -->
          <view class="detail-text">
          <!-- AI 解读标识（版权策略：AI 独立解读 ≠ 原文复述，需法规标识） -->
          <view class="ai-interpretation-badge" wx:if="{{news.contentSource === 'ai_interpretation'}}">
            <text class="ai-chip">AI 解读</text>
            <text class="ai-badge-desc">本文由 AI 独立解读生成，仅供参考</text>
            <!-- D-02 v0.2 §2.2：「查看原文」高亮内联于提示语之后（非独立成行），交互走「复制链接+引导外部浏览器打开」 -->
            <text wx:if="{{news.sourceUrl}}" class="meta-source-link" bindtap="onCopySourceUrl">查看原文 ›</text>
          </view>
          <!-- R1 合规降级标识（PRD §2.2/§2.5）: contentSource 被标记为 r1_blocked_fulltext 时
               说明后端拦截了抓取的全文，前端只显示 AI 摘要，明确向用户说明非原文 -->
          <view class="ai-interpretation-badge ai-badge--compliance" wx:if="{{news.contentSource === 'r1_blocked_fulltext'}}">
            <text class="ai-chip">AI 摘录</text>
            <text class="ai-badge-desc">已依版权合规策略过滤原文全文，仅显示 AI 摘要</text>
            <text wx:if="{{news.sourceUrl}}" class="meta-source-link" bindtap="onCopySourceUrl">查看原文 ›</text>
          </view>
          <!-- 官方源归因标识（contentSource==='official_rss' 时渲染；v1.2 路线1 修订：
               AI 解读正文可展示，版权红线是"不缓存/不展示原文全文"，解读为加工产物；
               语义区分：官方源 ≠ AI 生成，出处跳源站 H5） -->
          <view class="source-attribution-badge" wx:if="{{news.contentSource === 'official_rss'}}">
            <text class="source-chip">{{news.sourceName || news.source}}</text>
            <text class="source-badge-desc">内容整理自官方源</text>
            <text wx:if="{{news.sourceUrl}}" class="meta-source-link" bindtap="onCopySourceUrl">出处 ↗</text>
          </view>
          <!-- 占位欢迎新闻：关于本小程序介绍（contentSource==='app_intro'，品牌绿 hero + 分段标题卡片） -->
          <block wx:if="{{news.isAppIntro && news.introBlocks.length}}">
            <view class="app-intro-hero">
              <view class="app-intro-logo"><logo mode="avatar-circle" size="72" /></view>
              <view class="app-intro-hero-text">
                <text class="app-intro-title">关于一页</text>
                <text class="app-intro-tagline">极简资讯，安静地躺在这里</text>
              </view>
            </view>
            <view class="app-intro-body">
              <block wx:for="{{news.introBlocks}}" wx:key="index">
                <view wx:if="{{item.type === 'title'}}" class="app-intro-h">{{item.text}}</view>
                <view wx:else class="app-intro-p">{{item.text}}</view>
              </block>
            </view>
          </block>
          <block wx:else>
            <block wx:for="{{paragraphs}}" wx:key="*this">
              <view class="text-p">{{item}}</view>
            </block>
          </block>
          <!-- PRD §2.5：paragraphs 为空时 inline 空态（AI 解读/摘要皆无时兜底） -->
          <view class="inline-empty" wx:if="{{paragraphs.length === 0 && news.contentSource}}">
            <text class="inline-empty-icon">·</text>
            <text class="inline-empty-text">内容暂不可用</text>
          </view>
          <!-- 一页说：AI 独立观点（owner 2026-08-12 拍板方案 B 引用块；字段 aiOpinion 由 FS 返回，仅非空渲染） -->
          <view class="yiyieshuo-card" wx:if="{{news.aiOpinion}}">
            <view class="yiyieshuo-head">
              <text class="yiyieshuo-label">一页说</text>
            </view>
            <text class="yiyieshuo-text">{{news.aiOpinion}}</text>
            <view class="yiyieshuo-info-entry" bindtap="onToggleOpinionInfo">
              <text class="yiyieshuo-info-ic">i</text>
              <text class="yiyieshuo-info-label">关于一页说</text>
              <text class="yiyieshuo-chev">{{opinionInfoExpanded ? '▴' : '▾'}}</text>
            </view>
            <view class="yiyieshuo-disclosure" wx:if="{{opinionInfoExpanded}}">
              <view class="yiyieshuo-disclosure-box">
                <text class="yiyieshuo-disclosure-title">关于「一页说」</text>
                <text class="yiyieshuo-disclosure-desc">这是 AI 根据最近相关新闻的汇总与分析生成的独立观点，可能存在不准确或偏差，仅供参考，不构成任何投资、决策或专业建议。请以官方权威信源为准。</text>
              </view>
            </view>
          </view>
          <!-- PRD §2.4 S1：references 参考来源折叠卡片 -->
          <view class="references-card" wx:if="{{news.references && news.references.length > 0}}">
            <view class="references-header" bindtap="onToggleReferences" data-expanded="{{referencesExpanded}}">
              <text class="references-title">参考来源</text>
              <text class="references-toggle">{{referencesExpanded ? '收起' : '展开'}}></text>
            </view>
            <view class="references-list" wx:if="{{referencesExpanded}}">
              <block wx:for="{{news.references}}" wx:key="url">
                <view class="reference-item" bindtap="onCopyRefUrl" data-url="{{item.url}}" data-title="{{item.title}}">
                  <text class="reference-title">{{item.title || item.url}}</text>
                  <text class="reference-url">{{item.url}}</text>
                </view>
              </block>
            </view>
          </view>
        </view>

        <!-- 底部返回已移除 -->

        <!-- ===== 深挖历史区（2026-08-22：作为正文内容的一部分保留在页面底部，对齐 intel 版） ===== -->
        <view class="dig-history" id="dig-history">
          <view class="dig-title">深挖历史</view>
          <view class="dig-empty" wx:if="{{!digGroups.length}}">还没有深挖记录，点右下角搜索按钮开始了解</view>
          <block wx:for="{{digGroups}}" wx:key="query" wx:for-item="g" wx:for-index="gi">
            <view class="dig-group {{g.open ? 'open' : ''}}">
              <view class="dig-group-head" bindtap="onToggleDigGroup" data-gi="{{gi}}" hover-class="dig-group-head--hover">
                <view class="dig-group-info">
                  <text class="dig-group-q">「{{g.query}}」</text>
                  <text class="dig-group-meta">第 {{g.entries[0].seq}} 次深挖 · 最近 {{g.entries[0].time}}</text>
                </view>
                <text class="dig-group-arrow">{{g.open ? '▾' : '▸'}}</text>
              </view>
              <view class="dig-group-body" wx:if="{{g.open}}">
                <view class="dig-entry" wx:for="{{g.entries}}" wx:key="index" wx:for-item="en">
                  <text class="dig-entry-time">第 {{en.seq}} 次深挖 · {{en.time}}</text>
                  <block wx:for="{{en.sections}}" wx:key="index" wx:for-item="sec">
                    <view class="search-sec-head" wx:if="{{sec.type === 'heading'}}">{{sec.text}}</view>
                    <view class="search-sec-bullet" wx:elif="{{sec.type === 'bullet'}}">
                      <view class="search-sec-bdot"></view>
                      <text class="search-sec-btext">{{sec.text}}</text>
                    </view>
                    <view class="search-sec-para" wx:else>{{sec.text}}</view>
                  </block>
                  <view class="dig-sources" wx:if="{{en.sources.length}}">
                    <view class="dig-sources-head" bindtap="onToggleEntrySources" data-gi="{{gi}}" data-ei="{{index}}" hover-class="dig-sources-head--hover">
                      <text class="dig-sources-title">参考来源（{{en.sources.length}}）</text>
                      <text class="dig-sources-arrow">{{en.sourcesExpanded ? '收起' : '展开'}} ›</text>
                    </view>
                    <block wx:if="{{en.sourcesExpanded}}">
                      <view class="dig-src" wx:for="{{en.sources}}" wx:key="url" catchtap="onOpenSource" data-url="{{item.url}}" data-title="{{item.title}}" hover-class="dig-src--hover">
                        <text class="dig-src-title">{{item.title}}</text>
                        <text class="dig-src-url">{{item.url}}</text>
                      </view>
                    </block>
                  </view>
                </view>
              </view>
            </view>
          </block>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 网络兜底 Toast -->
  <view class="network-toast {{networkToastVisible ? 'show' : ''}}" wx:if="{{networkToastVisible}}">
    <text>🟡 网络开小差，下拉重试</text>
  </view>

  <!-- BUG-20260806-025: 浏览完毕居中 toast（替代原顶部 wx.showToast） -->
  <view class="finish-toast {{finishToastVisible ? 'show' : ''}}" wx:if="{{finishToastVisible}}">
    <text>当前新闻已浏览完毕，稍等会儿再来看吧</text>
  </view>

  <!-- 底部操作栏（收藏左 + 分享右） -->
  <view class="detail-bottom-bar" wx:if="{{pageState === 'ready'}}">
    <view class="bottom-bar-btn {{isFavorited ? 'is-favorited' : ''}} {{heartAnim ? 'heart-anim' : ''}}" bindtap="onToggleFavorite">
      <!-- BUG-FS-20260805-001: 深色模式用白色版星星（image 渲染 SVG 时 currentColor 不生效→黑色） -->
      <image wx:if="{{!isFavorited}}" class="bottom-bar-icon-img" src="/assets/icons/favorite{{isDark ? '-dark' : ''}}.svg" mode="aspectFit"></image>
      <image wx:if="{{isFavorited}}" class="bottom-bar-icon-img" src="/assets/icons/favorite-fill.svg" mode="aspectFit"></image>
      <!-- BUG-20260805-004：移除 inline style 让"已收藏"文字保持默认色，仅 icon 红色 -->
      <text class="bottom-bar-label">{{isFavorited ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="bottom-bar-btn share-btn-reset" open-type="share">
      <!-- BUG-20260806-027: 分享图标由文本「↗」改为 SVG image（与收藏一致，避免发灰；
           主题色跟随 currentColor，深色模式用白色版） -->
      <image class="bottom-bar-icon-img" src="/assets/icons/share{{isDark ? '-dark' : ''}}.svg" mode="aspectFit"></image>
      <text class="bottom-bar-label">分享</text>
    </button>
  </view>

  <!-- 隐藏 Canvas（分享占位图预生成） -->
  <share-card id="share-card" canvasWidth="{{400}}" canvasHeight="{{300}}"></share-card>

  <!-- ===== 话题搜索深挖面板（2026-08-22 从 intel 详情页平移） ===== -->
  <scroll-view class="search-panel {{searchOpen ? 'open' : ''}}" id="search-area" style="top: {{searchPanelTop}};" scroll-y scroll-into-view="{{digScrollTo}}" enhanced show-scrollbar="{{false}}" bindscroll="onSearchScroll" bindtouchstart="onPanelTouchStart" bindtouchmove="onPanelTouchMove" bindtouchend="onPanelTouchEnd">
    <view class="search-panel-inner">
    <view class="search-bar">
      <view class="deep-quick" hover-class="deep-quick--hover" bindtap="onDeepQuick">
        <text class="quick-t">围绕「{{searchQuickTitle}}」继续深挖</text>
        <text class="quick-s">AI 联网搜索更多资料 · 生成更详细介绍</text>
      </view>
      <view class="search-box">
        <view class="search-line-wrap">
          <input class="search-input {{searchQueried ? 'search-input--done' : ''}}" value="{{searchQuery}}" bindinput="onSearchInput" bindfocus="onSearchFocus" placeholder="输入你感兴趣的话题…" placeholder-class="search-placeholder" confirm-type="search" bindconfirm="onSearchSubmit" />
          <view class="search-line">
            <view class="search-line-progress {{searchProgress ? 'on' : ''}}"></view>
          </view>
        </view>
        <view class="search-btn {{searchLoading ? 'is-loading' : ''}}" hover-class="search-btn--hover" bindtap="onSearchSubmit">
          <block wx:if="{{searchLoading}}">
            <image class="search-btn-icon nav-light" src="/assets/icons/search-blue.svg" mode="aspectFit"></image>
            <image class="search-btn-icon nav-dark" src="/assets/icons/search-blue-dark.svg" mode="aspectFit"></image>
          </block>
          <block wx:else>
            <image class="search-btn-icon nav-light" src="/assets/icons/search.svg" mode="aspectFit"></image>
            <image class="search-btn-icon nav-dark" src="/assets/icons/search-dark.svg" mode="aspectFit"></image>
          </block>
        </view>
      </view>
    </view>

    <view class="search-status" wx:if="{{searchLoading}}"><text class="search-status-txt">正在为你搜索…</text></view>
    <view class="search-hint" wx:if="{{searchHint}}">{{searchHint}}</view>

    <!-- 2026-08-22：不相关时推荐问题（点击直接搜索） -->
    <block wx:if="{{relatedQuestions.length}}">
      <view class="rel-title">猜你想搜 ✦</view>
      <view class="rel-item" wx:for="{{relatedQuestions}}" wx:key="*this" bindtap="onRelatedTap" data-query="{{item}}" hover-class="rel-item--hover">
        <view class="rel-icon">➤</view>
        <text class="rel-text">{{item}}</text>
        <text class="rel-chev">›</text>
      </view>
    </block>

    <view class="dig-list" wx:if="{{digGroups.length}}">
      <block wx:for="{{digGroups}}" wx:key="query" wx:for-item="g" wx:for-index="gi">
        <view class="dig-group {{g.open ? 'open' : ''}}" id="dig-group-{{gi}}">
          <view class="dig-group-head" bindtap="onToggleDigGroup" data-gi="{{gi}}" hover-class="dig-group-head--hover">
            <view class="dig-group-info">
              <text class="dig-group-q">「{{g.query}}」</text>
              <text class="dig-group-meta">第 {{g.entries[0].seq}} 次深挖 · 最近 {{g.entries[0].time}}</text>
            </view>
            <text class="dig-group-arrow">{{g.open ? '▾' : '▸'}}</text>
          </view>
          <view class="dig-group-body" wx:if="{{g.open}}">
            <view class="dig-entry" wx:for="{{g.entries}}" wx:key="index" wx:for-item="en">
              <text class="dig-entry-time">第 {{en.seq}} 次深挖 · {{en.time}}</text>
              <block wx:for="{{en.sections}}" wx:key="index" wx:for-item="sec">
                <view class="search-sec-head" wx:if="{{sec.type === 'heading'}}">{{sec.text}}</view>
                <view class="search-sec-bullet" wx:elif="{{sec.type === 'bullet'}}">
                  <view class="search-sec-bdot"></view>
                  <text class="search-sec-btext">{{sec.text}}</text>
                </view>
                <view class="search-sec-para" wx:else>{{sec.text}}</view>
              </block>
              <view class="dig-sources" wx:if="{{en.sources.length}}">
                <view class="dig-sources-head" bindtap="onToggleEntrySources" data-gi="{{gi}}" data-ei="{{index}}" hover-class="dig-sources-head--hover">
                  <text class="dig-sources-title">参考来源（{{en.sources.length}}）</text>
                  <text class="dig-sources-arrow">{{en.sourcesExpanded ? '收起' : '展开'}} ›</text>
                </view>
                <block wx:if="{{en.sourcesExpanded}}">
                  <view class="dig-src" wx:for="{{en.sources}}" wx:key="url" catchtap="onOpenSource" data-url="{{item.url}}" data-title="{{item.title}}" hover-class="dig-src--hover">
                    <text class="dig-src-title">{{item.title}}</text>
                    <text class="dig-src-url">{{item.url}}</text>
                  </view>
                </block>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
    </view>
  </scroll-view>

  <!-- 搜索悬浮按钮（右下角，自绘放大镜） -->
  <view class="fab-search {{searchOpen ? 'on' : ''}}" hover-class="fab-search--hover" bindtap="onToggleSearch">
    <image class="fab-search-icon nav-light" src="/assets/icons/search.svg" mode="aspectFit"></image>
    <image class="fab-search-icon nav-dark" src="/assets/icons/search-dark.svg" mode="aspectFit"></image>
  </view>
</view>
