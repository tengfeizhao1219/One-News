<!-- 详情页 - 跨分类阅读模式 + 底部操作栏 -->
<view
  class="page"
  data-font-scale="{{fontScaleTier}}"
  bindtouchstart="onTouchStart"
  bindtouchend="onTouchEnd">

  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight + 6}}px;"></view>

  <!-- 顶部栏：返回（左）+ 进度指示（右） -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <text>← 返回</text>
    </view>
    <view class="nav-position" wx:if="{{total > 1}}">
      <text>{{positionText}}</text>
      <text wx:if="{{showCrossingCategory}}" class="position-category" style="color: {{flashColor}};"> · {{showCrossingCategory}}</text>
    </view>
  </view>

  <!-- 跨分类闪烁条 -->
  <view wx:if="{{flashVisible}}" class="category-flash" style="background-color: {{flashColor}};"></view>

  <!-- 内容 -->
  <scroll-view
    class="content"
    scroll-y
    scroll-top="{{scrollTop}}"
    enhanced
    show-scrollbar="{{false}}"
    bindscroll="onContentScroll">

    <view class="article {{animClass}}">
      <view class="detail-body">
        <!-- 标题 -->
        <view class="detail-title">{{news.title}}</view>

        <!-- 元信息（UX-BUG07: 查看原文移入同行，字号统一为 22rpx） -->
        <view class="detail-meta">
          <view class="category-tag">{{news.categoryName}}</view>
          <text>{{news.source}}</text>
          <text wx:if="{{news.source && news.time}}">·</text>
          <text>{{news.time}}</text>
          <text wx:if="{{news.sourceUrl && news.time}}">·</text>
          <text class="meta-source-link" wx:if="{{news.sourceUrl}}" bindtap="openSourceUrl">📎 原文</text>
        </view>

        <!-- 分隔线 -->
        <view class="detail-divider"></view>

        <!-- 正文 -->
        <view class="detail-text">
          <block wx:for="{{paragraphs}}" wx:key="*this">
            <view class="text-p">{{item}}</view>
          </block>
        </view>

        <!-- 底部返回 -->
        <view class="back-bottom" bindtap="goBack">← 返回</view>
      </view>
    </view>
  </scroll-view>

  <!-- 边界提示 Chip -->
  <view class="boundary-chip {{boundaryVisible ? 'show' : ''}}" wx:if="{{boundaryText}}">
    <text wx:if="{{boundaryAction === 'back'}}" bindtap="goBack" class="chip-action">{{boundaryText}}</text>
    <text wx:else>{{boundaryText}}</text>
  </view>

  <!-- 网络兜底 Toast -->
  <view class="network-toast {{networkToastVisible ? 'show' : ''}}" wx:if="{{networkToastVisible}}">
    <text>🟡 网络开小差，下拉重试</text>
  </view>

  <!-- 底部操作栏（收藏左 + 分享右） -->
  <view class="detail-bottom-bar">
    <view class="bottom-bar-btn {{isFavorited ? 'is-favorited' : ''}} {{heartAnim ? 'heart-anim' : ''}}" bindtap="onToggleFavorite">
      <text class="bottom-bar-icon">{{isFavorited ? '♥' : '♡'}}</text>
      <text class="bottom-bar-label">收藏</text>
    </view>
    <button class="bottom-bar-btn share-btn-reset" open-type="share">
      <text class="bottom-bar-icon">↗</text>
      <text class="bottom-bar-label">分享</text>
    </button>
  </view>

  <!-- 隐藏 Canvas（分享占位图预生成） -->
  <share-card id="share-card" canvasWidth="{{400}}" canvasHeight="{{300}}"></share-card>
</view>
