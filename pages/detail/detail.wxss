/* 详情页样式 */

.page {
  height: 100vh;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 48rpx;
  flex-shrink: 0;
}

.nav-back {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}

.nav-position {
  font-size: 26rpx;
  color: var(--text-secondary);
  background-color: var(--tag-bg, rgba(0,0,0,0.04));
  padding: 4rpx 18rpx;
  border-radius: 18rpx;
  letter-spacing: 1rpx;
}

.content {
  flex: 1;
  overflow-y: auto;
}

/* 翻页动画容器 */
.article {
  transition: transform 0.26s ease, opacity 0.26s ease;
  will-change: transform, opacity;
}
.article.out-up   { transform: translateY(-100%); opacity: 0; }
.article.out-down { transform: translateY(100%);  opacity: 0; }
.article.in-up    { transform: translateY(100%);  opacity: 0; }
.article.in-down  { transform: translateY(-100%); opacity: 0; }

/* 上下翻页按钮 */
.pager-hint {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 40rpx;
  display: flex;
  justify-content: space-between;
  padding: 0 48rpx;
  pointer-events: none;
  z-index: 20;
}
.pager-btn {
  pointer-events: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 40rpx;
  line-height: 1.1;
  color: var(--text-secondary);
  background-color: var(--tag-bg, rgba(0,0,0,0.04));
  padding: 14rpx 22rpx;
  border-radius: 20rpx;
}
.pager-btn text {
  font-size: 22rpx;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

/* 首/尾边界提示 */
.edge-tip {
  position: fixed;
  left: 0;
  right: 0;
  top: 120rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  opacity: 0.7;
  z-index: 15;
  pointer-events: none;
}

.detail-body {
  padding: 16rpx 64rpx 80rpx;
}

.detail-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.45;
  margin-bottom: 28rpx;
  letter-spacing: -0.5rpx;
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
  letter-spacing: 0.5rpx;
}

.detail-source-link {
  margin-bottom: 36rpx;
}

.detail-source-link text {
  display: inline-flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-link, #576b95);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background-color: var(--bg-subtle, rgba(87, 107, 149, 0.06));
}

.detail-divider {
  height: 1rpx;
  background-color: var(--divider);
  margin-bottom: 48rpx;
}

.detail-text {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
}

.text-p {
  font-size: 34rpx;
  color: var(--text-body);
  line-height: 2.2;
  margin-bottom: 40rpx;
  letter-spacing: 1rpx;
}

.back-bottom {
  text-align: center;
  padding: 80rpx 0 60rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}
