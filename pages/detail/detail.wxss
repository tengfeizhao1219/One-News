/* 详情页样式 — 跨分类阅读模式 + 底部操作栏 */

.page {
  height: 100vh;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ============ 顶部导航栏 ============ */

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 48rpx;
  flex-shrink: 0;
}

.nav-back {
  font-size: calc(28rpx * var(--font-scale));  /* D-05#2: 参与字号缩放 */
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}

.nav-position {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: calc(20rpx * var(--font-scale));  /* D-05#3: 参与字号缩放 */
  color: var(--text-secondary);
  background-color: var(--tag-bg, rgba(0,0,0,0.04));
  padding: 4rpx 18rpx;
  border-radius: 16rpx;
  letter-spacing: 1rpx;
}

/* 跨分类进度中的分类名（fadeIn 200ms） */
.position-category {
  font-weight: 600;
  animation: fadeInCat 0.2s ease;
}

@keyframes fadeInCat {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ============ 正文区域 ============ */

.content {
  flex: 1;
  overflow-y: auto;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom) + 48rpx);
}

/* 翻页动画容器 — 对标首页卡片逻辑 */
.article {
  transition: transform 0.35s ease, opacity 0.35s ease;
  will-change: transform, opacity;
}
/* 上滑翻下一条：旧内容向上移出 */
.article.out-up   { transform: translateY(-100%); opacity: 0; }
/* 下滑翻上一条：旧内容向下移出 */
.article.out-down { transform: translateY(100%);  opacity: 0; }
/* 上滑翻下一条：新内容从下方滑入（+100%→0，由移除 class 触发 transition） */
.article.in-up    { transform: translateY(100%);  opacity: 0; }
/* 下滑翻上一条：新内容从上方滑入（-100%→0） */
.article.in-down  { transform: translateY(-100%); opacity: 0; }

/* 上下翻页按钮 */
.pager-hint {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 220rpx;
  display: flex;
  justify-content: space-between;
  padding: 0 48rpx;
  pointer-events: none;
  z-index: 18;
}
.pager-btn {
  pointer-events: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 40rpx;
  line-height: 1.1;
  color: var(--text-secondary);
  background-color: var(--tag-bg, rgba(0,0,0,0.04));
  padding: 14rpx 22rpx;
  border-radius: 20rpx;
}
.pager-btn text {
  font-size: calc(22rpx * var(--font-scale));
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

/* ============ 边界提示 Chip ============ */

.boundary-chip {
  position: fixed;
  bottom: 180rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 25;
  background: var(--chip-bg);
  color: var(--chip-text);
  font-size: calc(24rpx * var(--font-scale));
  padding: 20rpx 36rpx;
  border-radius: 24rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.boundary-chip.show {
  opacity: 1;
}

.chip-action {
  text-decoration: underline;
  pointer-events: auto;
}

/* ============ 网络兜底 Toast ============ */

.network-toast {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 25;
  background: rgba(245, 158, 11, 0.15);
  color: var(--color-warning);
  font-size: calc(24rpx * var(--font-scale));
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.network-toast.show {
  opacity: 1;
}

/* ============ 正文排版 ============ */

.detail-body {
  padding: 32rpx 64rpx 80rpx;  /* UX-IMPROVE05: 16→32 标题与状态栏间增加呼吸感 */
}

.detail-title {
  font-size: calc(52rpx * var(--font-scale));
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.45;
  margin-bottom: 28rpx;
  letter-spacing: -0.5rpx;
}

/* BUG-STD-002: 标题缺失时灰色兜底文案 */
.detail-title--empty {
  color: var(--text-secondary);
  font-weight: 400;
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  /* UX-FIX-F12（owner 2026-08-02 批准折中）：元信息由锁死 22rpx 改为跟涨但封顶 1.15 */
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-secondary);
  margin-bottom: 20rpx;
  letter-spacing: 0.5rpx;
  flex-wrap: wrap;
}

/* FE-B3 / UX-SIMPLIFY07: 原文链接低噪点入口 */
.source-link {
  color: var(--color-link, var(--primary));
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  padding: 2rpx 12rpx;
  border: 1rpx solid var(--divider);
  border-radius: 20rpx;
  margin-left: 4rpx;
}

.source-link:active {
  opacity: 0.6;
}

.detail-source-link text {
  display: inline-flex;
  align-items: center;
  font-size: calc(20rpx * var(--font-scale));
  color: var(--text-link);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background-color: var(--bg-subtle);
}

.detail-divider {
  height: 1rpx;
  background-color: var(--divider);
  margin-bottom: 48rpx;
}

.detail-text {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
}

.text-p {
  font-size: calc(32rpx * var(--font-scale));
  color: var(--text-body);
  line-height: calc(2.15 * var(--font-scale));
  margin-bottom: 40rpx;
  letter-spacing: 1rpx;
  text-indent: 2em;
}

/*  back-bottom 已移除 */

/* ============ 底部操作栏（收藏 + 分享） ============ */

.detail-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background-color: var(--bottom-bar-bg);
  backdrop-filter: var(--setting-panel-blur);
  -webkit-backdrop-filter: var(--setting-panel-blur);
  border-top: 1rpx solid var(--divider);
}

.bottom-bar-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 22rpx 0;  /* D-05#4: 热区 44+22+22=88rpx ≥ 微信无障碍建议 */
  /* UX-FIX-F12（owner 2026-08-02 批准折中）：操作栏文字由锁死 22rpx 改为跟涨但封顶 1.15 */
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-secondary);
  transition: transform 0.15s ease;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: 1;
}

.bottom-bar-btn::after {
  border: none;
}

.bottom-bar-btn:active {
  transform: scale(0.9);
}

.share-btn-reset {
  margin: 0;
  padding: 22rpx 0;  /* D-05#4: 热区 44+22+22=88rpx ≥ 微信无障碍建议 */
  /* UX-FIX-F12（owner 2026-08-02 批准折中） */
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-secondary);
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: 1;
}

.share-btn-reset::after {
  border: none;
}

.bottom-bar-icon {
  font-size: 44rpx;
  line-height: 1;
}

.bottom-bar-label {
  /* UX-FIX-F12（owner 2026-08-02 批准折中） */
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-secondary);
}

.bottom-bar-btn.is-favorited .bottom-bar-icon {
  color: var(--color-favorite);
}

@keyframes heartBeat {
  0%   { transform: scale(1); }
  30%  { transform: scale(1.25); }
  60%  { transform: scale(0.95); }
  100% { transform: scale(1); }
}

.bottom-bar-btn.heart-anim .bottom-bar-icon {
  animation: heartBeat 0.3s ease-out;
}

/* UX-FIX04: 超大字号（tier 3）截断保护 */
[data-font-scale="3"] .detail-title {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

[data-font-scale="3"] .text-p {
  display: -webkit-box;
  -webkit-line-clamp: 6;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

[data-font-scale="3"] .detail-meta,
[data-font-scale="3"] .source-link {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ============ 骨架屏（与首页一致） ============ */
.detail-skeleton {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 160rpx 64rpx 80rpx;
  box-sizing: border-box;
  z-index: 5;
  display: flex;
  flex-direction: column;
}

.detail-skeleton .sk-block {
  background: linear-gradient(90deg, var(--divider) 0%, var(--tag-bg) 50%, var(--divider) 100%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  margin-bottom: 28rpx;
  animation: skGradient 1.6s ease-in-out infinite;
}

.detail-skeleton .sk-title {
  width: 85%;
  height: 56rpx;
  margin-bottom: 48rpx;
}

.detail-skeleton .sk-line {
  height: 28rpx;
}

@keyframes skGradient {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ============ 状态页面（错误/空数据，与首页一致） ============ */
.state-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

.state-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.state-message {
  font-size: calc(28rpx * var(--font-scale));
  color: var(--text-secondary);
  margin-bottom: 40rpx;
  text-align: center;
  line-height: 1.6;
}

.state-retry {
  padding: 16rpx 48rpx;
  border-radius: 24rpx;
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 600;
  color: var(--bg-card);
  background-color: var(--text-primary);
  letter-spacing: 1rpx;
}

.state-retry:active {
  opacity: 0.7;
}
