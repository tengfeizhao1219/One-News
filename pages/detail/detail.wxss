/* 详情页 —— 阅读模式样式 */

.page {
  height: 100vh;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx;
  flex-shrink: 0;
}

.nav-back {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
  padding: 8rpx 0;
}

.nav-progress {
  font-size: 24rpx;
  color: var(--text-secondary);
  opacity: 0.7;
}

.nav-spacer {
  width: 80rpx;
}

/* 状态页 */
.state-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.state-loading {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.state-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: var(--divider);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.state-message {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.state-retry {
  font-size: 28rpx;
  color: var(--text-link);
  padding: 12rpx 32rpx;
  border: 1rpx solid var(--divider);
  border-radius: 8rpx;
}

/* 阅读容器 —— 翻页动画载体 */
.reading-container {
  flex: 1;
  min-height: 0;          /* 防止 flex 内容撑破父容器 */
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.reading-container.with-transition {
  transition: transform 0.3s cubic-bezier(0.25, 0.1, 0.25, 1.0);
}

/* 内容滚动区 */
.content-scroll {
  flex: 1;
  min-height: 0;
}

.detail-body {
  padding: 16rpx 64rpx 120rpx;
}

.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.45;
  margin-bottom: 28rpx;
  letter-spacing: -0.5rpx;
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 44rpx;
  letter-spacing: 0.5rpx;
}

.category-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  background-color: var(--divider);
  color: var(--text-secondary);
}

.detail-divider {
  height: 1rpx;
  background-color: var(--divider);
  margin-bottom: 48rpx;
}

.detail-text {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
}

.text-p {
  font-size: 34rpx;
  color: var(--text-body);
  line-height: 2.2;
  margin-bottom: 40rpx;
  letter-spacing: 1rpx;
  text-indent: 2em;
}

/* 底部切换引导 */
.swipe-footer {
  text-align: center;
  padding: 60rpx 0 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.swipe-hint-prev,
.swipe-hint-next {
  font-size: 24rpx;
  color: var(--text-secondary);
  opacity: 0.3;
  transition: opacity 0.3s;
}

.swipe-hint-prev.active,
.swipe-hint-next.active {
  opacity: 0.8;
}
