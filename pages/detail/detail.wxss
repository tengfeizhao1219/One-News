/* 详情页样式 — 跨分类阅读模式 + 底部操作栏 */

.page {
  height: 100vh;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ============ 顶部导航栏（D-09 v1.2 · BUG-20260806-007） ============ */

/* BUG-20260806-011 (FE): 详情页状态栏填充层用 position:fixed 真正贴顶。
   之前 inline 只有 background-color + height，没有 position 声明，
   → 被 .page (display:flex/column) 当成 flex item 推下来，导致
   顶部 0~statusBarHeight 区域出现"空隙"（绿色标记区域显示下层内容）。
   z-index:21 在 .nav-bar(22) 之下无关紧要，但本层只覆盖状态栏，draw order 正确即可 */
.status-bar-fill {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  z-index: 21;
}

.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;  /* BUG-20260806-011 v2: 显式 top:0 由 wxml inline 覆盖为 menuTop，补齐完整定位 */
  z-index: 22;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}

/* BUG-20260806-003: 第 3 层（detail）使用返回按钮（navigateBack），非主页按钮
   D-09 v1.2: explicit 锚定胶囊中心 — top 由 wxml inline 注入
   （calc(menuTop + menuHeight/2 - 32rpx/2)），不依赖条带内 top:50% */
.nav-back {
  position: absolute;
  left: 12rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.nav-back--hover {
  background-color: var(--bg-subtle);
}
.nav-back-icon {
  font-size: 40rpx;
  color: var(--text-primary);
  line-height: 1;
}

/* 进度指示（右侧） */
.nav-position {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  color: var(--text-secondary);
  background-color: var(--tag-bg, rgba(0,0,0,0.04));
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  letter-spacing: 1rpx;
}
.nav-position .position-category {
  color: var(--primary);
  font-size: 20rpx;
}

/* 进度条（nav 底部 · D-09 v1.2: 无底槽，与页面同色，仅保留 3rpx 浅蓝进度线） */
.nav-progress {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 3rpx;
  background: transparent;  /* D-09 v1.2: 去底槽（原 var(--divider)） */
}
.nav-progress-bar {
  height: 100%;
  width: 0%;
  background: var(--progress, rgba(0, 122, 255, 0.55));
  transition: width 0.08s linear;
}

/* 跨分类进度中的分类名（fadeIn 200ms） */
.position-category {
  font-weight: 600;
  animation: fadeInCat 0.2s ease;
}

@keyframes fadeInCat {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ============ 正文区域 ============ */

/* BUG-20260806-012 (FE) 根因：
   详情页真正根因不是状态栏背景，而是 .content (scroll-view) 的起始位置。
   .page 是 display:flex/column 容器，.status-bar-fill 和 .nav-bar 都用 position:fixed
   脱离了文档流（不占空间），导致 .content 用 flex:1 占据从 top:0 开始的全部高度；
   而 scroll-view 内部没有 padding-top，所以正文从屏幕顶端 0px 开始渲染，
   与 status-bar-fill 和 nav-bar 视觉重叠——这就是用户看到的"状态栏区域显示正文内容"。

   修复方案选择 absolute 定位（不用 padding-top）：
   - padding-top 方案：scroll-view 滚到最顶时内容上沿停在 nav-offset 处，
     但 scroll-view 容器仍然从屏幕 0px 开始，**幕布感仍有"错位"**，且不同平台
     enhanced 模式对 padding 行为不一致。
   - absolute 定位方案：scroll-view 容器本身就在 nav-bar 下方，**任何滚动
     状态都不会与 nav-bar 视觉重叠**，最稳。 */
.content {
  /* BUG-20260806-012: 绝对定位占据 nav-bar 下方全部区域 */
  position: absolute;
  left: 0;
  right: 0;
  top: var(--nav-offset, 88px);
  bottom: 0;
  /* BUG-FE-20260805-002 全局排查：统一滚动容器规范（min-height:0），防止 flex
     子项被内容撑开导致滚动失效（当前 enhanced 模式正常，防御性对齐） */
  min-height: 0;
  overflow-y: auto;
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom) + 48rpx);
  box-sizing: border-box;
}

/* 翻页动画容器 — 对标首页卡片逻辑 */
.article {
  transition: transform 0.35s ease, opacity 0.35s ease;
  will-change: transform, opacity;
}
/* 单元素复用模型修复：out 阶段结束后元素停在 -100vh/+100vh，
   切换 in 阶段时需先「无过渡」瞬间吸附到 in-up/in-down 起点，
   再移除 class 触发 transition 滑入中心；否则 transition 会从 out 终点一路穿越全屏，
   导致新内容从【反方向】滑入（与预期相反）。 */
.article.no-transition {
  transition: none;
}
/* 上滑翻下一条：旧内容向上移出（一屏高度，使用 JS 计算的 --page-h 像素值，避免 100vh 在 transform 内不可靠）
   注意：pre-v5.9 卡片页曾用 PAGE_HEIGHT(px) 偏移，方向正确；v5.9 切换到 100vh 后出现方向随机/反向问题。 */
.article.out-up   { transform: translateY(calc(-1 * var(--page-h, 100vh))); opacity: 0; }
/* 下滑翻上一条：旧内容向下移出（一屏高度） */
.article.out-down { transform: translateY(var(--page-h, 100vh));         opacity: 0; }
/* 上滑翻下一条：新内容从下方滑入（+page-h→0，由移除 class 触发 transition） */
.article.in-up    { transform: translateY(var(--page-h, 100vh));         opacity: 0; }
/* 下滑翻上一条：新内容从上方滑入（-page-h→0，整屏滑入，与翻下一页对称） */
.article.in-down  { transform: translateY(calc(-1 * var(--page-h, 100vh))); opacity: 0; }
/* 备用：淡入效果（当前未使用，保留供后续切换） */
.article.fade-in  { opacity: 0; }

/* ============ 网络兜底 Toast ============ */

.network-toast {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 25;
  background: var(--color-warning-subtle);
  color: var(--color-warning);
  font-size: calc(24rpx * var(--font-scale));
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.network-toast.show {
  opacity: 1;
}

/* ============ 正文排版 ============ */

.detail-body {
  /* BUG-20260806-018 (FE) 根因: nav-offset 被双重计入导致标题上方空白过大。
     .content 在 BUG-20260806-012 已用 position:absolute; top:var(--nav-offset)
     把整个 scroll-view 容器推到 nav-bar 下方。如果 .detail-body 内部再
     padding-top: var(--nav-offset + 12rpx)，两次叠加 ≈ 100px 空白。
     现在 padding-top 改为 12rpx（仅保留 12rpx 视觉呼吸），由外层 .content
     的 absolute 定位统一负责 nav-bar 空间。 */
  padding: 12rpx 64rpx 80rpx;
}

.detail-title {
  /* BUG-20260806-004: 标题使用相对尺寸 44rpx（不再跟随字体缩放） */
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.45;
  margin-bottom: 28rpx;
  letter-spacing: -0.5rpx;
}

/* BUG-STD-002: 标题缺失时灰色兜底文案 */
.detail-title--empty {
  color: var(--text-secondary);
  font-weight: 400;
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  /* BUG-20260806-004: 元信息使用相对尺寸 24rpx */
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
  letter-spacing: 0.5rpx;
  flex-wrap: wrap;
}

/* S7: owner 2026-08-02 决策，原文链接入口已删除；以下样式保留历史记录 */
/* .source-link { ... } */

.detail-source-link text {
  display: inline-flex;
  align-items: center;
  font-size: calc(20rpx * var(--font-scale));
  color: var(--text-link);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background-color: var(--bg-subtle);
}

/* BUG-20260806-004: 正文区不做分割线，标题与正文直接衔接 */
.detail-text {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
}

.text-p {
  font-size: calc(32rpx * var(--font-scale));
  color: var(--text-body);
  /* UI-B11: 正文行高 2.0、段间距 36rpx，与 demo 一致 */
  line-height: calc(2.0 * var(--font-scale));
  margin-bottom: 36rpx;
  letter-spacing: 1rpx;
  text-indent: 2em;
}

/*  back-bottom 已移除 */

/* ============ 底部操作栏（收藏 + 分享） ============ */

.detail-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  height: calc(128rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background-color: var(--bottom-bar-bg);
  backdrop-filter: var(--setting-panel-blur);
  -webkit-backdrop-filter: var(--setting-panel-blur);
  /* BUG-20260806-004: 底部分割线收窄为 0.5rpx */
  border-top: 0.5rpx solid var(--divider);
}

/* UI-B7 §3.5: 详情页底部固定滑动提示条（位于操作栏上方，不响应点击） */
.fixed-swipe-hint {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 0;
  pointer-events: none;
  z-index: 19;
  opacity: 1;
  transition: opacity 0.5s ease;
}

.fixed-swipe-hint.hide {
  opacity: 0;
}

.fixed-swipe-hint-icon-img {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.55;
}

.fixed-swipe-hint-text {
  /* UI-B11: 滑动提示字号/字间距/透明度与 demo 对齐 */
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 6rpx;
  font-weight: 300;
  opacity: 0.55;
}

.bottom-bar-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 22rpx 0;  /* D-05#4: 热区 44+22+22=88rpx ≥ 微信无障碍建议 */
  /* UX-FIX-F12（owner 2026-08-02 批准折中）：操作栏文字由锁死 22rpx 改为跟涨但封顶 1.15 */
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-secondary);
  transition: transform 0.15s ease;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: 1;
}

.bottom-bar-btn::after {
  border: none;
}

.bottom-bar-btn:active {
  transform: scale(0.9);
}

.share-btn-reset {
  margin: 0;
  padding: 22rpx 0;  /* D-05#4: 热区 44+22+22=88rpx ≥ 微信无障碍建议 */
  /* UX-FIX-F12（owner 2026-08-02 批准折中） */
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-secondary);
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: 1;
}

.share-btn-reset::after {
  border: none;
}

.bottom-bar-icon {
  font-size: 44rpx;
  line-height: 1;
}

/* UI-B7 图标规范: 收藏图标用 image 直接渲染 SVG */
.bottom-bar-icon-img {
  width: 44rpx;
  height: 44rpx;
}
.bottom-bar-icon-faved {
  font-size: 44rpx;
  line-height: 1;
  color: var(--color-favorite);
}

.bottom-bar-label {
  /* UX-FIX-F12（owner 2026-08-02 批准折中） */
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-secondary);
}

.bottom-bar-btn.is-favorited .bottom-bar-icon-faved {
  /* 已收藏态颜色由 .bottom-bar-icon-faved 的 color 属性控制 */
}

/* UI-B11 §2.3 收藏态微高亮：已收藏时 label 同步主题红，与图标呼应
   BUG-20260805-004（owner 反馈）：按钮区域不需要展示为红色，仅 icon 变红即可。
   文字颜色恢复为默认，仅保留 icon 红色（由 favorite-fill.svg 固定提供）。 */

/* UI-B11: 已收藏态按钮背景微高亮 → 已移除（owner 反馈：按钮区域不需红色背景） */

@keyframes heartBeat {
  0%   { transform: scale(1); }
  30%  { transform: scale(1.25); }
  60%  { transform: scale(0.95); }
  100% { transform: scale(1); }
}

.bottom-bar-btn.heart-anim .bottom-bar-icon-img {
  animation: heartBeat 0.3s ease-out;
}

/* UX-FIX04: 超大字号（tier 3）截断保护 */
[data-font-scale="3"] .detail-title {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

[data-font-scale="3"] .text-p {
  display: -webkit-box;
  -webkit-line-clamp: 6;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

[data-font-scale="3"] .detail-meta {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ============ 骨架屏（与首页一致） ============ */
.detail-skeleton {
  /* BUG-20260806-018 (FE): 去掉冗余 nav-offset（外层 .content 已 absolute 定位给空间） */
  padding: 12rpx 64rpx 80rpx;
  flex: 1;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.detail-skeleton .sk-block {
  background: linear-gradient(90deg, var(--divider) 0%, var(--tag-bg) 50%, var(--divider) 100%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  margin-bottom: 28rpx;
  animation: skGradient 1.6s ease-in-out infinite;
}

.detail-skeleton .sk-title {
  width: 85%;
  height: 56rpx;
  margin-bottom: 48rpx;
}

.detail-skeleton .sk-line {
  height: 28rpx;
}

@keyframes skGradient {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ============ 状态页面（错误/空数据，与首页一致） ============ */
.state-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

.state-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.state-message {
  font-size: calc(28rpx * var(--font-scale));
  color: var(--text-secondary);
  margin-bottom: 40rpx;
  text-align: center;
  line-height: 1.6;
}

.state-retry {
  padding: 16rpx 48rpx;
  border-radius: 24rpx;
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 600;
  color: var(--bg-card);
  background-color: var(--text-primary);
  letter-spacing: 1rpx;
}

.state-retry:active {
  opacity: 0.7;
}

/* ============ 暗色模式（D-08 方案 A：删除 BUG-20260805-002 硬编码兜底块）============
   D-07 S1-S4 后变量注入已改为 app.wxss 显式变量块（class 注入），变量失效问题已解决；
   正常路径各选择器均已 var() 引用 → 兜底硬编码为纯冗余（双轨漂移风险源），整块删除。 */
