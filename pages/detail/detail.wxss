/* 详情页样式 — 跨分类阅读模式 + 底部操作栏 */

.page {
  height: 100vh;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ============ 顶部导航栏（D-09 v1.2 · BUG-20260806-007） ============ */

/* BUG-20260806-011 (FE): 详情页状态栏填充层用 position:fixed 真正贴顶。
   之前 inline 只有 background-color + height，没有 position 声明，
   → 被 .page (display:flex/column) 当成 flex item 推下来，导致
   顶部 0~statusBarHeight 区域出现"空隙"（绿色标记区域显示下层内容）。
   z-index:21 在 .nav-bar(22) 之下无关紧要，但本层只覆盖状态栏，draw order 正确即可 */
.status-bar-fill {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  z-index: 21;
}

.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;  /* BUG-20260806-011 v2: 显式 top:0 由 wxml inline 覆盖为 menuTop，补齐完整定位 */
  z-index: 22;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}

/* BUG-20260806-027: 第 3 层（detail）顶部按钮改为首页按钮（goHome/reLaunch），
   非返回按钮。样式与首页 nav-home 一致：image 渲染 home.svg 主题色，深色用白色版。
   D-09 v1.2: explicit 锚定胶囊中心 — top 由 wxml inline 注入
   （calc(menuHeight/2 - 32rpx)），不依赖条带内 top:50% */
.nav-home {
  position: absolute;
  left: 12rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.nav-home--hover {
  background-color: var(--bg-subtle);
}
.nav-home-icon-img {
  width: 44rpx;
  height: 44rpx;
}

/* 进度指示（右侧） */
.nav-position {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  color: var(--text-secondary);
  background-color: var(--tag-bg);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  letter-spacing: 1rpx;
}
.nav-position .position-category {
  color: var(--primary);
  font-size: 20rpx;
}

/* 进度条（nav 底部 · D-09 v1.2: 无底槽，与页面同色，仅保留 3rpx 浅蓝进度线） */
.nav-progress {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 3rpx;
  background: transparent;  /* D-09 v1.2: 去底槽（原 var(--divider)） */
}
.nav-progress-bar {
  height: 100%;
  width: 0%;
  background: var(--progress);
  transition: width 0.08s linear;
}

/* 跨分类进度中的分类名（fadeIn 200ms） */
.position-category {
  font-weight: 600;
  animation: fadeInCat 0.2s ease;
}

@keyframes fadeInCat {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ============ 正文区域 ============ */

/* BUG-20260806-012 (FE) 根因：
   详情页真正根因不是状态栏背景，而是 .content (scroll-view) 的起始位置。
   .page 是 display:flex/column 容器，.status-bar-fill 和 .nav-bar 都用 position:fixed
   脱离了文档流（不占空间），导致 .content 用 flex:1 占据从 top:0 开始的全部高度；
   而 scroll-view 内部没有 padding-top，所以正文从屏幕顶端 0px 开始渲染，
   与 status-bar-fill 和 nav-bar 视觉重叠——这就是用户看到的"状态栏区域显示正文内容"。

   修复方案选择 absolute 定位（不用 padding-top）：
   - padding-top 方案：scroll-view 滚到最顶时内容上沿停在 nav-offset 处，
     但 scroll-view 容器仍然从屏幕 0px 开始，**幕布感仍有"错位"**，且不同平台
     enhanced 模式对 padding 行为不一致。
   - absolute 定位方案：scroll-view 容器本身就在 nav-bar 下方，**任何滚动
     状态都不会与 nav-bar 视觉重叠**，最稳。 */
.content {
  /* BUG-20260806-012: 绝对定位占据 nav-bar 下方全部区域 */
  position: absolute;
  left: 0;
  right: 0;
  top: var(--nav-offset, 88px);
  bottom: 0;
  /* BUG-FE-20260805-002 全局排查：统一滚动容器规范（min-height:0），防止 flex
     子项被内容撑开导致滚动失效（当前 enhanced 模式正常，防御性对齐） */
  min-height: 0;
  overflow-y: auto;
  /* BUG-20260806-021: 底部留白同步 128rpx → 80rpx（bar 高度同步） */
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom) + 48rpx);
  box-sizing: border-box;
}

/* 翻页动画容器 — 对标首页卡片逻辑
   BUG-20260806-026 (FE): 去掉 out/in 阶段的 opacity:0 —— 原实现滑出/滑入时同时透明化，
   视觉上呈「淡出+淡入」。改为纯 transform 位移的整页滑动，动画更连续自然。 */
.content {
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: transform;
}
/* 单元素复用模型修复：out 阶段结束后元素停在 -100vh/+100vh，
   切换 in 阶段时需先「无过渡」瞬间吸附到 in-up/in-down 起点，
   再移除 class 触发 transition 滑入中心；否则 transition 会从 out 终点一路穿越全屏，
   导致新内容从【反方向】滑入（与预期相反）。 */
.content.no-transition {
  transition: none;
}
/* 上滑翻下一条：旧内容向上移出（一屏高度，使用 JS 计算的 --page-h 像素值，避免 100vh 在 transform 内不可靠）
   注意：pre-v5.9 卡片页曾用 PAGE_HEIGHT(px) 偏移，方向正确；v5.9 切换到 100vh 后出现方向随机/反向问题。 */
.content.out-up   { transform: translateY(calc(-1 * var(--page-h, 100vh))); }
/* 下滑翻上一条：旧内容向下移出（一屏高度） */
.content.out-down { transform: translateY(var(--page-h, 100vh)); }
/* 上滑翻下一条：新内容从下方滑入（+page-h→0，由移除 class 触发 transition） */
.content.in-up    { transform: translateY(var(--page-h, 100vh)); }
/* 下滑翻上一条：新内容从上方滑入（-page-h→0，整屏滑入，与翻下一页对称） */
.content.in-down  { transform: translateY(calc(-1 * var(--page-h, 100vh))); }
/* 备用：淡入效果（当前未使用，保留供后续切换） */
.article.fade-in  { opacity: 0; }

/* ============ 网络兜底 Toast ============ */

.network-toast {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 25;
  background: var(--color-warning-subtle);
  color: var(--color-warning);
  font-size: calc(24rpx * var(--font-scale));
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.network-toast.show {
  opacity: 1;
}

/* ============ 浏览完毕居中 Toast（BUG-20260806-025） ============
   微信原生 wx.showToast 默认顶部显示且不可自定义位置，
   此处改为自定义居中 toast：垂直水平居中、半透明黑底白字、胶囊圆角。 */
.finish-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  /* 同时平移 X/Y 实现完美居中 */
  transform: translate(-50%, -50%) scale(0.92);
  z-index: 26;
  max-width: 560rpx;
  background: rgba(0, 0, 0, 0.78);
  color: var(--chip-text);
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1.5;
  padding: 28rpx 40rpx;
  border-radius: 24rpx;
  text-align: center;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.24);
  opacity: 0;
  transition: opacity 0.25s ease, transform 0.25s ease;
  pointer-events: none;
}

.finish-toast.show {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

/* ============ 正文排版 ============ */

.detail-body {
  /* BUG-20260806-018 (FE) 根因: nav-offset 被双重计入导致标题上方空白过大。
     .content 在 BUG-20260806-012 已用 position:absolute; top:var(--nav-offset)
     把整个 scroll-view 容器推到 nav-bar 下方。如果 .detail-body 内部再
     padding-top: var(--nav-offset + 12rpx)，两次叠加 ≈ 100px 空白。
     现在 padding-top 改为 12rpx（仅保留 12rpx 视觉呼吸），由外层 .content
     的 absolute 定位统一负责 nav-bar 空间。 */
  padding: 12rpx 64rpx 80rpx;
}

.detail-title {
  /* BUG-20260806-004: 标题使用相对尺寸 44rpx（不再跟随字体缩放） */
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.45;
  margin-bottom: 28rpx;
  letter-spacing: -0.5rpx;
}

/* BUG-STD-002: 标题缺失时灰色兜底文案 */
.detail-title--empty {
  color: var(--text-secondary);
  font-weight: 400;
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  /* BUG-20260806-004: 元信息使用相对尺寸 24rpx */
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
  letter-spacing: 0.5rpx;
  flex-wrap: wrap;
}

/* category-tag: 元信息中的分类小标签（D-07 S3: tag-bg + tag-text + 圆角胶囊） */
.category-tag {
  color: var(--tag-text);
  background-color: var(--tag-bg);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 1;
}

/* S7: owner 2026-08-02 决策，原文链接入口已删除；以下样式保留历史记录 */
/* .source-link { ... } */

.detail-source-link text {
  display: inline-flex;
  align-items: center;
  font-size: calc(20rpx * var(--font-scale));
  color: var(--text-link);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background-color: var(--bg-subtle);
}

/* BUG-20260806-004: 正文区不做分割线，标题与正文直接衔接 */
.detail-text {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
}

.text-p {
  font-size: calc(32rpx * var(--font-scale));
  color: var(--text-body);
  /* UI-B11: 正文行高 1.9、段间距 36rpx、两端对齐，长解读更透气易读 */
  line-height: calc(1.9 * var(--font-scale));
  margin-bottom: 36rpx;
  letter-spacing: 1rpx;
  text-indent: 2em;
  text-align: justify;
  text-justify: inter-ideograph;
}

/* ============ AI 解读标识（详情页正文顶部） ============ */
/* 版权策略：AI 独立解读 ≠ 原文复述，需标识满足法规要求；
   原版（v1.0）蓝高饱和醒目徽标；owner 11:45 推翻 10:54 弱化，恢复醒目蓝 */
.ai-interpretation-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
  padding: 16rpx 24rpx;
  background-color: var(--primary-subtle);
  border-radius: 16rpx;
  border-left: 6rpx solid var(--primary);
}

/* R1 合规降级标识：与 AI 解读徽标形态一致，仅左边框用极淡琥珀区分 */
.ai-interpretation-badge.ai-badge--compliance {
  background-color: var(--color-warning-subtle);
  border-left-color: var(--color-warning);
}

.ai-interpretation-badge .ai-chip {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  color: var(--chip-text);
  background-color: var(--primary);
}

.ai-badge--compliance .ai-chip {
  background-color: var(--color-warning);
  color: var(--chip-text);
}

.ai-interpretation-badge .ai-badge-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* ============ 查看原文：AI 解读标识内的高亮内联入口（D-02 v0.2 §2.2） ============
   置于 AI 解读/AI 摘录提示语之后（非独立成行），用 --text-link 蓝链色相对高亮，
   与灰提示语形成对比但不过分抢眼；个人主体 web-view 不可用，交互走「复制链接+引导外部浏览器打开」 */

/* ============ 一页说：AI 独立观点（owner 2026-08-12 拍板方案 B 引用块） ============
   引用块形态：左边框(--primary) + 浅蓝底(--primary-subtle)，比方案 C 更克制；
   与顶部「AI 解读」醒目徽标区分角色：AI 解读=合规免责感，一页说=主蓝洞察感。
   点击「关于一页说」就地展开说明（中性灰底 --bg-subtle），不引新 hex */
.yiyieshuo-card {
  margin: 8rpx 0 4rpx;
  padding: 22rpx 26rpx;
  background-color: var(--primary-subtle);
  border-left: 6rpx solid var(--primary);
  border-radius: 12rpx;
}

.yiyieshuo-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.yiyieshuo-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.yiyieshuo-text {
  display: block;
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1.65;
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.yiyieshuo-info-entry {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.yiyieshuo-info-ic {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26rpx;
  height: 26rpx;
  border: 1rpx solid var(--text-tertiary);
  border-radius: 50%;
  font-size: 20rpx;
  font-style: italic;
  line-height: 1;
}

.yiyieshuo-chev {
  font-size: 20rpx;
}

.yiyieshuo-disclosure {
  margin-top: 14rpx;
}

.yiyieshuo-disclosure-box {
  padding: 20rpx 22rpx;
  background-color: var(--bg-subtle);
  border-radius: 18rpx;
}

.yiyieshuo-disclosure-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 10rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.yiyieshuo-disclosure-desc {
  display: block;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--text-secondary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.meta-source-link {
  color: var(--text-link);
  font-size: 22rpx;
  font-weight: 500;
  margin-left: 12rpx;
  align-self: center;
}

.meta-source-link:active {
  color: var(--primary);
}

/* ============ 官方源归因标识（contentSource==='official_rss'） ============
   与 AI 解读/AI 摘录徽标平行占位，但用中性灰调区分「官方源 ≠ AI 生成」；
   版权红线：只跳源站 H5（复制链接+引导外部浏览器），不显正文。
   来源名做中性 pill（--bg-card，非 AI 蓝），desc 灰文，出处 ↗ 复用 .meta-source-link 蓝链高亮 */
.source-attribution-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
  padding: 16rpx 24rpx;
  background-color: var(--bg-subtle);
  border-radius: 16rpx;
  border-left: 6rpx solid var(--divider);
}

.source-attribution-badge .source-chip {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  color: var(--text-primary);
  background-color: var(--bg-card);
}

.source-attribution-badge .source-badge-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* ============ 底部应用来源归属（11:45 新增；15:0x 改为 position:fixed 常驻视口底部）
   无论内容长短、是否滚动，始终贴在屏幕底部。移出 scroll-view 到 page 级，
   避开 .article 的 transform 导致 fixed 失效；背景 + 顶部分隔线避免正文透出。
   scroll-view 已留 128rpx+安全区 底部 padding，正文末段不会被遮挡。 */
.detail-app-source {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 18rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background-color: var(--bg-card);
  border-top: 1rpx solid var(--divider);
}
.app-source-line {
  width: 64rpx;
  height: 1rpx;
  background-color: var(--divider);
  margin-bottom: 20rpx;
}
.app-source-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* ============ app_intro 占位欢迎介绍：系统蓝 hero + 分段标题卡片 ============ */
.app-intro-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 32rpx;
  margin-bottom: 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--primary-subtle), rgba(255, 255, 255, 0) 72%);
  border: 1rpx solid var(--divider);
}
.app-intro-logo {
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-card);
  box-shadow: 0 6rpx 18rpx var(--primary-subtle);
  overflow: hidden;
}
.app-intro-hero-text {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.app-intro-title {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}
.app-intro-tagline {
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}
.app-intro-h {
  margin-top: 40rpx;
  margin-bottom: 14rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid var(--primary);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}
.app-intro-p {
  font-size: 28rpx;
  line-height: 1.78;
  letter-spacing: 0.4rpx;
  color: var(--text-body);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* ============ inline-empty：paragraphs 为空时兜底（PRD §2.5） ============ */
.inline-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 32rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  background-color: var(--bg-subtle);
}
.inline-empty-icon {
  font-size: 48rpx;
  color: var(--text-tertiary);
  line-height: 1;
  margin-bottom: 16rpx;
}
.inline-empty-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* ============ references 参考来源卡片（PRD §2.4 S1） ============ */
.references-card {
  margin-top: 32rpx;
  border-radius: 16rpx;
  background-color: var(--bg-subtle);
  overflow: hidden;
}

.references-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
}

.references-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.references-toggle {
  font-size: 22rpx;
  color: var(--text-link);
}

.references-list {
  padding: 0 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.reference-item {
  padding: 16rpx 20rpx;
  background-color: var(--bg-card);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.reference-item:active {
  opacity: 0.7;
}

.reference-title {
  font-size: 24rpx;
  color: var(--text-body);
  line-height: 1.4;
}

.reference-url {
  font-size: 20rpx;
  color: var(--text-secondary);
  word-break: break-all;
}

/*  back-bottom 已移除 */

/* ============ 底部操作栏（收藏 + 分享） ============ */

/* BUG-20260806-021 (FE): 底部栏高度 128rpx → 80rpx（-37.5%），
   占用空间过大。同步压缩 icon 44→40rpx、label 22→20rpx、padding 22→8rpx，
   保证内容(40+4+20+16=80rpx)恰好放满 bar 且不溢出。
   注意：b7de8be 会话曾基于旧代码把 bar 回退到 128rpx，本次为再次压缩。 */
.detail-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  height: calc(80rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background-color: var(--bottom-bar-bg);
  backdrop-filter: var(--setting-panel-blur);
  -webkit-backdrop-filter: var(--setting-panel-blur);
  /* BUG-20260806-004: 底部分割线收窄为 0.5rpx */
  border-top: 0.5rpx solid var(--divider);
}

/* UI-B7 §3.5: 详情页底部固定滑动提示条（位于操作栏上方，不响应点击）
   BUG-20260806-021: bottom 同步 128rpx → 80rpx */
.fixed-swipe-hint {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 0;
  pointer-events: none;
  z-index: 19;
  opacity: 1;
  transition: opacity 0.5s ease;
}

.fixed-swipe-hint.hide {
  opacity: 0;
}

.fixed-swipe-hint-icon-img {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.55;
}

.fixed-swipe-hint-text {
  /* UI-B11: 滑动提示字号/字间距/透明度与 demo 对齐 */
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 6rpx;
  font-weight: 300;
  opacity: 0.55;
}

.bottom-bar-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 0;  /* BUG-20260806-021: 原 22rpx → 8rpx，配合 bar 80rpx 内容(40+4+20+16=80rpx)恰好放满 */
  /* UX-FIX-F12（owner 2026-08-02 批准折中）：操作栏文字由锁死 22rpx 改为跟涨但封顶 1.15 */
  font-size: calc(20rpx * var(--font-scale-meta, 1));
  color: var(--text-secondary);
  transition: transform 0.15s ease;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: 1;
}

.bottom-bar-btn::after {
  border: none;
}

.bottom-bar-btn:active {
  transform: scale(0.9);
}

.share-btn-reset {
  margin: 0;
  padding: 8rpx 0;  /* BUG-20260806-021: 与 .bottom-bar-btn 同步 22rpx → 8rpx */
  /* UX-FIX-F12（owner 2026-08-02 批准折中） */
  font-size: calc(20rpx * var(--font-scale-meta, 1));
  color: var(--text-secondary);
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: 1;
}

.share-btn-reset::after {
  border: none;
}

/* UI-B7 图标规范: 收藏/分享图标均用 image 直接渲染 SVG（主题色跟随 currentColor）
   BUG-20260806-021: 44rpx → 40rpx
   BUG-20260806-027: 分享图标由文本 ↗ 改为 share.svg image，与收藏一致避免发灰 */
.bottom-bar-icon-img {
  width: 40rpx;
  height: 40rpx;
}
.bottom-bar-icon-faved {
  font-size: 40rpx;
  line-height: 1;
  color: var(--color-favorite);
}

.bottom-bar-label {
  /* UX-FIX-F12（owner 2026-08-02 批准折中） */
  font-size: calc(20rpx * var(--font-scale-meta, 1));
  color: var(--text-secondary);
}

.bottom-bar-btn.is-favorited .bottom-bar-icon-faved {
  /* 已收藏态颜色由 .bottom-bar-icon-faved 的 color 属性控制 */
}

/* UI-B11 §2.3 收藏态微高亮：已收藏时 label 同步主题红，与图标呼应
   BUG-20260805-004（owner 反馈）：按钮区域不需要展示为红色，仅 icon 变红即可。
   文字颜色恢复为默认，仅保留 icon 红色（由 favorite-fill.svg 固定提供）。 */

/* UI-B11: 已收藏态按钮背景微高亮 → 已移除（owner 反馈：按钮区域不需红色背景） */

@keyframes heartBeat {
  0%   { transform: scale(1); }
  30%  { transform: scale(1.25); }
  60%  { transform: scale(0.95); }
  100% { transform: scale(1); }
}

.bottom-bar-btn.heart-anim .bottom-bar-icon-img {
  animation: heartBeat 0.3s ease-out;
}

/* UX-FIX04: 超大字号（tier 3）截断保护 */
[data-font-scale="3"] .detail-title {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

[data-font-scale="3"] .text-p {
  display: -webkit-box;
  -webkit-line-clamp: 6;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

[data-font-scale="3"] .detail-meta {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ============ 骨架屏（与首页一致） ============ */
.detail-skeleton {
  /* BUG-20260806-018 (FE): 去掉冗余 nav-offset（外层 .content 已 absolute 定位给空间） */
  padding: 12rpx 64rpx 80rpx;
  flex: 1;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.detail-skeleton .sk-block {
  background: linear-gradient(90deg, var(--divider) 0%, var(--tag-bg) 50%, var(--divider) 100%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  margin-bottom: 28rpx;
  animation: skGradient 1.6s ease-in-out infinite;
}

/* D-04 v0.2 §4.1：标题区 2 行灰块 */
.detail-skeleton .sk-title {
  width: 85%;
  height: 56rpx;
  margin-bottom: 24rpx;
}
.detail-skeleton .sk-title--second {
  width: 60%;
  height: 44rpx;
  margin-bottom: 48rpx;
}

/* D-04 v0.2 §4.1：元信息行细灰条（代替 科技 | InfoQ · 时间） */
.detail-skeleton .sk-meta {
  width: 40%;
  height: 24rpx;
  margin-bottom: 56rpx;
}

/* D-04 v0.2 §4.1：首段前弱提示（不做满屏大字，不抢正文） */
.detail-skeleton .skeleton-ai-tip {
  font-size: calc(24rpx * var(--font-scale));
  color: var(--text-tertiary);
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.detail-skeleton .sk-line {
  height: 28rpx;
}

@keyframes skGradient {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ============ 状态页面（错误/空数据）· D-04 v0.2 §4.2 ============
   去按钮、温和文案、居中 logo-avatar-circle。整体只有 logo + 主文案 + 副文案 三元素。 */
.state-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

/* 居中品牌标：圆形头像标 avatar-circle，置于文案上方（约 128rpx，弱化色不抢文案） */
.state-avatar {
  margin-bottom: 40rpx;
  opacity: 0.9;
}

.state-title {
  font-size: calc(34rpx * var(--font-scale));
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.state-sub {
  font-size: calc(26rpx * var(--font-scale));
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
  padding: 0 48rpx;
}

/* ============ 暗色模式（D-08 方案 A：删除 BUG-20260805-002 硬编码兜底块）============
   D-07 S1-S4 后变量注入已改为 app.wxss 显式变量块（class 注入），变量失效问题已解决；
   正常路径各选择器均已 var() 引用 → 兜底硬编码为纯冗余（双轨漂移风险源），整块删除。 */

/* ===== 话题搜索深挖（2026-08-22 从 intel 详情页平移） ===== */
.search-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--bg-page);
  z-index: 210;
  visibility: hidden;
  opacity: 0;
  transition: top 0.65s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.5s, visibility 0s 0.65s;
}
.search-panel-inner {
  padding: 8rpx 32rpx calc(32rpx + var(--safe-bottom, 0px));
}
.search-panel.open {
  visibility: visible;
  opacity: 1;
  transition: top 0.65s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.5s;
}
.search-bar { padding: 16rpx 0 8rpx; }
.deep-quick {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: var(--primary-subtle, rgba(10, 124, 235, 0.08));
  margin-bottom: 16rpx;
}
.deep-quick--hover { opacity: 0.8; }
.quick-t {
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 600;
  color: var(--primary);
  line-height: 1.5;
}
.quick-s {
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
}
.search-box { display: flex; align-items: center; gap: 16rpx; }
.search-line-wrap { flex: 1; min-width: 0; }
.search-input {
  width: 100%;
  font-size: calc(30rpx * var(--font-scale));
  color: var(--text-primary);
  padding: 12rpx 0;
  box-sizing: border-box;
}
.search-input--done { color: var(--text-tertiary); }
.search-placeholder { color: var(--text-tertiary); }
.search-line {
  height: 2rpx;
  background: var(--divider);
  position: relative;
  overflow: hidden;
}
.search-line-progress {
  height: 100%;
  width: 0;
  background: var(--primary);
  transition: width 0.65s ease-out;
}
.search-line-progress.on { width: 100%; }
.search-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex-shrink: 0;
}
.search-btn--hover { background-color: var(--bg-subtle); }
.search-btn-icon { width: 44rpx; height: 44rpx; }
.search-btn.is-loading .search-btn-icon { opacity: 0.9; }
.search-status { padding: 12rpx 4rpx 0; }
.search-status-txt { font-size: calc(24rpx * var(--font-scale-meta, 1)); color: var(--primary); }
.search-hint {
  padding: 12rpx 4rpx 0;
  font-size: calc(24rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
  line-height: 1.6;
}
.dig-list { padding-top: 16rpx; }
.dig-group {
  border: 1rpx solid var(--divider);
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  background: var(--bg-card);
  overflow: hidden;
}
.dig-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
}
.dig-group-head--hover { background-color: var(--bg-subtle); }
.dig-group-info { flex: 1; min-width: 0; }
.dig-group-q {
  display: block;
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
}
.dig-group-meta {
  display: block;
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
  margin-top: 6rpx;
}
.dig-group-arrow { color: var(--text-tertiary); font-size: calc(28rpx * var(--font-scale)); }
.dig-group-body {
  padding: 0 24rpx 20rpx;
  border-top: 1rpx solid var(--divider);
}
.dig-entry { padding-top: 20rpx; }
.dig-entry-time {
  display: block;
  font-size: calc(20rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
}
.search-sec-head {
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 700;
  color: var(--text-primary);
  margin: 16rpx 0 8rpx;
  line-height: 1.5;
}
.search-sec-bullet {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  margin: 8rpx 0;
}
.search-sec-bdot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-top: 12rpx;
  flex-shrink: 0;
}
.search-sec-btext {
  font-size: calc(26rpx * var(--font-scale));
  color: var(--text-body, var(--text-primary));
  line-height: 1.7;
}
.search-sec-para {
  font-size: calc(26rpx * var(--font-scale));
  color: var(--text-body, var(--text-primary));
  line-height: 1.7;
  margin: 10rpx 0;
}
.dig-sources { margin-top: 12rpx; }
.dig-sources-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}
.dig-sources-head--hover { opacity: 0.7; }
.dig-sources-title {
  font-size: calc(24rpx * var(--font-scale-meta, 1));
  color: var(--text-secondary);
}
.dig-sources-arrow {
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
}
.dig-src {
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: var(--bg-subtle);
  margin-bottom: 8rpx;
}
.dig-src--hover { opacity: 0.8; }
.dig-src-title {
  display: block;
  font-size: calc(24rpx * var(--font-scale-meta, 1));
  color: var(--text-primary);
  line-height: 1.5;
}
.dig-src-url {
  display: block;
  font-size: calc(20rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
  margin-top: 4rpx;
  word-break: break-all;
}
.fab-search {
  position: fixed;
  right: 40rpx;
  bottom: calc(140rpx + var(--safe-bottom, 0px));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--bg-card);
  border: 1rpx solid var(--divider);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 220;
  transition: transform 0.2s, opacity 0.2s;
}
.fab-search--hover { opacity: 0.85; }
.fab-search.on { transform: rotate(90deg); }
.fab-search-icon { width: 44rpx; height: 44rpx; }
.nav-light { display: inline-block; }
.nav-dark { display: none; }
.page--dark .nav-light { display: none; }
.page--dark .nav-dark { display: inline-block; }
