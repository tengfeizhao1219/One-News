/* 详情页样式 — 跨分类阅读模式 + 底部操作栏 */

.page {
  height: 100vh;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
}

/* ============ 顶部导航栏 ============ */

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 48rpx;
  flex-shrink: 0;
}

.nav-back {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}

.nav-position {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background-color: var(--tag-bg, rgba(0,0,0,0.04));
  padding: 4rpx 18rpx;
  border-radius: 18rpx;
  letter-spacing: 1rpx;
}

/* 跨分类进度中的分类名（fadeIn 200ms） */
.position-category {
  font-weight: 600;
  animation: fadeInCat 0.2s ease;
}

@keyframes fadeInCat {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ============ 跨分类闪烁条 ============ */

.category-flash {
  width: 40rpx;
  height: 4rpx;
  border-radius: 2rpx;
  margin: 0 auto;
  animation: flashPulse 0.2s ease;
}

@keyframes flashPulse {
  0%   { opacity: 0; }
  50%  { opacity: 1; }
  100% { opacity: 0; }
}

/* ============ 正文区域 ============ */

.content {
  flex: 1;
  overflow-y: auto;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom) + 32rpx);
}

/* 翻页动画容器 */
.article {
  transition: transform 0.35s ease, opacity 0.35s ease;
  will-change: transform, opacity;
}
.article.out-up   { transform: translateY(-100%); opacity: 0; }
.article.out-down { transform: translateY(100%);  opacity: 0; }
.article.in-up    { transform: translateY(100%);  opacity: 0; }
.article.in-down  { transform: translateY(-100%); opacity: 0; }

/* 上下翻页按钮 */
.pager-hint {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 140rpx;
  display: flex;
  justify-content: space-between;
  padding: 0 48rpx;
  pointer-events: none;
  z-index: 18;
}
.pager-btn {
  pointer-events: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 40rpx;
  line-height: 1.1;
  color: var(--text-secondary);
  background-color: var(--tag-bg, rgba(0,0,0,0.04));
  padding: 14rpx 22rpx;
  border-radius: 20rpx;
}
.pager-btn text {
  font-size: calc(22rpx * var(--font-scale));
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

/* ============ 边界提示 Chip ============ */

.boundary-chip {
  position: fixed;
  bottom: 180rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 25;
  background: var(--chip-bg);
  color: var(--chip-text);
  font-size: calc(26rpx * var(--font-scale));
  padding: 20rpx 36rpx;
  border-radius: 28rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.boundary-chip.show {
  opacity: 1;
}

.chip-action {
  text-decoration: underline;
  pointer-events: auto;
}

/* ============ 网络兜底 Toast ============ */

.network-toast {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 25;
  background: rgba(245, 158, 11, 0.15);
  color: var(--color-warning);
  font-size: calc(26rpx * var(--font-scale));
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.network-toast.show {
  opacity: 1;
}

/* ============ 正文排版 ============ */

.detail-body {
  padding: 16rpx 64rpx 80rpx;
}

.detail-title {
  font-size: calc(48rpx * var(--font-scale));
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.45;
  margin-bottom: 28rpx;
  letter-spacing: -0.5rpx;
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: calc(26rpx * var(--font-scale));
  color: var(--text-secondary);
  margin-bottom: 20rpx;
  letter-spacing: 0.5rpx;
}

.detail-source-link {
  margin-bottom: 36rpx;
}

.detail-source-link text {
  display: inline-flex;
  align-items: center;
  font-size: calc(26rpx * var(--font-scale));
  color: var(--text-link, #576b95);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background-color: var(--bg-subtle, rgba(87, 107, 149, 0.06));
}

.detail-divider {
  height: 1rpx;
  background-color: var(--divider);
  margin-bottom: 48rpx;
}

.detail-text {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
}

.text-p {
  font-size: calc(34rpx * var(--font-scale));
  color: var(--text-body);
  line-height: calc(2.2 * var(--font-scale));
  margin-bottom: 40rpx;
  letter-spacing: 1rpx;
  text-indent: 2em;
}

.back-bottom {
  text-align: center;
  padding: 80rpx 0 60rpx;
  font-size: calc(28rpx * var(--font-scale));
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}

/* ============ 底部操作栏（收藏 + 分享） ============ */

.detail-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background-color: var(--bottom-bar-bg);
  backdrop-filter: var(--setting-panel-blur);
  -webkit-backdrop-filter: var(--setting-panel-blur);
  border-top: 1rpx solid var(--divider);
}

.bottom-bar-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 20rpx 0;
  font-size: calc(24rpx * var(--font-scale));
  color: var(--text-secondary);
  transition: transform 0.15s ease;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: 1;
}

.bottom-bar-btn::after {
  border: none;
}

.bottom-bar-btn:active {
  transform: scale(0.9);
}

.share-btn-reset {
  margin: 0;
  padding: 20rpx 0;
  font-size: calc(24rpx * var(--font-scale));
  color: var(--text-secondary);
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: 1;
}

.share-btn-reset::after {
  border: none;
}

.bottom-bar-icon {
  font-size: 44rpx;
  line-height: 1;
}

.bottom-bar-label {
  font-size: calc(24rpx * var(--font-scale));
  color: var(--text-secondary);
}

.bottom-bar-btn.is-favorited .bottom-bar-icon {
  color: var(--color-favorite);
}

@keyframes heartBeat {
  0%   { transform: scale(1); }
  30%  { transform: scale(1.25); }
  60%  { transform: scale(0.95); }
  100% { transform: scale(1); }
}

.bottom-bar-btn.heart-anim .bottom-bar-icon {
  animation: heartBeat 0.3s ease-out;
}

@media (prefers-color-scheme: dark) {
  .bottom-bar-btn.is-favorited .bottom-bar-icon {
    color: var(--color-favorite-active);
  }
}
