/* 详情页样式 — 跨分类阅读模式 + 底部操作栏 */

.page {
  height: 100vh;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
}

/* ============ 顶部导航栏 ============ */

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 48rpx;
  flex-shrink: 0;
}

/*  nav-back 已移除 */

.nav-position {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: calc(26rpx * var(--font-scale));  /* D-05#3: 参与字号缩放 */
  color: var(--text-secondary);
  background-color: var(--tag-bg, rgba(0,0,0,0.04));
  padding: 4rpx 18rpx;
  border-radius: 18rpx;
  letter-spacing: 1rpx;
}

/* 跨分类进度中的分类名（fadeIn 200ms） */
.position-category {
  font-weight: 600;
  animation: fadeInCat 0.2s ease;
}

@keyframes fadeInCat {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ============ 跨分类闪烁条 ============ */

.category-flash {
  width: 40rpx;
  height: 4rpx;
  border-radius: 2rpx;
  /* D-05#8: 父容器 nav-bar 为 flex，margin:auto 可居中；非 flex 时降级为 text-align */
  margin: 0 auto;
  animation: flashPulse 0.2s ease;
}

@keyframes flashPulse {
  0%   { opacity: 0; }
  50%  { opacity: 1; }
  100% { opacity: 0; }
}

/* ============ 正文区域 ============ */

.content {
  flex: 1;
  overflow-y: auto;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom) + 32rpx);
}

/* 翻页动画容器 */
.article {
  transition: transform 0.35s ease, opacity 0.35s ease;
  will-change: transform, opacity;
}
.article.out-up   { transform: translateY(-100%); opacity: 0; }
.article.out-down { transform: translateY(100%);  opacity: 0; }
.article.in-up    { transform: translateY(100%);  opacity: 0; }
.article.in-down  { transform: translateY(100%);  opacity: 0; }

/*  边界提示 Chip + chip-action 已移除 */

/* ============ 网络兜底 Toast ============ */

.network-toast {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 25;
  background: rgba(245, 158, 11, 0.15);
  color: var(--color-warning);
  font-size: calc(26rpx * var(--font-scale));
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.network-toast.show {
  opacity: 1;
}

/* ============ 正文排版 ============ */

.detail-body {
  padding: 32rpx 64rpx 80rpx;  /* UX-IMPROVE05: 16→32 标题与状态栏间增加呼吸感 */
}

.detail-title {
  font-size: calc(48rpx * var(--font-scale));
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.45;
  margin-bottom: 28rpx;
  letter-spacing: -0.5rpx;
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
  letter-spacing: 0.5rpx;
  flex-wrap: wrap;
}

.detail-divider {
  height: 1rpx;
  background-color: var(--divider);
  margin-bottom: 48rpx;
}

.detail-text {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
}

.text-p {
  font-size: calc(32rpx * var(--font-scale));
  color: var(--text-body);
  line-height: calc(2.15 * var(--font-scale));
  margin-bottom: 40rpx;
  letter-spacing: 1rpx;
  text-indent: 2em;
}

/*  back-bottom 已移除 */

/* ============ 底部操作栏（收藏 + 分享） ============ */

.detail-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background-color: var(--bottom-bar-bg);
  backdrop-filter: var(--setting-panel-blur);
  -webkit-backdrop-filter: var(--setting-panel-blur);
  border-top: 1rpx solid var(--divider);
}

.bottom-bar-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 22rpx 0;  /* D-05#4: 热区 44+22+22=88rpx ≥ 微信无障碍建议 */
  font-size: calc(24rpx * var(--font-scale));
  color: var(--text-secondary);
  transition: transform 0.15s ease;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: 1;
}

.bottom-bar-btn::after {
  border: none;
}

.bottom-bar-btn:active {
  transform: scale(0.9);
}

.share-btn-reset {
  margin: 0;
  padding: 22rpx 0;  /* D-05#4: 热区 44+22+22=88rpx ≥ 微信无障碍建议 */
  font-size: calc(24rpx * var(--font-scale));
  color: var(--text-secondary);
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: 1;
}

.share-btn-reset::after {
  border: none;
}

.bottom-bar-icon {
  font-size: 44rpx;
  line-height: 1;
}

.bottom-bar-label {
  font-size: calc(24rpx * var(--font-scale));
  color: var(--text-secondary);
}

.bottom-bar-btn.is-favorited .bottom-bar-icon {
  color: var(--color-favorite);
}

@keyframes heartBeat {
  0%   { transform: scale(1); }
  30%  { transform: scale(1.25); }
  60%  { transform: scale(0.95); }
  100% { transform: scale(1); }
}

.bottom-bar-btn.heart-anim .bottom-bar-icon {
  animation: heartBeat 0.3s ease-out;
}

@media (prefers-color-scheme: dark) {
  .bottom-bar-btn.is-favorited .bottom-bar-icon {
    color: var(--color-favorite-active);
  }
}

/* UX-FIX04: 超大字号（tier 3）截断保护 */
[data-font-scale="3"] .detail-title {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

[data-font-scale="3"] .text-p {
  display: -webkit-box;
  -webkit-line-clamp: 6;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

[data-font-scale="3"] .detail-meta {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
