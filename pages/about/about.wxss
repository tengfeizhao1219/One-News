/* 关于一页 — dock「扩展位」改造（AB-01）· BUG-20260806-004 导航栏对齐胶囊
   字号统一（2026-09-09 3.0.0）：一套层级——
     区块标题 section-title 26 / 项标题(pi·commitment·story) 28 / 正文叙述(origin) 28
     说明文字(pi-desc·commitment-desc·story-p) 26 / 引子·悬念(teaser·mystery·more) 24
     元信息(version·date·sign·footer) 20-22 —— 所有字号不再叠加多余缩放系数 */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg-page);
  color: var(--text-primary);
}

/* ========== 导航栏（D-09 v1.2 · BUG-20260806-007） ========== */
.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 22;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* D-09 v1.2: explicit 锚定胶囊中心 — top 由 wxml inline 注入，不依赖 top:50% */
.nav-home {
  position: absolute;
  left: 12rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.nav-home--hover {
  background-color: var(--bg-subtle);
}

.nav-home-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 滚动容器（D-09 v1.2: 内容从导航栏下方 8rpx 开始） */
.scroller {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding-top: calc(var(--nav-offset, 0px) + 8rpx);
}

/* 品牌区 */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 36rpx;
}

.brand-name {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
  font-size: 72rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 8rpx;
}

.brand-slogan {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
}

/* 版本号入口（2026-08-09）：点击触发更新日志弹窗 */
.brand-version {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 1rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background: var(--tag-bg);
}

/* 区块 */
.section {
  padding: 0 32rpx 36rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-tertiary);
  margin: 0 8rpx 16rpx;
  letter-spacing: 2rpx;
}

.card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid var(--divider);
}

/* 初衷 */
.origin-p {
  font-size: 28rpx;
  line-height: 1.85;
  color: var(--text-body);
  margin-bottom: 16rpx;
}

/* 初衷展开入口（2026-09-09：默认折叠到第一段） */
.origin-more {
  display: inline-block;
  padding: 4rpx 20rpx 10rpx 4rpx;
}
.origin-more--hover {
  opacity: 0.7;
}
.origin-more-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 初衷落款（owner 亲笔寄语：书于正式上线前） */
.origin-sign {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--divider);
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-secondary);
  text-align: right;
  letter-spacing: 1rpx;
}

/* 坚持的事 */
.commitment {
  padding: 14rpx 0;
}

.commitment + .commitment {
  border-top: 1rpx solid var(--divider);
}

.commitment-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.commitment-desc {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-body);
}

/* 页脚 */
.footer {
  text-align: center;
  /* 32rpx 水平 padding → logo 卡片宽度与上方 .section 卡片一致 */
  padding: 48rpx 32rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
/* Logo 卡片：宽度/圆角与 .card 保持一致 (20rpx + border) */
.footer-logo-card {
  width: 100%;
  background: var(--bg-card);
  border: 1rpx solid var(--divider);
  border-radius: 20rpx;
  overflow: hidden;
}
.footer-text {
  margin-top: 20rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}

/* ===== 产品介绍（2026-09-09 3.0.0） ===== */
.pi-row {
  padding: 14rpx 0;
}
.pi-row + .pi-row {
  border-top: 1rpx solid var(--divider);
}
.pi-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.pi-desc {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}
.pi-mystery {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--divider);
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
}

/* ===== 版本故事（2026-09-09 3.0.0：默认折叠，展开阅读） ===== */
.story {
  padding: 4rpx 0;
}
.story + .story {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--divider);
}
.story-head {
  padding: 8rpx 0 12rpx;
}
.story-meta {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.story-version {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--primary);
}
.story-date {
  font-size: 20rpx;
  color: var(--text-tertiary);
}
.story-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.story-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
}
.story-title.open {
  color: var(--text-secondary);
  font-weight: 500;
}
.story-chev {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--text-tertiary);
}
.story-teaser {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
}
.story-body {
  margin-top: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed var(--divider);
}
.story-p {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.85;
  margin-bottom: 12rpx;
}
.story-p:last-child {
  margin-bottom: 0;
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-align: right;
}
