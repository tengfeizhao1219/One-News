/* 关于一页 — dock「扩展位」改造（AB-01）· BUG-20260806-004 导航栏对齐胶囊 */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg-page);
  color: var(--text-primary);
}

/* ========== 导航栏（D-09 v1.2 · BUG-20260806-007） ========== */
.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 22;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* D-09 v1.2: explicit 锚定胶囊中心 — top 由 wxml inline 注入，不依赖 top:50% */
.nav-home {
  position: absolute;
  left: 12rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.nav-home--hover {
  background-color: var(--bg-subtle);
}

.nav-home-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 滚动容器（D-09 v1.2: 内容从导航栏下方 8rpx 开始） */
.scroller {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding-top: calc(var(--nav-offset, 0px) + 8rpx);
}

/* 品牌区 */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 48rpx 36rpx;
}

/* Logo v1.0（PD 2026-08-09 终稿）：wordmark 主标，宽 360rpx 居中，下方留白接品牌名 */
.brand-logo {
  width: 360rpx;
  height: 112rpx; /* 640:200 比例，360rpx 宽 → 112.5rpx 高 */
  margin-bottom: 24rpx;
}

.brand-name {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
  font-size: 72rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 8rpx;
}

.brand-slogan {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
}

/* 版本号入口（2026-08-09）：点击触发更新日志弹窗 */
.brand-version {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 1rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background: var(--tag-bg);
}

/* 区块 */
.section {
  padding: 0 32rpx 36rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-tertiary);
  margin: 0 8rpx 16rpx;
  letter-spacing: 2rpx;
}

.card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid var(--divider);
}

/* 初衷 */
.origin-p {
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--text-body);
  margin-bottom: 16rpx;
}

/* 初衷落款（owner 亲笔寄语：书于正式上线前） */
.origin-sign {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--divider);
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-secondary);
  text-align: right;
  letter-spacing: 1rpx;
}

/* 坚持的事 */
.commitment {
  padding: 14rpx 0;
}

.commitment + .commitment {
  border-top: 1rpx solid var(--divider);
}

.commitment-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.commitment-desc {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-body);
}

/* 页脚 */
.footer {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-tertiary);
  padding: 8rpx 0 48rpx;
  letter-spacing: 2rpx;
}
