<!-- 首页 - 卡片流主视图 -->
<wxs module="touch" src="./touch.wxs"></wxs>

<view class="page" data-font-scale="{{fontScaleTier}}">

  <!-- 固定顶部栏：刷新（左侧）+ 设置（右侧） -->
  <view class="fixed-top-bar" style="padding-top: {{statusBarHeight + 6}}px;">
    <view class="top-bar-inner">
      <view class="top-bar-refresh" bindtap="onRefreshNews">
        <text class="refresh-icon">{{isRefreshing ? '...' : 'R'}}</text>
      </view>
      <view class="top-bar-settings" bindtap="onOpenSettings">
        <text class="settings-icon">⚙</text>
      </view>
    </view>
  </view>

  <!-- ========== 骨架屏（加载中） ========== -->
  <view class="skeleton-stage" wx:if="{{pageState === 'loading'}}">
    <view class="skeleton-card" wx:for="{{skeletonCount}}" wx:key="*this">
      <view class="sk-title"></view>
      <view class="sk-line sk-line-1"></view>
      <view class="sk-line sk-line-2"></view>
      <view class="sk-line sk-line-3 sk-short"></view>
      <view class="sk-meta">
        <view class="sk-tag"></view>
        <view class="sk-source"></view>
      </view>
    </view>
  </view>

  <!-- ========== 错误状态 ========== -->
  <view class="state-container" wx:if="{{pageState === 'error'}}">
    <view class="state-icon">!</view>
    <view class="state-message">{{errorMessage}}</view>
    <view class="state-retry" bindtap="onRetry">点击重试</view>
  </view>

  <!-- ========== 空数据状态 ========== -->
  <view class="state-container" wx:if="{{pageState === 'empty'}}">
    <view class="state-icon">-</view>
    <view class="state-message">{{errorMessage}}</view>
    <view class="state-retry" bindtap="onRetry">下拉刷新试试</view>
  </view>

  <!-- ========== 正常卡片流 ========== -->
  <view class="card-stage {{showPanel ? 'hidden' : ''}}" wx:if="{{pageState === 'ready'}}"
    bindtouchstart="{{touch.handleTouchStart}}" 
    bindtouchmove="{{touch.handleTouchMove}}" 
    bindtouchend="{{touch.handleTouchEnd}}">
    <block wx:for="{{cards}}" wx:key="id">
      <view 
        class="card {{item.state}} {{touch.isDragging() ? '' : item.transitionClass}}"
        style="transform: translateY({{touch.getTranslateY(item.state, item.translateY)}}px); opacity: {{touch.getOpacity(item.state, item.opacity)}};"
        data-id="{{item.id}}"
        bindtap="onCardTap">

        <view class="card-body">
          <!-- 标题 -->
          <view class="card-title">{{item.title}}</view>
          
          <!-- 摘要 -->
          <view class="card-summary">
            <block wx:for="{{item.summaryParagraphs}}" wx:key="*this">
              <view class="summary-p">{{item}}</view>
            </block>
          </view>
          
          <!-- 元信息 -->
          <view class="card-meta">
            <view class="category-tag">{{item.categoryName}}</view>
            <text>{{item.source}}</text>
            <text wx:if="{{item.source && item.time}}"> - </text>
            <text>{{item.time}}</text>
          </view>
        </view>

        <!-- 底部提示 -->
        <view class="swipe-hint">^ 上滑阅读下一条</view>
      </view>
    </block>
  </view>

  <!-- 导航指示点 -->
  <view class="nav-dots" wx:if="{{pageState === 'ready' && newsList.length > 0}}">
    <view 
      wx:for="{{newsList}}" 
      wx:key="id" 
      class="nav-dot {{index === currentIndex ? 'active' : ''}}">
    </view>
  </view>

  <!-- 侧边栏遮罩（点击关闭） -->
  <view 
    class="panel-overlay {{showPanel ? 'show' : ''}}" 
    bindtap="closePanel">
  </view>

  <!-- 侧边栏面板 -->
  <view class="slide-panel {{showPanel ? 'show' : ''}}">
    <view class="panel-header">
      <text class="panel-title">今日新闻</text>
    </view>

    <!-- 分类标签（当前分类高亮，切换不关闭面板） -->
    <scroll-view class="panel-tabs" scroll-x enable-flex>
      <view 
        wx:for="{{panelCategories}}" 
        wx:key="id"
        class="panel-tab {{panelCategory === item.id ? 'active' : ''}}"
        data-cat="{{item.id}}"
        bindtap="onCategoryChange">
        {{item.name}}
      </view>
    </scroll-view>

    <!-- B-04 收藏列表（当选中「❤️ 收藏」时） -->
    <scroll-view class="panel-list" scroll-y wx:if="{{panelCategory === '__favorites__'}}">
      <view 
        wx:for="{{favList}}" 
        wx:key="id"
        class="panel-item"
        data-index="{{index}}"
        data-is-fav="true"
        bindtap="onPanelItemTap">
        <view class="panel-item-title">{{item.title}}</view>
        <view class="panel-item-meta">
          <text class="fav-source">{{item.source || item.categoryName}}</text>
          <text class="fav-time">{{item._timeAgo}}</text>
        </view>
      </view>
      <!-- 收藏空态 -->
      <view wx:if="{{favList.length === 0}}" class="panel-empty panel-empty-fav">
        <view class="empty-fav-icon">♡</view>
        <view class="empty-fav-text">还没有收藏任何新闻</view>
        <view class="empty-fav-hint">浏览新闻时点击 ♥ 即可收藏</view>
      </view>
    </scroll-view>

    <!-- 新闻列表（非收藏 Tab） -->
    <scroll-view class="panel-list" scroll-y wx:else>
      <view 
        wx:for="{{filteredNewsList}}" 
        wx:key="id"
        class="panel-item {{item._originalIndex === panelCurrentIndex ? 'current' : ''}}"
        data-index="{{item._originalIndex}}"
        bindtap="onPanelItemTap">
        <view class="panel-item-title {{item._originalIndex === panelCurrentIndex ? 'current' : ''}}">{{item.title}}</view>
      </view>
      <view wx:if="{{filteredNewsList.length === 0}}" class="panel-empty">
        暂无新闻
      </view>
    </scroll-view>
  </view>

  <!-- 首次引导 -->
  <view class="guide-overlay" wx:if="{{showGuide}}">
    <text>^ 上滑阅读下一条\n&lt;- 左滑查看今日列表\n- 点击卡片进入阅读</text>
  </view>

  <!-- 字体设置面板（底部半屏） -->
  <font-panel
    visible="{{showFontPanel}}"
    currentTier="{{fontScaleTier}}"
    bind:change="onFontPanelChange"
    bind:close="onCloseFontPanel">
  </font-panel>
</view>
