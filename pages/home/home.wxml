<!-- 首页 - 卡片流主视图 -->
<view class="page" 
  bindtouchstart="onTouchStart" 
  bindtouchmove="onTouchMove" 
  bindtouchend="onTouchEnd">

  <!-- 固定顶部栏：搜索图标（左侧） -->
  <view class="fixed-top-bar" style="padding-top: {{statusBarHeight + 6}}px;">
    <view class="top-bar-inner">
      <view class="top-bar-search" bindtap="goSearch">
        <text class="search-icon-top">🔍</text>
      </view>
    </view>
  </view>

  <!-- 卡片容器 -->
  <view class="card-stage {{showPanel ? 'hidden' : ''}}">
    <block wx:for="{{cards}}" wx:key="id">
      <view 
        class="card {{item.state}} {{item.transitionClass}}"
        style="transform: translateY({{item.translateY}}px);"
        data-id="{{item.id}}"
        bindtap="onCardTap">

        <view class="card-body">
          <!-- 标题 -->
          <view class="card-title">{{item.title}}</view>
          
          <!-- 摘要 -->
          <view class="card-summary">
            <block wx:for="{{item.summaryParagraphs}}" wx:key="*this">
              <view class="summary-p">{{item}}</view>
            </block>
          </view>
          
          <!-- 元信息 -->
          <view class="card-meta">
            <view class="category-tag">{{item.categoryName}}</view>
            <text>{{item.source}}</text>
            <text>·</text>
            <text>{{item.time}}</text>
          </view>
        </view>

        <!-- 底部提示 -->
        <view class="swipe-hint">↑ 上滑阅读下一条</view>
      </view>
    </block>
  </view>

  <!-- 侧边栏遮罩（点击关闭） -->
  <view 
    class="panel-overlay {{showPanel ? 'show' : ''}}" 
    bindtap="closePanel"
    catchtouchmove="preventMove">
  </view>

  <!-- 侧边栏面板 -->
  <view class="slide-panel {{showPanel ? 'show' : ''}}">
    <view class="panel-header">
      <text class="panel-title">今日新闻</text>
    </view>

    <!-- 分类标签（当前分类高亮，切换不关闭面板） -->
    <scroll-view class="panel-tabs" scroll-x enable-flex>
      <view 
        wx:for="{{categories}}" 
        wx:key="id"
        class="panel-tab {{panelCategory === item.id ? 'active' : ''}}"
        data-cat="{{item.id}}"
        bindtap="onCategoryChange">
        {{item.name}}
      </view>
    </scroll-view>

    <!-- 新闻列表 -->
    <scroll-view class="panel-list" scroll-y>
      <view 
        wx:for="{{filteredNewsList}}" 
        wx:key="id"
        class="panel-item {{item._originalIndex === panelCurrentIndex ? 'current' : ''}}"
        data-index="{{item._originalIndex}}"
        bindtap="onPanelItemTap">
        <view class="panel-item-title {{item._originalIndex === panelCurrentIndex ? 'current' : ''}}">{{item.title}}</view>
      </view>
      <view wx:if="{{filteredNewsList.length === 0}}" class="panel-empty">
        暂无新闻
      </view>
    </scroll-view>
  </view>

  <!-- 首次引导 -->
  <view class="guide-overlay" wx:if="{{showGuide}}">
    <text>↑ 上滑阅读下一条\n← 左滑查看今日列表\n· 点击卡片阅读全文</text>
  </view>
</view>
