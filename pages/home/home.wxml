<!-- 首页 - 卡片流主视图 -->
<wxs module="touch" src="./touch.wxs"></wxs>

<!-- UX-FIX-F13: 根节点注入 --font-scale / --font-scale-meta，修复缩放变量从未进入 DOM 的断链 -->
<view
  class="page"
  data-font-scale="{{fontScaleTier}}"
  style="--font-scale: {{_fontScaleValue}}; --font-scale-meta: {{_metaScaleValue}};">

  <!-- 固定顶部栏（S4 owner 2026-08-02 决策：取消 R 按钮，刷新入口统一为下拉刷新） -->
  <view class="fixed-top-bar" style="padding-top: {{statusBarHeight + 6}}px;">
    <view class="top-bar-inner">
      <!-- R 按钮已移除，下拉刷新即强制拉新入口 -->
    </view>
  </view>

  <!-- ========== 骨架屏（加载中） ========== -->
  <view class="skeleton-stage" wx:if="{{pageState === 'loading'}}">
    <view class="skeleton-card" wx:for="{{skeletonCount}}" wx:key="*this">
      <view class="sk-title"></view>
      <view class="sk-line sk-line-1"></view>
      <view class="sk-line sk-line-2"></view>
      <view class="sk-line sk-line-3 sk-short"></view>
      <view class="sk-meta">
        <view class="sk-tag"></view>
        <view class="sk-source"></view>
      </view>
    </view>
  </view>

  <!-- ========== 错误状态 ========== -->
  <view class="state-container" wx:if="{{pageState === 'error'}}">
    <view class="state-icon">!</view>
    <view class="state-message">{{errorMessage}}</view>
    <view class="state-retry" bindtap="onRetry">点击重试</view>
  </view>

  <!-- ========== 空数据状态 ========== -->
  <view class="state-container" wx:if="{{pageState === 'empty'}}">
    <view class="state-icon">-</view>
    <view class="state-message">{{errorMessage}}</view>
    <view class="state-retry" bindtap="onRetry">下拉刷新试试</view>
  </view>

  <!-- ========== 正常卡片流 ========== -->
  <view class="card-stage {{showPanel ? 'hidden' : ''}}" wx:if="{{pageState === 'ready'}}"
    bindtouchstart="{{touch.handleTouchStart}}" 
    bindtouchmove="{{touch.handleTouchMove}}" 
    bindtouchend="{{touch.handleTouchEnd}}">
    <block wx:for="{{cards}}" wx:key="id">
      <view 
        class="card {{item.state}} {{touch.isDragging() ? '' : item.transitionClass}}"
        style="transform: translateY({{touch.getTranslateY(item.state, item.translateY)}}px); opacity: {{touch.getOpacity(item.state, item.opacity)}};"
        data-id="{{item.id}}"
        bindtap="onCardTap">

        <view class="card-body">
          <!-- 标题 -->
          <view class="card-title">{{item.title}}</view>
          <!-- 元信息（owner 直连：移至标题下方，与详情页布局一致） -->
          <view class="card-meta">
            <view class="category-tag">{{item.categoryName}}</view>
            <text wx:if="{{item.source}}">{{item.source}}</text>
            <text wx:if="{{item.source && item.time}}">·</text>
            <text wx:if="{{item.time}}">{{item.time}}</text>
          </view>
        <!-- 摘要 -->
        <view class="card-summary">
          <block wx:for="{{item.summaryParagraphs}}" wx:key="*this">
            <view class="summary-p">{{item}}</view>
          </block>
        </view>
      </view>
    </view>
  </block>
  </view>

  <!-- 底部固定滑动提示条（UI-B7 §3.5，固定于屏幕底部，不随内容滚动，不响应点击） -->
  <view class="fixed-swipe-hint" wx:if="{{pageState === 'ready' && !showPanel}}">
    <text class="fixed-swipe-hint-icon">⇅</text>
    <text class="fixed-swipe-hint-text">上滑阅读下一条</text>
  </view>

  <!-- 导航指示点（UX-IMPROVE06: 支持点击跳转） -->
  <view class="nav-dots" wx:if="{{pageState === 'ready' && newsList.length > 0}}">
    <view 
      wx:for="{{newsList}}" 
      wx:key="id" 
      class="nav-dot {{index === currentIndex ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onNavDotTap">
    </view>
  </view>

  <!-- BUG-20260802-006: 分类切换 0.5s 提示 -->
  <view class="category-hint {{categoryHint ? 'show' : ''}}">{{categoryHint}}</view>

  <!-- BUG-20260802-005 / TL-B16：⚙ 浮动按钮升级为「更多功能」dock 菜单主入口 -->
  <view class="floating-more {{showPanel ? 'hidden' : ''}}" bindtap="toggleMoreMenu">
    <view class="more-icon"></view>
  </view>

  <!-- 更多功能菜单（dock 栈向上弹出，毛玻璃背景，点击空白或再次点击⚙收起） -->
  <view class="more-mask {{showMoreMenu ? 'show' : ''}}" bindtap="toggleMoreMenu"></view>
  <view class="more-menu {{showMoreMenu ? 'show' : ''}}">
    <view class="more-item" data-target="history" bindtap="onMoreMenuTap">
      <view class="more-item-icon" style="-webkit-mask-image: url('/assets/icons/history.svg'); mask-image: url('/assets/icons/history.svg');"></view>
      <text class="more-item-label">浏览记录</text>
    </view>
    <view class="more-item" data-target="favorites" bindtap="onMoreMenuTap">
      <view class="more-item-icon" style="-webkit-mask-image: url('/assets/icons/favorite.svg'); mask-image: url('/assets/icons/favorite.svg');"></view>
      <text class="more-item-label">我的收藏</text>
    </view>
    <view class="more-item" data-target="settings" bindtap="onMoreMenuTap">
      <view class="more-item-icon" style="-webkit-mask-image: url('/assets/icons/settings.svg'); mask-image: url('/assets/icons/settings.svg');"></view>
      <text class="more-item-label">设置</text>
    </view>
    <view class="more-item more-item--ext" data-target="ext" bindtap="onMoreMenuTap">
      <view class="more-item-icon" style="-webkit-mask-image: url('/assets/icons/plus.svg'); mask-image: url('/assets/icons/plus.svg');"></view>
      <text class="more-item-label">扩展位</text>
    </view>
  </view>

  <!-- 侧边栏遮罩（点击关闭） -->
  <view 
    class="panel-overlay {{showPanel ? 'show' : ''}}" 
    bindtap="closePanel">
  </view>

  <!-- 侧边栏面板（UI-B7：左侧分类滚轮 + 右侧仅标题列表，圆角高亮） -->
  <view class="slide-panel {{showPanel ? 'show' : ''}}">
    <view class="panel-header">
      <text class="panel-title">今日新闻</text>
      <text class="panel-subtitle">{{panelSubtitle}}</text>
      <view class="panel-close" bindtap="closePanel">
        <view class="panel-close-icon" style="-webkit-mask-image: url('/assets/icons/close.svg'); mask-image: url('/assets/icons/close.svg');"></view>
      </view>
    </view>

    <view class="panel-body">
      <!-- 左侧垂直分类滚轮（RQ-15-D / UI-B7 §3.2） -->
      <category-wheel
        class="panel-wheel"
        categories="{{panelCategories}}"
        activeId="{{panelCategory}}"
        bind:change="onWheelChange">
      </category-wheel>

      <!-- 右侧仅标题列表（去缩略图/来源/时间，当前项圆角高亮） -->
      <scroll-view class="panel-list" scroll-y>
        <view 
          wx:for="{{filteredNewsList}}" 
          wx:key="id"
          class="panel-item {{item._originalIndex === panelCurrentIndex ? 'current' : ''}}"
          data-index="{{item._originalIndex}}"
          bindtap="onPanelItemTap">
          <text class="panel-item-title">{{item.title}}</text>
        </view>
        <view wx:if="{{filteredNewsList.length === 0}}" class="panel-empty">
          暂无新闻
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 字体设置面板（底部半屏） -->
  <font-panel
    visible="{{showFontPanel}}"
    currentTier="{{fontScaleTier}}"
    bind:change="onFontPanelChange"
    bind:close="onCloseFontPanel">
  </font-panel>
</view>
