// WXS 响应式触摸处理 —— 避免 JS 层高频 setData
// 直接操作 WXS 变量实现拖拽跟手，松手后通过回调通知 JS 层执行切换

var touchState = {
  startY: 0,
  startX: 0,
  offsetY: 0,
  isDragging: false,
  direction: 0, // 1=上滑, -1=下滑
  pageHeight: 667,
  threshold: 50,
}

// 外部注入：设置页面高度
function setPageHeight(height) {
  touchState.pageHeight = height
}

// 获取当前拖拽偏移（用于内联 style 绑定）
// 仅在拖拽中返回 WXS 计算值；否则返回 fallback 让 wxml 使用 item.translateY
function getTranslateY(state, fallback) {
  if (!touchState.isDragging) return fallback
  var offset = touchState.offsetY
  if (state === 'active') {
    return offset
  }
  if (state === 'below' && touchState.direction === 1) {
    return touchState.pageHeight + offset
  }
  if (state === 'above' && touchState.direction === -1) {
    return -touchState.pageHeight + offset
  }
  return fallback
}

// 获取当前透明度
// 仅在拖拽中返回 WXS 计算值；否则返回 fallback（item.opacity）
function getOpacity(state, fallback) {
  if (!touchState.isDragging) return fallback
  var progress = Math.abs(touchState.offsetY) / touchState.pageHeight
  if (progress > 1) progress = 1
  if (state === 'active') {
    return 1 - progress * 0.4
  }
  if ((state === 'below' && touchState.direction === 1) || (state === 'above' && touchState.direction === -1)) {
    return progress
  }
  return fallback
}

// 拖拽中返回 true 表示应禁用 transition
function isDragging() {
  return touchState.isDragging
}

// 绑定给 WXML 的 touch 事件处理函数
function handleTouchStart(event, ownerInstance) {
  var touch = event.touches[0]
  touchState.startY = touch.clientY
  touchState.startX = touch.clientX
  touchState.offsetY = 0
  touchState.isDragging = false
  touchState.direction = 0

  // 通知 JS 层
  ownerInstance.callMethod('onWxsTouchStart', {
    startY: touch.clientY,
    startX: touch.clientX
  })
  return false
}

function handleTouchMove(event, ownerInstance) {
  var touch = event.touches[0]
  var dy = touch.clientY - touchState.startY
  var dx = touch.clientX - touchState.startX

  // 水平滑动优先
  if (!touchState.isDragging && Math.abs(dx) > 10 && Math.abs(dx) > Math.abs(dy)) {
    touchState.isDragging = true
  }
  if (touchState.isDragging && Math.abs(dx) > Math.abs(dy)) {
    return false
  }

  // 垂直滑动：确定方向
  if (!touchState.isDragging && Math.abs(dy) > 5) {
    touchState.isDragging = true
    touchState.direction = dy < 0 ? 1 : -1
  }

  if (touchState.isDragging && Math.abs(dy) > Math.abs(dx)) {
    var maxOffset = touchState.pageHeight
    var clamped = dy
    if (clamped < -maxOffset) clamped = -maxOffset
    if (clamped > maxOffset) clamped = maxOffset
    touchState.offsetY = clamped
  }

  // 通知 JS 层当前偏移（低频，用于记录状态）
  ownerInstance.callMethod('onWxsTouchMove', {
    dy: dy,
    offsetY: touchState.offsetY,
    direction: touchState.direction,
    isDragging: touchState.isDragging
  })
  return false
}

function handleTouchEnd(event, ownerInstance) {
  var touch = event.changedTouches[0]
  var dy = touch.clientY - touchState.startY
  var dx = touch.clientX - touchState.startX

  // 通知 JS 层处理切换
  ownerInstance.callMethod('onWxsTouchEnd', {
    dy: dy,
    dx: dx,
    offsetY: touchState.offsetY,
    direction: touchState.direction
  })

  // 立即重置 WXS 状态（避免闪现 —— WXS 的 getTranslateY/getOpacity 不再覆盖 item 值）
  touchState.isDragging = false
  touchState.offsetY = 0
  touchState.direction = 0

  return false
}

// 外部可调：JS 层松手后通知 WXS 开始过渡
function startTransition() {
  touchState.isDragging = false
  touchState.offsetY = 0
  touchState.direction = 0
}

// 导出
module.exports = {
  setPageHeight: setPageHeight,
  getTranslateY: getTranslateY,
  getOpacity: getOpacity,
  isDragging: isDragging,
  handleTouchStart: handleTouchStart,
  handleTouchMove: handleTouchMove,
  handleTouchEnd: handleTouchEnd,
}
