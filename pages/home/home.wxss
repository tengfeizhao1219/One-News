/* 首页样式 - 极简暖灰配色 */

.page {
  height: 100vh;
  /* BUG-20260806-010 (FE): 根背景统一 --bg-card，与详情页一致（原 --bg-page 造成顶部色带割裂 + 两页底色不一致） */
  background-color: var(--bg-card);
  overflow: hidden;
  position: relative;
}

/* ========== 固定顶部栏（与胶囊对齐 · BUG-20260806-004） ==========
   原右上角设置按钮已移除（owner 2026-08-06 13:21 裁定：设置入口统一走 ⚙ dock 菜单）；
   fixed-top-bar 保留为空占位（pointer-events:none 不拦截卡片滑动手势） */
/* BUG-20260806-011 (FE): 状态栏填充层用 position:fixed 真正贴顶（之前 inline 只有 background-color，
   没有 position，会被 .page 文档流推下来，导致顶部 0~statusBarHeight 区域出现"空隙"
   看起来是状态栏与下方条带分离）。z-index:16 在 .fixed-top-bar(15) 之上无关紧要，
   但保持递增清晰递增 */
.status-bar-fill {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  z-index: 16;
}
.fixed-top-bar {
  position: fixed;
  left: 0;
  width: 100%;
  z-index: 17;
  pointer-events: none;
  /* 2026-08-24：顶栏承载「数据截至」小字（靠右），flex 布局不拦截卡片滑动手势 */
  display: flex;
  align-items: center;
  justify-content: flex-end;
  /* 2026-08-24：避让右上角原生胶囊（约 87rpx 宽 + 安全边距），从 32rpx 增加到 120rpx */
  padding-right: 120rpx;
  box-sizing: border-box;
}

/* BUG-20260806-023 (FE): 跨分类切换状态栏小胶囊（与详情页一致）
   定位：top = 状态栏区域垂直居中（status-bar-height/2 - 半高），
   水平居中于屏幕；z-index 高于 status-bar-fill(16)/fixed-top-bar(17) */
.status-pill {
  position: fixed;
  top: calc(var(--status-bar-height, 44px) / 2 - 28rpx);
  left: 50%;
  transform: translateX(-50%) translateY(-10rpx);
  z-index: 50;
  padding: 10rpx 36rpx;
  border-radius: 999rpx;
  background-color: var(--text-primary);
  color: var(--bg-card);
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.status-pill.show {
  opacity: 0.92;
  transform: translateX(-50%) translateY(0);
}

/* ============ 卡片舞台 ============ */
.card-stage {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.card-stage.hidden {
  display: none;
}

.card {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
  opacity: 0;
  pointer-events: none;
  /* v5.9: 所有卡片默认启用 transition，与详情页 .article 一致 */
  transition: transform 0.35s ease, opacity 0.35s ease;
  will-change: transform, opacity;
}

/* v5.9: 翻页动画与详情页 .article 一致——整屏滑出/滑入
   BUG-20260806-026 (FE): 去掉 out/in 的 opacity:0，改纯位移滑动（连续翻页，无淡入淡出）。
   注意 .card 基类 opacity:0，故 out/in 必须显式 opacity:1，否则移出/滑入时不可见。 */
/* 翻页偏移统一用 JS 注入的 --page-h（= windowHeight px），不用 100vh（WXSS transform 内 100vh 在部分机型/Webview 下失效/方向异常） */

/* 首页多卡片模型修复：renderCards 重建 card 节点后，新卡是全新 WX 节点（transform 起点=0），
   直接挂 in-up/in-down 会让 transition 从 0→±page-h（先反方向闪再回正）。
   必须先以 no-transition 瞬间吸附到屏外起点，再移除 class 触发正确方向滑入。 */
.card.no-transition {
  transition: none;
}
/* 上滑翻下一条：当前卡向上移出 */
.card.out-up   { transform: translateY(calc(-1 * var(--page-h, 100vh))); opacity: 1; }
/* 下滑翻上一条：当前卡向下移出 */
.card.out-down { transform: translateY(var(--page-h, 100vh));         opacity: 1; }
/* 上滑翻下一条：新卡从下方滑入 */
.card.in-up    { transform: translateY(var(--page-h, 100vh));         opacity: 1; }
/* 下滑翻上一条：新卡从上方滑入 */
.card.in-down  { transform: translateY(calc(-1 * var(--page-h, 100vh))); opacity: 1; }

.card.active {
  opacity: 1;
  pointer-events: auto;
  z-index: 2;
}

.card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 32rpx 28rpx 24rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* 标题 */
.card-title {
  font-size: calc(36rpx * var(--font-scale, 1));
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.35;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 元信息行 */
.card-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

/* 分类标签 */
.category-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background-color: var(--tag-bg);
  color: var(--text-secondary);
  font-size: calc(20rpx * var(--font-scale-meta, 1));
  font-weight: 500;
  white-space: nowrap;
}

/* 官方源内联元信息（v1.0 §6.2） */
.source-inline {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: var(--text-secondary);
  font-size: calc(20rpx * var(--font-scale-meta, 1));
}
.source-inline .source-name {
  font-weight: 500;
}
.source-inline .outbound-icon {
  font-size: 22rpx;
  opacity: 0.7;
}

/* 正文摘要 */
.card-summary {
  flex: 1;
  overflow: hidden;
  font-size: calc(26rpx * var(--font-scale, 1));
  color: var(--text-secondary);
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 6;
  -webkit-box-orient: vertical;
}

/* 底部信息栏 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  margin-top: auto;
  border-top: 1rpx solid var(--divider);
  font-size: calc(20rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
}

/* 阅读时长 */
.read-time {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* ========== 更多菜单（右下角 ⚙） ========== */
.more-btn {
  position: fixed;
  right: 28rpx;
  bottom: calc(200rpx + var(--safe-bottom, 0px));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: var(--bg-card);
  box-shadow: 0 8rpx 24rpx var(--overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
  font-size: 40rpx;
  color: var(--text-primary);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.more-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx var(--overlay);
}

.more-panel {
  position: fixed;
  right: 28rpx;
  bottom: calc(320rpx + var(--safe-bottom, 0px));
  width: 280rpx;
  background-color: var(--bg-card);
  border-radius: 24rpx;
  box-shadow: 0 16rpx 48rpx var(--overlay);
  z-index: 21;
  overflow: hidden;
  opacity: 0;
  transform: translateY(20rpx) scale(0.95);
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.more-panel.show {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.more-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  background-color: transparent;
  border: none;
  width: 100%;
  text-align: left;
}
.more-item:active {
  background-color: var(--tag-bg);
}
.more-divider {
  height: 1rpx;
  background-color: var(--divider);
  margin: 0 16rpx;
}

/* ========== 分类选择器（横向滚动） ========== */
.category-bar {
  position: sticky;
  top: calc({{menuTop}}px + {{menuHeight}}px + 24rpx);
  z-index: 10;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background-color: var(--bg-card);
  border-bottom: 1rpx solid var(--divider);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.category-bar::-webkit-scrollbar {
  display: none;
}

.category-btn {
  flex: 0 0 auto;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  background-color: var(--tag-bg);
  border: none;
  white-space: nowrap;
  transition: background-color 0.2s, color 0.2s;
}
.category-btn.active {
  background-color: var(--accent);
  color: var(--accent-text);
}

/* ========== 加载中 / 错误 / 空状态 ========== */
.skeleton-stage {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  padding: calc({{menuTop}}px + {{menuHeight}}px + 24rpx + 200rpx) 0 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  align-items: center;
}

.skeleton-card {
  width: 90%;
  background-color: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx var(--overlay);
}

.sk-title {
  height: 40rpx;
  width: 70%;
  background: linear-gradient(90deg, var(--tag-bg) 25%, var(--divider) 50%, var(--tag-bg) 75%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.2s infinite;
  margin-bottom: 16rpx;
}

.sk-line {
  height: 24rpx;
  background: linear-gradient(90deg, var(--tag-bg) 25%, var(--divider) 50%, var(--tag-bg) 75%);
  background-size: 200% 100%;
  border-radius: 6rpx;
  animation: shimmer 1.2s infinite;
  margin-bottom: 8rpx;
}

.sk-line-1 { width: 90%; }
.sk-line-2 { width: 60%; }
.sk-line-3 { width: 40%; }
.sk-short { width: 30%; }

.sk-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.sk-tag, .sk-source {
  height: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--tag-bg) 25%, var(--divider) 50%, var(--tag-bg) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.2s infinite;
}

.sk-tag { width: 80rpx; }
.sk-source { width: 120rpx; }

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.state-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  text-align: center;
  padding: 0 48rpx;
}

.state-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: var(--tag-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-tertiary);
}

.state-message {
  font-size: 30rpx;
  color: var(--text-secondary);
  max-width: 500rpx;
}

.state-retry {
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background-color: var(--accent);
  color: var(--accent-text);
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

/* ========== INTEL 阶段指示器（集成在卡片区域） ========== */
.intel-indicator {
  position: absolute;
  top: calc({{menuTop}}px + {{menuHeight}}px + 24rpx + 16rpx);
  left: 50%;
  transform: translateX(-50%);
  z-index: 11;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background-color: var(--bg-card);
  box-shadow: 0 4rpx 16rpx var(--overlay);
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.intel-indicator.show {
  opacity: 1;
}

.intel-indicator .dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: var(--accent);
  animation: pulse 1.2s ease-in-out infinite;
}
.intel-indicator .dot:nth-child(2) { animation-delay: 0.2s; }
.intel-indicator .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes pulse {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* ========== 设置面板（右侧滑出） ========== */
.settings-panel {
  position: fixed;
  top: 0;
  right: 0;
  width: 75%;
  max-width: 520rpx;
  height: 100%;
  background-color: var(--bg-card);
  z-index: 30;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: -8rpx 0 32rpx var(--overlay);
}
.settings-panel.show {
  transform: translateX(0);
}

.settings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--divider);
}

.settings-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.settings-close {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-secondary);
  background-color: var(--tag-bg);
  border: none;
}
.settings-close:active {
  background-color: var(--divider);
}

.settings-content {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}

.settings-section {
  margin-bottom: 32rpx;
}

.settings-section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-tertiary);
  margin-bottom: 16rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.setting-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.setting-value {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 字体缩放滑块 */
.font-scale-slider {
  width: 300rpx;
  accent-color: var(--accent);
}

/* 开关 */
.toggle {
  position: relative;
  width: 96rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-color: var(--tag-bg);
  border: none;
  appearance: none;
  outline: none;
  transition: background-color 0.2s;
}
.toggle:checked {
  background-color: var(--accent);
}
.toggle::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: var(--bg-card);
  box-shadow: 0 2rpx 8rpx var(--overlay);
  transition: left 0.2s;
}
.toggle:checked::before {
  left: 44rpx;
}

/* ========== 分类管理弹窗 ========== */
.category-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  width: 90%;
  max-width: 600rpx;
  background-color: var(--bg-card);
  border-radius: 24rpx;
  z-index: 40;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s, transform 0.2s;
  box-shadow: 0 24rpx 64rpx var(--overlay);
}
.category-modal.show {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
  pointer-events: auto;
}

.category-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--divider);
}

.category-modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.category-modal-close {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-secondary);
  background-color: var(--tag-bg);
  border: none;
}

.category-modal-content {
  max-height: 600rpx;
  overflow-y: auto;
  padding: 16rpx 24rpx;
}

.category-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.category-row-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.category-row-toggle {
  /* 复用 .toggle 样式 */
}

/* ========== 字体缩放预览 ========== */
.font-preview {
  margin-top: 24rpx;
  padding: 24rpx;
  background-color: var(--tag-bg);
  border-radius: 16rpx;
}

.font-preview-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-tertiary);
  margin-bottom: 16rpx;
}

.font-preview-text {
  font-size: calc(28rpx * var(--font-scale, 1));
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ========== 关于页面 ========== */
.about-section {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.about-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-tertiary);
  margin-bottom: 16rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.about-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 26rpx;
}

.about-label {
  color: var(--text-secondary);
}

.about-value {
  color: var(--text-primary);
  font-weight: 500;
}

/* ========== 分类提示气泡（v1.0 §7.2） ========== */
.category-hint {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.8);
  z-index: 100;
  background-color: var(--text-primary);
  color: var(--bg-card);
  padding: 32rpx 48rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  text-align: center;
  max-width: 80%;
  box-shadow: 0 8rpx 32rpx var(--overlay);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.12s ease, transform 0.12s ease;
}

.category-hint.show {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

/* ============ 暗色模式（D-08 方案 A：删除 BUG-20260805-002 硬编码兜底块）============
   D-07 S1-S4 后变量注入已改为 app.wxss .page--dark/.page--light 显式变量块（class 注入，
   非原生 darkmode media 查询），真机变量偶发失效已解决（v13 契约 84/0+ 通过）。
   正常路径各选择器均已 var() 引用 → 兜底硬编码为纯冗余（双轨漂移风险源），删除。
   保留以下深色专用覆盖（正常路径无等价 var() 或为特殊设计值）：
   - .more-item 浮层表面色 #1C1C1E + 阴影强化（比 --bg-card 亮一档，从蒙板"浮"出） */
.page--dark .more-item {
  background-color: var(--overlay-surface);
  /* 暗色下原阴影在纯黑背景上不可见，加深一档强化悬浮感（box-shadow 豁免范畴） */
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5), 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}