/* 首页样式 - 极简暖灰配色 */

.page {
  height: 100vh;
  background-color: var(--bg-page);
  overflow: hidden;
  position: relative;
}

/* ============ 卡片舞台 ============ */
.card-stage {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.card-stage.hidden {
  opacity: 0;
  pointer-events: none;
}

.card {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
  transition: transform 0.38s cubic-bezier(0.22, 0.61, 0.36, 1);
  opacity: 0;
  pointer-events: none;
}

.card.active {
  opacity: 1;
  pointer-events: auto;
  z-index: 2;
  will-change: transform;
}

.card.above {
  opacity: 0;
  pointer-events: none;
  z-index: 1;
}

.card.below {
  opacity: 0;
  pointer-events: none;
  z-index: 1;
}

.card-body {
  flex: 1;
  padding: 80rpx 64rpx 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow-y: auto;
}

/* 卡片顶部搜索按钮 */
.card-header {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 32rpx;
  flex-shrink: 0;
}

.card-search-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  background-color: var(--tag-bg);
  pointer-events: auto;
}

.card-search-btn:active {
  opacity: 0.6;
}

.search-icon-small {
  font-size: 24rpx;
}

.search-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.card-title {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.35;
  margin-bottom: 40rpx;
  letter-spacing: -1rpx;
}

.card-summary {
  margin-bottom: 48rpx;
}

.summary-p {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
  font-size: 32rpx;
  color: var(--text-body);
  line-height: 1.9;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.5rpx;
}

.swipe-hint {
  text-align: center;
  padding: 32rpx 0 80rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  letter-spacing: 4rpx;
  font-weight: 300;
  opacity: 0.6;
}

/* ============ 导航指示点 ============ */
.nav-dots {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 10;
  padding: 20rpx 0;
}

.nav-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--text-secondary);
  opacity: 0.35;
  transition: all 0.35s ease;
}

.nav-dot.active {
  height: 48rpx;
  background-color: var(--text-primary);
  opacity: 0.8;
  border-radius: 4rpx;
}

/* ============ 侧边栏遮罩 ============ */
.panel-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--overlay);
  z-index: 29;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.panel-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

/* ============ 侧边栏面板 ============ */
.slide-panel {
  position: absolute;
  top: 0;
  right: 0;
  width: 82%;
  height: 100%;
  background-color: var(--bg-card);
  z-index: 30;
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  box-shadow: -8rpx 0 48rpx var(--overlay);
}

.slide-panel.show {
  transform: translateX(0);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 40rpx 32rpx;
  flex-shrink: 0;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.panel-header-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.panel-search {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: var(--tag-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.panel-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: var(--tag-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* ============ 分类Tab ============ */
.panel-tabs {
  display: flex;
  padding: 0 32rpx 28rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.panel-tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  background-color: transparent;
  margin-right: 12rpx;
  transition: all 0.2s;
}

.panel-tab.active {
  color: var(--text-primary);
  background-color: var(--tag-bg);
  font-weight: 600;
}

/* ============ 新闻列表 ============ */
.panel-list {
  flex: 1;
  overflow-y: auto;
}

.panel-item {
  padding: 28rpx 40rpx;
  border-bottom: 1rpx solid var(--divider);
}

.panel-item:active {
  background-color: var(--tag-bg);
}

.panel-item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.panel-empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ============ 引导遮罩 ============ */
.guide-overlay {
  position: absolute;
  bottom: 160rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: var(--text-primary);
  color: var(--bg-card);
  padding: 28rpx 48rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  z-index: 20;
  text-align: center;
  line-height: 1.7;
  animation: fadeInOut 4s ease forwards;
  pointer-events: none;
  letter-spacing: 1rpx;
}

@keyframes fadeInOut {
  0% { opacity: 0; transform: translateX(-50%) translateY(20rpx); }
  12% { opacity: 1; transform: translateX(-50%) translateY(0); }
  78% { opacity: 1; }
  100% { opacity: 0; }
}
