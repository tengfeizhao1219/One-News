/* 首页样式 - 极简暖灰配色 */

.page {
  height: 100vh;
  background-color: var(--bg-page);
  overflow: hidden;
  position: relative;
}

/* ============ 固定顶部栏（刷新左 + 设置右） ============ */
.fixed-top-bar {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;  /* UX-IMPROVE04: 确保 space-between 生效 */
  z-index: 15;
  pointer-events: none;
}

.top-bar-inner {
  display: flex;
  justify-content: space-between;
  padding: 0 40rpx;
  height: 64rpx;
  align-items: center;
}

/* S4: R 按钮已移除，以下样式废弃保留历史注释 */
/* .top-bar-refresh { ... } */
/* .refresh-icon { ... } */

.top-bar-settings {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: var(--tag-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  /* 触摸热区扩至 ≥88rpx */
  padding: 16rpx;
  margin: -16rpx;
  background-clip: content-box;
  -webkit-background-clip: content-box;
}

.top-bar-settings:active {
  opacity: 0.6;
}
.settings-icon {
  font-size: 28rpx;
  line-height: 1;
}

.refresh-icon {
  font-size: 28rpx;
}

/* ============ 卡片舞台 ============ */
.card-stage {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.card-stage.hidden {
  display: none;
}

.card {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
  opacity: 0;
  pointer-events: none;
}

/* 自动切换/回弹时启用 transition（翻书动画） */
/* transition 同时作用于 transform 和 opacity，确保流畅过渡 */
.card.with-transition {
  transition: transform 0.35s cubic-bezier(0.25, 0.1, 0.25, 1.0),
              opacity 0.35s ease;
}

.card.active {
  opacity: 1;
  pointer-events: auto;
  z-index: 2;
}

.card.above {
  opacity: 0;
  pointer-events: none;
  z-index: 1;
}

.card.below {
  opacity: 0;
  pointer-events: none;
  z-index: 1;
}

.card-body {
  flex: 1;
  padding: 120rpx 64rpx 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-title {
  font-size: calc(52rpx * var(--font-scale));
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.35;
  margin-bottom: 28rpx; /* owner 直连：与详情页 detail-title 间距对齐 */
  letter-spacing: -1rpx;
  /* 长标题/无空格长串也能正常换行，避免被页面 overflow 直接硬切 */
  word-break: break-word;
  overflow-wrap: anywhere;
  /* 限制最多 3 行，过长显示省略号，避免被页面 overflow 直接裁断 */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.card-summary {
  margin-bottom: 48rpx;
  margin-top: 28rpx;
}

.summary-p {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
  font-size: calc(32rpx * var(--font-scale));
  color: var(--text-body);
  line-height: calc(1.85 * var(--font-scale));
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  /* UX-FIX-F12（owner 2026-08-02 批准折中）：由锁死 22rpx 改为「跟涨但封顶」。
     --font-scale-meta 由 app.js 算好并封顶 1.15，故最大 25.3rpx。
     仍显著小于正文，保住「元信息视觉退后」的版式意图，同时不再完全冻结无障碍缩放。 */
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-secondary);
  margin-bottom: 20rpx; /* owner 直连：与详情页 detail-meta 间距对齐 */
  letter-spacing: 0.5rpx;
}

.swipe-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  text-align: center;
  padding: 24rpx 0 72rpx;
  font-size: 16rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  opacity: 0.45;
}

.swipe-hint-icon {
  font-size: 28rpx;
  line-height: 1;
}

.swipe-hint-text {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  font-weight: 300;
}

/* ============ 导航指示点 ============ */
.nav-dots {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 25;
  padding: 20rpx 0;
}

.nav-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--text-secondary);
  opacity: 0.35;
  transition: all 0.35s ease;
  /* UX-IMPROVE06: 扩展触摸热区到 44×44rpx，满足微信无障碍建议 */
  padding: 18rpx 18rpx;
  margin: -18rpx -18rpx;
  background-clip: content-box;
}

.nav-dot.active {
  height: 48rpx;
  background-color: var(--text-primary);
  opacity: 0.8;
  border-radius: 4rpx;
}

/* ============ 侧边栏遮罩 ============ */
.panel-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--overlay);
  z-index: 29;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.panel-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

/* ============ 侧边栏面板 ============ */
.slide-panel {
  position: absolute;
  top: 0;
  right: 0;
  width: 82%;
  height: 100%;
  background-color: var(--bg-card);
  z-index: 30;
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  box-shadow: -8rpx 0 48rpx var(--overlay);
}

.slide-panel.show {
  transform: translateX(0);
}

.panel-header {
  display: flex;
  align-items: center;
  padding: 100rpx 40rpx 32rpx;
  flex-shrink: 0;
}

.panel-title {
  font-size: calc(36rpx * var(--font-scale));
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

/* ============ 分类Tab（更醒目的高亮） ============ */
.panel-tabs {
  display: flex;
  padding: 0 32rpx 28rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.panel-tab {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 24rpx;
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 500;
  color: var(--text-secondary);
  background-color: transparent;
  margin-right: 12rpx;
  transition: all 0.25s ease;
}

.panel-tab.active {
  color: var(--bg-card);
  background-color: var(--text-primary);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

/* ============ 新闻列表 ============ */
.panel-list {
  flex: 1;
  overflow-y: auto;
}

.panel-item {
  padding: 28rpx 40rpx;
  border-bottom: 1rpx solid var(--divider);
  transition: background-color 0.2s;
}

.panel-item:active {
  background-color: var(--tag-bg);
}

/* 当前阅读的新闻高亮（UX-BUG14: 浅蓝底色 + 左侧色条，增强可辨识度） */
.panel-item.current {
  background-color: var(--flash-tech-bg);
  border-left: 4rpx solid var(--flash-tech);
  padding-left: 36rpx;
}

.panel-item-title {
  font-size: calc(32rpx * var(--font-scale));
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 当前阅读的新闻标题颜色高亮 */
.panel-item-title.current {
  color: var(--flash-tech);
  font-weight: 700;
}

.panel-empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* B-04: 收藏列表项元信息 */
.panel-item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
  font-size: calc(22rpx * var(--font-scale-meta, 1)); /* UX-FIX-F12: 与卡片元信息同口径 */
  color: var(--text-tertiary);
}

.fav-source {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 60%;
}

.fav-time {
  flex-shrink: 0;
}

/* B-04: 收藏空态 */
.panel-empty-fav {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-fav-icon {
  font-size: 80rpx;
  color: var(--text-tertiary);
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-fav-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-fav-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* ============ 骨架屏 ============ */
.skeleton-stage {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 5;
  overflow: hidden;
}

.skeleton-card {
  width: 100%;
  height: 100%;
  background-color: var(--bg-card);
  padding: 120rpx 64rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  animation: shimmer 1.6s ease-in-out infinite;
}

@keyframes shimmer {
  0% { opacity: 1; }
  50% { opacity: 0.5; }
  100% { opacity: 1; }
}

.sk-title {
  width: 80%;
  height: 56rpx;
  background: linear-gradient(90deg, var(--divider) 0%, var(--tag-bg) 50%, var(--divider) 100%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  margin-bottom: 48rpx;
  animation: skGradient 1.6s ease-in-out infinite;
}

.sk-line {
  height: 28rpx;
  background: linear-gradient(90deg, var(--divider) 0%, var(--tag-bg) 50%, var(--divider) 100%);
  background-size: 200% 100%;
  border-radius: 6rpx;
  margin-bottom: 28rpx;
  animation: skGradient 1.6s ease-in-out infinite;
}

.sk-line-1 { width: 90%; animation-delay: 0.1s; }
.sk-line-2 { width: 75%; animation-delay: 0.2s; }
.sk-line-3 { width: 85%; animation-delay: 0.3s; }
.sk-short { width: 55%; }

.sk-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.sk-tag {
  width: 80rpx;
  height: 36rpx;
  background: linear-gradient(90deg, var(--divider) 0%, var(--tag-bg) 50%, var(--divider) 100%);
  background-size: 200% 100%;
  border-radius: 16rpx;
  animation: skGradient 1.6s ease-in-out infinite;
  animation-delay: 0.4s;
}

.sk-source {
  width: 120rpx;
  height: 24rpx;
  background: linear-gradient(90deg, var(--divider) 0%, var(--tag-bg) 50%, var(--divider) 100%);
  background-size: 200% 100%;
  border-radius: 6rpx;
  animation: skGradient 1.6s ease-in-out infinite;
  animation-delay: 0.5s;
}

@keyframes skGradient {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ============ 状态页面（错误/空数据） ============ */
.state-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

.state-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.state-message {
  font-size: calc(28rpx * var(--font-scale));  /* D-05#5 */
  color: var(--text-secondary);
  margin-bottom: 40rpx;
  text-align: center;
  line-height: 1.6;
}

.state-retry {
  padding: 16rpx 48rpx;
  border-radius: 24rpx;
  font-size: calc(28rpx * var(--font-scale));  /* D-05#5 */
  font-weight: 600;
  color: var(--bg-card);
  background-color: var(--text-primary);
  letter-spacing: 1rpx;
}

.state-retry:active {
  opacity: 0.7;
}

/* UX-FIX04: 超大字号（tier 3）截断保护 — 首页卡片 */
[data-font-scale="3"] .card-title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

[data-font-scale="3"] .summary-p {
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

[data-font-scale="3"] .card-meta {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ============ BUG-20260802-005: 卡片右下角 3D 浮动设置按钮 ============ */
.floating-settings {
  position: absolute;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 26;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, var(--bg-card), var(--tag-bg));
  box-shadow:
    0 12rpx 28rpx rgba(0, 0, 0, 0.18),
    0 4rpx 8rpx rgba(0, 0, 0, 0.12),
    inset 0 1rpx 1rpx rgba(255, 255, 255, 0.6);
  animation: floatY 3.2s ease-in-out infinite;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.floating-settings.hidden {
  opacity: 0;
  pointer-events: none;
  transform: scale(0.8);
}

.floating-settings:active {
  animation: none;
  transform: scale(0.92);
  box-shadow:
    0 6rpx 16rpx rgba(0, 0, 0, 0.16),
    inset 0 1rpx 1rpx rgba(255, 255, 255, 0.5);
}

@keyframes floatY {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

/* ============ BUG-20260802-006: 分类切换 0.5s 提示 ============ */
.category-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  /* BUG-20260802-006: 必须高于 .panel-overlay(29) 与 .slide-panel(30)，
     否则在侧栏内切分类时提示被遮罩盖住 → 用户看不到 */
  z-index: 40;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background-color: var(--bg-card);
  color: var(--text-primary);
  font-size: calc(40rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 32rpx var(--overlay);
  opacity: 0;
  pointer-events: none;
  /* BUG-20260802-006: 淡入淡出缩短到 120ms，让 500ms 的展示时长真正被看见
     （原 250ms 进/出几乎吃掉整个可见窗口） */
  transition: opacity 0.12s ease, transform 0.12s ease;
}

.category-hint.show {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}
