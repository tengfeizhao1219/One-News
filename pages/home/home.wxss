/* 首页样式 - 极简暖灰配色 */

.page {
  height: 100vh;
  background-color: var(--bg-page);
  overflow: hidden;
  position: relative;
}

/* ============ 固定顶部栏（刷新左 + 搜索右） ============ */
.fixed-top-bar {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 15;
  pointer-events: none;
}

.top-bar-inner {
  display: flex;
  justify-content: space-between;
  padding: 0 40rpx;
  height: 64rpx;
  align-items: center;
}

.top-bar-refresh {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: var(--tag-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}

.top-bar-refresh:active {
  opacity: 0.6;
}

.refresh-icon {
  font-size: 28rpx;
}

.top-bar-search {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: var(--tag-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}

.top-bar-search:active {
  opacity: 0.6;
}

.search-icon-top {
  font-size: 28rpx;
}

/* ============ 卡片舞台 ============ */
.card-stage {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.card-stage.hidden {
  display: none;
}

.card {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
  opacity: 0;
  pointer-events: none;
}

/* 自动切换/回弹时启用 transition（翻书动画） */
/* transition 同时作用于 transform 和 opacity，确保流畅过渡 */
.card.with-transition {
  transition: transform 0.35s cubic-bezier(0.25, 0.1, 0.25, 1.0),
              opacity 0.35s ease;
}

.card.active {
  opacity: 1;
  pointer-events: auto;
  z-index: 2;
}

.card.above {
  opacity: 0;
  pointer-events: none;
  z-index: 1;
}

.card.below {
  opacity: 0;
  pointer-events: none;
  z-index: 1;
}

.card-body {
  flex: 1;
  padding: 120rpx 64rpx 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-title {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.35;
  margin-bottom: 40rpx;
  letter-spacing: -1rpx;
}

.card-summary {
  margin-bottom: 48rpx;
}

.summary-p {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
  font-size: 32rpx;
  color: var(--text-body);
  line-height: 1.9;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.5rpx;
}

.swipe-hint {
  text-align: center;
  padding: 32rpx 0 80rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  letter-spacing: 4rpx;
  font-weight: 300;
  opacity: 0.6;
}

/* ============ 导航指示点 ============ */
.nav-dots {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 25;
  padding: 20rpx 0;
}

.nav-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--text-secondary);
  opacity: 0.35;
  transition: all 0.35s ease;
}

.nav-dot.active {
  height: 48rpx;
  background-color: var(--text-primary);
  opacity: 0.8;
  border-radius: 4rpx;
}

/* ============ 侧边栏遮罩 ============ */
.panel-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--overlay);
  z-index: 29;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.panel-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

/* ============ 侧边栏面板 ============ */
.slide-panel {
  position: absolute;
  top: 0;
  right: 0;
  width: 82%;
  height: 100%;
  background-color: var(--bg-card);
  z-index: 30;
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  box-shadow: -8rpx 0 48rpx var(--overlay);
}

.slide-panel.show {
  transform: translateX(0);
}

.panel-header {
  display: flex;
  align-items: center;
  padding: 100rpx 40rpx 32rpx;
  flex-shrink: 0;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

/* ============ 分类Tab（更醒目的高亮） ============ */
.panel-tabs {
  display: flex;
  padding: 0 32rpx 28rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.panel-tab {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  background-color: transparent;
  margin-right: 12rpx;
  transition: all 0.25s ease;
}

.panel-tab.active {
  color: var(--bg-card);
  background-color: var(--text-primary);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

/* 暗色模式适配 */
@media (prefers-color-scheme: dark) {
  .panel-tab.active {
    color: var(--bg-page);
    background-color: var(--text-primary);
    box-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.08);
  }
}

/* ============ 新闻列表 ============ */
.panel-list {
  flex: 1;
  overflow-y: auto;
}

.panel-item {
  padding: 28rpx 40rpx;
  border-bottom: 1rpx solid var(--divider);
  transition: background-color 0.2s;
}

.panel-item:active {
  background-color: var(--tag-bg);
}

/* 当前阅读的新闻高亮 */
.panel-item.current {
  background-color: var(--tag-bg);
}

.panel-item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 当前阅读的新闻标题颜色高亮 */
.panel-item-title.current {
  color: var(--text-primary);
  font-weight: 700;
}

/* 暗色模式下保持蓝色高亮 */
@media (prefers-color-scheme: dark) {
  .panel-item-title.current {
    color: #60A5FA;
  }
}

.panel-empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ============ 引导遮罩 ============ */
.guide-overlay {
  position: absolute;
  bottom: 160rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: var(--text-primary);
  color: var(--bg-card);
  padding: 28rpx 48rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  z-index: 20;
  text-align: center;
  line-height: 1.7;
  animation: fadeInOut 4s ease forwards;
  pointer-events: none;
  letter-spacing: 1rpx;
}

@keyframes fadeInOut {
  0% { opacity: 0; transform: translateX(-50%) translateY(20rpx); }
  12% { opacity: 1; transform: translateX(-50%) translateY(0); }
  78% { opacity: 1; }
  100% { opacity: 0; }
}

/* ============ 骨架屏 ============ */
.skeleton-stage {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 5;
  overflow: hidden;
}

.skeleton-card {
  width: 100%;
  height: 100%;
  background-color: var(--bg-card);
  padding: 120rpx 64rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  animation: shimmer 1.6s ease-in-out infinite;
}

@keyframes shimmer {
  0% { opacity: 1; }
  50% { opacity: 0.5; }
  100% { opacity: 1; }
}

.sk-title {
  width: 80%;
  height: 56rpx;
  background: linear-gradient(90deg, var(--divider) 0%, var(--tag-bg) 50%, var(--divider) 100%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  margin-bottom: 48rpx;
  animation: skGradient 1.6s ease-in-out infinite;
}

.sk-line {
  height: 28rpx;
  background: linear-gradient(90deg, var(--divider) 0%, var(--tag-bg) 50%, var(--divider) 100%);
  background-size: 200% 100%;
  border-radius: 6rpx;
  margin-bottom: 28rpx;
  animation: skGradient 1.6s ease-in-out infinite;
}

.sk-line-1 { width: 90%; animation-delay: 0.1s; }
.sk-line-2 { width: 75%; animation-delay: 0.2s; }
.sk-line-3 { width: 85%; animation-delay: 0.3s; }
.sk-short { width: 55%; }

.sk-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.sk-tag {
  width: 80rpx;
  height: 36rpx;
  background: linear-gradient(90deg, var(--divider) 0%, var(--tag-bg) 50%, var(--divider) 100%);
  background-size: 200% 100%;
  border-radius: 16rpx;
  animation: skGradient 1.6s ease-in-out infinite;
  animation-delay: 0.4s;
}

.sk-source {
  width: 120rpx;
  height: 24rpx;
  background: linear-gradient(90deg, var(--divider) 0%, var(--tag-bg) 50%, var(--divider) 100%);
  background-size: 200% 100%;
  border-radius: 6rpx;
  animation: skGradient 1.6s ease-in-out infinite;
  animation-delay: 0.5s;
}

@keyframes skGradient {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ============ 状态页面（错误/空数据） ============ */
.state-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

.state-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.state-message {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
  text-align: center;
  line-height: 1.6;
}

.state-retry {
  padding: 16rpx 48rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--bg-card);
  background-color: var(--text-primary);
  letter-spacing: 1rpx;
}

.state-retry:active {
  opacity: 0.7;
}
