/* 收藏列表页样式 — TL-B13（功能骨架，视觉细节待 UI-B5 定稿） */

.page {
  height: 100vh;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
  position: relative;
}

/* UI-11: 云端合并中顶部细进度条（UI-B5 设计稿，与 history 页 sync-bar 同款） */
.sync-bar {
  height: 2rpx;
  background: var(--primary-subtle);
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  display: none;
}
.sync-bar.show {
  display: block;
}
.sync-bar::after {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 40%;
  background: var(--primary);
  animation: syncIndet 1.1s ease infinite;
}
@keyframes syncIndet {
  0% { left: -40%; }
  100% { left: 100%; }
}

/* UI-14: 同步失败轻提示条（非阻断式，点击重试） */
.sync-fail {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-warning);
  background: var(--color-warning-subtle);
  padding: 12rpx 32rpx;
  text-align: center;
  display: none;
}
.sync-fail.show {
  display: block;
}

/* ========== 导航栏（与胶囊对齐 · BUG-20260806-004） ========== */
.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 22;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-home {
  position: absolute;
  left: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.nav-home--hover {
  background-color: var(--bg-subtle);
}
.nav-home-icon-img {
  width: 44rpx;
  height: 44rpx;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.nav-count {
  position: absolute;
  right: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* UI-B10: 分类筛选胶囊 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 16rpx;
  overflow-x: auto;
  flex-shrink: 0;
}
.filter-bar::-webkit-scrollbar {
  display: none;
}
.filter-chip {
  flex-shrink: 0;
  font-size: 28rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: var(--tag-bg);
  color: var(--tag-text);
  white-space: nowrap;
  transition: all 0.15s;
}
.filter-chip.on {
  background: var(--text-primary);
  color: var(--bg-card);
}

/* UI-B10: 长按提示 */
.longpress-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  padding: 0 32rpx 16rpx;
  flex-shrink: 0;
}

/* 加载态骨架 */
.loading-wrap {
  padding: 16rpx 32rpx 40rpx;
}
.skeleton-item {
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid var(--divider, rgba(0,0,0,0.06));
  display: flex;
}
.sk-lines {
  flex: 1;
}
.sk-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: var(--tag-bg, rgba(0,0,0,0.05));
  margin-bottom: 16rpx;
  animation: skPulse 1.2s infinite;
}
.sk-line.s1 { width: 80%; }
.sk-line.s2 { width: 50%; height: 20rpx; }
@keyframes skPulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* 空态 */
.empty-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.empty-icon-img {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.4;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}
.empty-hint {
  font-size: 28rpx;
  color: var(--primary, #3a7afe);
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  background: var(--tag-bg, rgba(0,0,0,0.04));
}

/* 列表（BUG-FE-20260805-001：min-height:0 + overflow-y:auto，修复内容超一屏无法滚动，
   与 detail 页 .content 方案对齐） */
.list-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 2rpx 32rpx 40rpx;
}
.fav-item {
  position: relative; /* UI-13: 待同步角标定位锚点 */
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--divider, rgba(0,0,0,0.06));
  transition: opacity 0.2s;
}
.fav-item:active {
  background-color: rgba(0, 0, 0, 0.04);
}
.fav-title {
  font-size: 34rpx;
  color: var(--text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.fav-meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-wrap: wrap;
}
.fav-tag {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--tag-bg);
  font-size: 22rpx;
  color: var(--tag-text);
}

/* UI-13: 待同步角标（☁️ 待同步，12 号字等效 24rpx，次级色；点按重试该条上云） */
.fav-pending {
  position: absolute;
  right: 16rpx;
  bottom: 20rpx;
  font-size: 24rpx; /* UI-B5 规格「12 号字」≈ 24rpx */
  color: var(--text-secondary);
  background: var(--tag-bg);
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  line-height: 1.6;
}

/* UI-B10: 长按 ActionSheet */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: var(--overlay);
  z-index: 50;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.sheet-mask.show {
  opacity: 1;
  pointer-events: auto;
}
.action-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 12rpx 0 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 51;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}
.action-sheet.show {
  transform: translateY(0);
}
.sheet-item {
  padding: 30rpx 0;
  text-align: center;
  font-size: 32rpx;
  color: var(--text-primary);
}
.sheet-item--danger {
  color: var(--color-favorite);
}
.sheet-item--cancel {
  color: var(--text-secondary);
  border-top: 16rpx solid var(--bg-page);
  margin-top: 12rpx;
}

/* ============ 暗色模式（D-08 方案 A：删除 BUG-20260805-002 硬编码兜底块）============
   D-07 S1-S4 后变量注入已改为 app.wxss 显式变量块（class 注入），变量失效问题已解决；
   正常路径各选择器均已 var() 引用 → 兜底硬编码为纯冗余（双轨漂移风险源），删除。
   保留深色专用覆盖（D-07 走查验收功能，正常路径无等价）：
   - .fav-item:active 深色按压反馈（rgba(255,255,255,0.06)，特异性 0,2,1 > 浅色 0,1,1） */
.page--dark .fav-item:active {
  background-color: rgba(255, 255, 255, 0.06);
}
