<!-- 收藏列表页 — TL-B13 / RQ-03 · D-09 v1.2（BUG-20260806-007） -->
<view class="page {{themeClass}}" style="--nav-offset: {{navOffset}}px;">

  <!-- 顶部导航栏：主页（左）+ 标题（中）+ 计数（右）· D-09 v1.2（仅下扩展 12px，按钮锚定胶囊中心） -->
  <!-- BUG-20260806-009 v3: 状态栏不透明背景层 -->
  <view class="status-bar-fill" style="height: {{statusBarHeight}}px; background-color: var(--bg-card);"></view>
  <view class="nav-bar" style="top: {{menuTop}}px; height: calc({{menuHeight}}px + 24rpx); background-color: var(--bg-card);">
    <!-- BUG-20260806-009 follow-up: 按钮是 .nav-bar 子元素 absolute 定位，相对 nav-bar 偏移。
         正确公式：top = menuHeight/2 - 32rpx（去掉 menuTop，避免双重定位） -->
    <view class="nav-home" bindtap="goHome" hover-class="nav-home--hover" style="top: calc({{menuHeight}}px / 2 - 32rpx);">
      <!-- BUG-FS-20260805-001: 深色模式切换白色版 icon -->
      <image class="nav-home-icon-img" src="/assets/icons/home{{isDark ? '-dark' : ''}}.svg" mode="aspectFit"></image>
    </view>
    <view class="nav-title">我的收藏</view>
  </view>

  <!-- UI-11: 云端合并中顶部细进度条（DG-04 纯本地后不再触发，保留结构） -->
  <view class="sync-bar {{syncing ? 'show' : ''}}"></view>

  <!-- UI-B10: 分类筛选胶囊（无「全部」，默认展示全部）
       BUG-20260806-020 (FE): "共x条"从导航栏右上角移到分类标签右侧（filter-bar 尾部） -->
  <view class="filter-bar" wx:if="{{!loading && !isEmpty}}">
    <view
      class="filter-chip {{activeCategory === item.id ? 'on' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onFilterTap">
      {{item.name}}
    </view>
    <text class="filter-count">共 {{filteredCount}} 条</text>
  </view>

  <!-- 加载态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="skeleton-item" wx:for="{{3}}" wx:key="*this">
      <view class="sk-lines">
        <view class="sk-line s1"></view>
        <view class="sk-line s2"></view>
      </view>
    </view>
  </view>

  <!-- 空态（无收藏） -->
  <view class="empty-wrap" wx:if="{{!loading && isEmpty}}">
    <!-- BUG-FS-20260805-001: 深色模式切换白色版（image 渲染 SVG 时 currentColor 不生效→黑色） -->
    <image class="empty-icon-img" src="/assets/icons/favorite{{isDark ? '-dark' : ''}}.svg" mode="aspectFit"></image>
    <view class="empty-text">还没有收藏任何新闻</view>
    <view class="empty-hint" bindtap="goHome">去首页看看</view>
  </view>

  <!-- 空态（筛选无结果） -->
  <view class="empty-wrap" wx:if="{{!loading && !isEmpty && filteredList.length === 0}}">
    <image class="empty-icon-img" src="/assets/icons/favorite{{isDark ? '-dark' : ''}}.svg" mode="aspectFit"></image>
    <view class="empty-text">该分类下暂无收藏</view>
  </view>

  <!-- 列表（BUG-20260806-020: 长按取消 → 左滑取消，滑出右侧红色"取消收藏"按钮） -->
  <scroll-view class="list-scroll" scroll-y wx:if="{{!loading && !isEmpty}}">
    <view class="fav-item-wrapper" wx:for="{{filteredList}}" wx:key="id">
      <!-- 左滑容器：内容 + 删除按钮并排，左滑露出删除按钮。
           位移由 swipeOffsets[item.id] 驱动（rpx）；拖动中禁用 transition 防滞后 -->
      <view
        class="fav-item-swipe"
        data-id="{{item.id}}"
        data-cat="{{item.category}}"
        style="transform: translateX({{swipeOffsets[item.id] || 0}}rpx); transition: {{swipingId === item.id ? 'none' : 'transform 0.25s ease'}};"
        bindtouchstart="onSwipeStart"
        bindtouchmove="onSwipeMove"
        bindtouchend="onSwipeEnd">
        <view class="fav-item" bindtap="onItemTap" data-id="{{item.id}}" data-cat="{{item.category}}">
          <view class="fav-title">{{item.title}}</view>
          <view class="fav-meta">
            <text class="fav-tag">{{item.categoryName}}</text>
            <text wx:if="{{item.source}}">{{item.source}}</text>
            <text wx:if="{{item.source && item._time}}">·</text>
            <text>{{item._time}}</text>
          </view>
          <!-- UI-13: 待同步角标（离线收藏未上云条目，点按重试该条上云） -->
          <view class="fav-pending" wx:if="{{item._pending}}" data-id="{{item.id}}" catchtap="onPendingTap">☁️ 待同步</view>
        </view>
        <!-- 左滑露出的删除按钮 -->
        <view class="fav-delete-btn" catchtap="onDeleteItem" data-id="{{item.id}}">
          <text>取消收藏</text>
        </view>
      </view>
    </view>

    <!-- 底部品牌 splash logo -->
    <view class="brand-footer">
      <view class="brand-card">
        <logo id="fav-logo" mode="splash" fluid></logo>
      </view>
      <view class="brand-text">一页 · 简单到极致</view>
    </view>

  </scroll-view>
</view>
