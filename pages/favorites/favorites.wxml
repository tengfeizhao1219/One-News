<!-- 收藏列表页 — TL-B13 / RQ-03 -->
<view class="page {{themeClass}}">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight + 6}}px;"></view>

  <!-- 顶部栏：返回主页（左 · TL-B15）+ 标题（中）+ 计数（右） -->
  <view class="nav-bar">
    <view class="nav-home" bindtap="goHome" hover-class="nav-home--hover">
      <image class="nav-home-icon-img" src="/assets/icons/home.svg" mode="aspectFit"></image>
    </view>
    <view class="nav-title">我的收藏</view>
    <view class="nav-count" wx:if="{{!loading}}">共 {{filteredCount}} 条</view>
  </view>

  <!-- UI-11: 云端合并中顶部细进度条（UI-B5 设计稿，合并完成静默收起） -->
  <view class="sync-bar {{syncing ? 'show' : ''}}"></view>

  <!-- UI-14: 云端同步失败轻提示条（非阻断式，点击重试） -->
  <view class="sync-fail {{syncFailed ? 'show' : ''}}" bindtap="onSyncRetry">收藏同步失败，点击重试</view>

  <!-- UI-B10: 分类筛选胶囊（无「全部」，默认展示全部） -->
  <view class="filter-bar" wx:if="{{!loading && !isEmpty}}">
    <view
      class="filter-chip {{activeCategory === item.id ? 'on' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onFilterTap">
      {{item.name}}
    </view>
  </view>

  <!-- UI-B10: 长按提示 -->
  <view class="longpress-hint" wx:if="{{!loading && !isEmpty}}">提示：长按任意列表项可取消收藏</view>

  <!-- 加载态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="skeleton-item" wx:for="{{3}}" wx:key="*this">
      <view class="sk-lines">
        <view class="sk-line s1"></view>
        <view class="sk-line s2"></view>
      </view>
    </view>
  </view>

  <!-- 空态（无收藏） -->
  <view class="empty-wrap" wx:if="{{!loading && isEmpty}}">
    <!-- BUG-FS-20260805-001: 深色模式切换白色版（image 渲染 SVG 时 currentColor 不生效→黑色） -->
    <image class="empty-icon-img" src="/assets/icons/favorite{{isDark ? '-dark' : ''}}.svg" mode="aspectFit"></image>
    <view class="empty-text">还没有收藏任何新闻</view>
    <view class="empty-hint" bindtap="goHome">去首页看看</view>
  </view>

  <!-- 空态（筛选无结果） -->
  <view class="empty-wrap" wx:if="{{!loading && !isEmpty && filteredList.length === 0}}">
    <image class="empty-icon-img" src="/assets/icons/favorite{{isDark ? '-dark' : ''}}.svg" mode="aspectFit"></image>
    <view class="empty-text">该分类下暂无收藏</view>
  </view>

  <!-- 列表 -->
  <scroll-view class="list-scroll" scroll-y wx:if="{{!loading && !isEmpty}}">
    <view
      class="fav-item"
      wx:for="{{filteredList}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-cat="{{item.category}}"
      bindtap="onItemTap"
      bindlongpress="onLongPress"
      bindtouchstart="onTouchStart"
      bindtouchend="onTouchEnd">
      <view class="fav-title">{{item.title}}</view>
      <view class="fav-meta">
        <text class="fav-tag">{{item.categoryName}}</text>
        <text wx:if="{{item.source}}">{{item.source}}</text>
        <text wx:if="{{item.source && item._time}}">·</text>
        <text>{{item._time}}</text>
      </view>
      <!-- UI-13: 待同步角标（离线收藏未上云条目，点按重试该条上云） -->
      <view class="fav-pending" wx:if="{{item._pending}}" data-id="{{item.id}}" catchtap="onPendingTap">☁️ 待同步</view>
    </view>
  </scroll-view>

  <!-- UI-B10: 长按取消收藏 ActionSheet -->
  <view class="sheet-mask {{sheetVisible ? 'show' : ''}}" bindtap="onSheetCancel"></view>
  <view class="action-sheet {{sheetVisible ? 'show' : ''}}">
    <view class="sheet-item sheet-item--danger" bindtap="onConfirmUnfavorite">取消收藏</view>
    <view class="sheet-item sheet-item--cancel" bindtap="onSheetCancel">取消</view>
  </view>
</view>
