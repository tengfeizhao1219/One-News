/* 浏览记录页样式 — TL-B14 · BUG-20260806-004 */

.page {
  height: 100vh;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ========== 导航栏（与胶囊对齐） ========== */
.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 22;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* D-09 v1.2（BUG-20260806-007）: explicit 锚定胶囊中心 — top 由 wxml inline 注入 */
.nav-home {
  position: absolute;
  left: 12rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.nav-home--hover {
  background-color: var(--bg-subtle);
}
.nav-home-icon-img {
  width: 44rpx;
  height: 44rpx;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* UI-B4: 顶部同步进度条 */
.sync-bar {
  height: 2rpx;
  background: var(--primary-subtle);
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  display: none;
}
.sync-bar.show {
  display: block;
}
.sync-bar::after {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 40%;
  background: var(--primary);
  animation: syncIndet 1.1s ease infinite;
}
@keyframes syncIndet {
  0% { left: -40%; }
  100% { left: 100%; }
}

/* 加载态骨架 */
.loading-wrap {
  padding: 16rpx 32rpx 40rpx;
}
.skeleton-item {
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid var(--divider, rgba(0,0,0,0.06));
  display: flex;
}
.sk-lines {
  flex: 1;
}
.sk-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: var(--tag-bg, rgba(0,0,0,0.05));
  margin-bottom: 16rpx;
  animation: skPulse 1.2s infinite;
}
.sk-line.s1 { width: 80%; }
.sk-line.s2 { width: 50%; height: 20rpx; }
@keyframes skPulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* 空态 */
.empty-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.empty-icon-img {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.4;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}
.empty-hint {
  font-size: 28rpx;
  color: var(--primary, #3a7afe);
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  background: var(--tag-bg, rgba(0,0,0,0.04));
}

/* 列表（BUG-FE-20260805-001：min-height:0 + overflow-y:auto，修复内容超一屏无法滚动，
   与 detail 页 .content 方案对齐）
   BUG-20260806-020 (FE): 左右 padding 16rpx → 32rpx，文字不再贴屏幕边缘 */
.list-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  /* D-09 v1.2: 内容从导航栏下方 8rpx 开始 */
  padding: calc(var(--nav-offset, 0px) + 8rpx) 32rpx 40rpx;
}
.history-item {
  display: flex;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 0;  /* BUG-20260806-020: 左右 16rpx → 0（左右间距由 .list-scroll 32rpx 统一管理） */
  border-bottom: 1rpx solid var(--divider, rgba(0,0,0,0.06));
  align-items: flex-start;
  cursor: pointer;
  position: relative;
  border-radius: 8rpx;
  min-height: 88rpx;
  overflow: hidden;
}
.history-item:active {
  background-color: rgba(0, 0, 0, 0.04);
}
.history-main {
  flex: 1;
  min-width: 0;
}
.history-title {
  font-size: 34rpx;
  color: var(--text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
  margin-bottom: 8rpx;
}
.history-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ============ 暗色模式（D-08 方案 A：删除 BUG-20260805-002 硬编码兜底块）============
   D-07 S1-S4 后变量注入已改为 app.wxss 显式变量块（class 注入），变量失效问题已解决；
   正常路径各选择器均已 var() 引用 → 兜底硬编码为纯冗余（双轨漂移风险源），删除。
   保留深色专用覆盖（D-07 走查验收功能，正常路径无等价）：
   - .history-item:active 深色按压反馈（rgba(255,255,255,0.06)，特异性 0,2,1 > 浅色 0,1,1） */
.page--dark .history-item:active {
  background-color: rgba(255, 255, 255, 0.06);
}
