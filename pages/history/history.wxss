/* 浏览记录页样式 — TL-B14（功能骨架，视觉细节待 UI-B4 定稿） */

.page {
  height: 100vh;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
  position: relative;
}

.status-bar {
  flex-shrink: 0;
}

/* 顶部栏（返回主页 + 标题） */
.nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 48rpx;
  flex-shrink: 0;
}
.nav-home {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-home--hover { opacity: 0.6; }
.nav-home-icon-img {
  width: 44rpx;
  height: 44rpx;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* UI-B4: 顶部同步进度条 */
.sync-bar {
  height: 2rpx;
  background: var(--primary-subtle);
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  display: none;
}
.sync-bar.show {
  display: block;
}
.sync-bar::after {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 40%;
  background: var(--primary);
  animation: syncIndet 1.1s ease infinite;
}
@keyframes syncIndet {
  0% { left: -40%; }
  100% { left: 100%; }
}

/* 加载态骨架 */
.loading-wrap {
  padding: 16rpx 32rpx 40rpx;
}
.skeleton-item {
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid var(--divider, rgba(0,0,0,0.06));
  display: flex;
}
.sk-lines {
  flex: 1;
}
.sk-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: var(--tag-bg, rgba(0,0,0,0.05));
  margin-bottom: 16rpx;
  animation: skPulse 1.2s infinite;
}
.sk-line.s1 { width: 80%; }
.sk-line.s2 { width: 50%; height: 20rpx; }
@keyframes skPulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* 空态 */
.empty-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.empty-icon-img {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.4;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}
.empty-hint {
  font-size: 28rpx;
  color: var(--primary, #3a7afe);
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  background: var(--tag-bg, rgba(0,0,0,0.04));
}

/* 列表 */
.list-scroll {
  flex: 1;
  padding: 8rpx 16rpx 40rpx;
}
.history-item {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid var(--divider, rgba(0,0,0,0.06));
  align-items: flex-start;
  cursor: pointer;
  position: relative;
  border-radius: 8rpx;
  min-height: 88rpx;
}
.history-item:active {
  background-color: rgba(0, 0, 0, 0.04);
}
.history-main {
  flex: 1;
  min-width: 0;
}
.history-title {
  font-size: 34rpx;
  color: var(--text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 8rpx;
}
.history-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
