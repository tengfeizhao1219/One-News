<!-- 浏览记录页 — TL-B14 / RQ-06 · D-09 v1.2（BUG-20260806-007） -->
<view class="page {{themeClass}}" style="--nav-offset: {{navOffset}}px;">

  <!-- 顶部导航栏：主页（左）+ 标题（中）· D-09 v1.2（仅下扩展 12px，按钮锚定胶囊中心） -->
  <!-- BUG-20260806-009 v3: 状态栏不透明背景层 -->
  <view class="status-bar-fill" style="height: {{statusBarHeight}}px; background-color: var(--bg-card);"></view>
  <view class="nav-bar" style="top: {{menuTop}}px; height: calc({{menuHeight}}px + 24rpx); background-color: var(--bg-card);">
    <!-- BUG-20260806-009 follow-up: 按钮是 .nav-bar 子元素 absolute 定位，相对 nav-bar 偏移。
         正确公式：top = menuHeight/2 - 32rpx（去掉 menuTop，避免双重定位） -->
    <view class="nav-home" bindtap="goHome" hover-class="nav-home--hover" style="top: calc({{menuHeight}}px / 2 - 32rpx);">
      <!-- BUG-FS-20260805-001: 深色模式切换白色版 icon -->
      <image class="nav-home-icon-img" src="/assets/icons/home{{isDark ? '-dark' : ''}}.svg" mode="aspectFit"></image>
    </view>
    <view class="nav-title">浏览记录</view>
  </view>

  <!-- UI-B4: 顶部云端合并进度条（进入页面 ≤2s 自动消失） -->
  <view class="sync-bar {{syncing ? 'show' : ''}}"></view>

  <!-- 加载态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="skeleton-item" wx:for="{{4}}" wx:key="*this">
      <view class="sk-lines">
        <view class="sk-line s1"></view>
        <view class="sk-line s2"></view>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <view class="empty-wrap" wx:if="{{!loading && isEmpty}}">
    <image class="empty-icon-img" src="/assets/icons/history{{isDark ? '-dark' : ''}}.svg" mode="aspectFit"></image>
    <view class="empty-text">暂无浏览记录</view>
    <view class="empty-hint" bindtap="goHome">去首页看看</view>
  </view>

  <!-- 列表 -->
  <scroll-view class="list-scroll" scroll-y wx:if="{{!loading && !isEmpty}}">
    <view
      class="history-item"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-cat="{{item.category}}"
      bindtap="onItemTap">
      <view class="history-main">
        <view class="history-title">{{item.title}}</view>
        <view class="history-meta">
          <text>{{item.source || item.categoryName || ''}}</text>
          <text wx:if="{{(item.source || item.categoryName) && item._time}}">·</text>
          <text>{{item._time}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
