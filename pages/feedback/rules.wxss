/* 文明留言公约页 — RQ-22-FE · D-02 §3.2 · 深色 token 全部走变量，禁止硬编码 */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--bg-page);
  color: var(--text-primary);
  box-sizing: border-box;
  overflow: hidden;
}

/* ========== 导航栏（D-09） ========== */
.status-bar-fill {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 21;
}
.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 22;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back {
  position: absolute;
  left: 12rpx;
  width: 120rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
}
.nav-back--hover {
  background-color: var(--bg-subtle);
}
.nav-back-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ========== 内容区 ========== */
.rule-content {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: calc(var(--nav-offset, 0px) + 24rpx) 40rpx 40rpx;
}

/* 违规提示卡 · D-02 §3.2 */
.violation-card {
  background-color: var(--color-warning-subtle);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}
.violation-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}
.violation-reason {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-favorite);
  margin-bottom: 8rpx;
}
.violation-tip {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

/* 公约标题 · D-02 §3.2（36rpx/700，分组标题同 settings group-label） */
.rule-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

/* 公约条目（编号圆点 primary + 28rpx/1.7 --text-body） */
.rule-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.rule-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.rule-num {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background-color: var(--primary);
  color: #ffffff;
  font-size: 24rpx;
  margin-top: 4rpx;
}
.rule-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-body);
}

/* 返回留言板按钮 · D-02 §3.2（宽度适配内容 + 居中，"底部 padding 40rpx"实为按钮下方间距） */
.rule-back-btn {
  display: table;
  margin: 48rpx auto 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 80rpx;
  border-radius: 44rpx;
  background-color: var(--primary);
  color: #ffffff;
  font-size: 30rpx;
}
