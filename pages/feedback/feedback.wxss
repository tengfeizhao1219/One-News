/* 意见反馈留言板 — RQ-22-FE · D-02 增量 RQ-22 设计规范 v1.0 */
/* 深色双套 token 全部走 CSS 变量（--bg-* / --text-* / --primary / --color-favorite / --divider），禁止硬编码 */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--bg-page);
  color: var(--text-primary);
  box-sizing: border-box;
  overflow: hidden;
}

/* ========== 导航栏（D-09，与 settings/favorites 一致） ========== */
.status-bar-fill {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 21;
}
.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 22;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-home {
  position: absolute;
  left: 12rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.nav-home--hover {
  background-color: var(--bg-subtle);
}
.nav-home-icon-img {
  width: 44rpx;
  height: 44rpx;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}
/* 筛选入口（仅作者）：标题右侧「筛选 ▾」· D-02 §3.1 */
.nav-filter {
  position: absolute;
  right: 24rpx;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
}
.nav-filter-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ========== 管理计数条（仅作者）· D-02 §3.1 ========== */
.manage-bar {
  padding: calc(var(--nav-offset, 0px) + 8rpx) 32rpx 8rpx;
  flex-shrink: 0;
}
.manage-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ========== 筛选下拉（仅作者）· D-02 §4 ========== */
.filter-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
}
.filter-dropdown {
  position: fixed;
  top: calc(var(--nav-offset, 0px) + 8rpx);
  right: 24rpx;
  z-index: 31;
  min-width: 220rpx;
  background-color: var(--bg-card);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
}
.filter-option {
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}
.filter-option.on {
  color: var(--primary);
  font-weight: 600;
}

/* ========== 加载骨架（D-02 §5） ========== */
.loading-wrap {
  padding: calc(var(--nav-offset, 0px) + 8rpx) 32rpx 40rpx;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}
.skeleton-card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.sk-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.sk-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: var(--tag-bg);
  animation: skPulse 1.2s infinite;
}
.sk-line.s1 { width: 40%; }
.sk-line.s2 { width: 25%; height: 20rpx; }
.sk-line.s3 { width: 90%; margin-bottom: 12rpx; }
.sk-line.s4 { width: 70%; }
@keyframes skPulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* ========== 空态（D-02 §5） ========== */
.empty-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 200rpx;
}
.empty-icon {
  font-size: 88rpx;
  opacity: 0.4;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}
.empty-hint {
  font-size: 28rpx;
  color: var(--primary);
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  background: var(--tag-bg);
}

/* ========== 留言列表（卡片式 · D-02 §2/§3.1） ========== */
.feedback-scroll-wrap {
  flex: 1;
  min-height: 0;
  position: relative;
}
.feedback-scroll {
  height: 100%;
}
.feedback-list {
  padding: 16rpx 32rpx 220rpx; /* 底部预留输入区高度 */
}
.msg-card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.msg-card.deleted {
  opacity: 0.5;
}
.msg-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.msg-nick {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.msg-nick-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.author-badge {
  font-size: 22rpx;
  /* 主题色底固定白字（D-02 §6 角标规定，--primary 浅 #007AFF / 深 #0A84FF 下白字均清晰） */
  color: #ffffff;
  background-color: var(--primary);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.msg-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}
.msg-content {
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--text-primary);
  word-break: break-all;
  white-space: pre-wrap;
}
/* 删除（仅作者，卡片右下角）· D-02 §3.1 */
.msg-delete {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-favorite);
  padding: 8rpx 0 0 24rpx;
}

/* ========== 回复区（楼中楼 · D-02 §3.1） ========== */
.reply-area {
  margin-top: 16rpx;
  background-color: var(--bg-subtle);
  border-radius: 16rpx;
  padding: 16rpx;
}
.reply-item {
  padding-top: 12rpx;
  padding-bottom: 12rpx;
}
.reply-item.deleted {
  opacity: 0.5;
}
.reply-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}
.reply-nick {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
}
.reply-time {
  font-size: 20rpx;
  color: var(--text-tertiary);
}
.reply-content {
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--text-primary);
  word-break: break-all;
  white-space: pre-wrap;
}
.reply-delete {
  margin-top: 4rpx;
  justify-content: flex-start;
  padding: 4rpx 0 0;
}
/* 回复输入框（展开） */
.reply-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}
.reply-input {
  flex: 1;
  min-height: 64rpx;
  background-color: var(--tag-bg);
  border-radius: 16rpx;
  padding: 8rpx 20rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}
.reply-send {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #ffffff;
  background-color: var(--primary);
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
}
/* 回复切换按钮 */
.reply-toggle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ========== 底部固定输入区 · D-02 §3.1 ========== */
.bottom-input-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background-color: var(--bg-card);
  border-top: 1rpx solid var(--divider);
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.cooldown-hint {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}
.bottom-input-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.bottom-input {
  flex: 1;
  min-height: 72rpx;
  max-height: 200rpx;
  background-color: var(--tag-bg);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}
.send-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  border-radius: 36rpx;
  background-color: var(--primary);
  color: #ffffff;
  font-size: 30rpx;
  text-align: center;
}
.send-btn.disabled {
  opacity: 0.4;
}
