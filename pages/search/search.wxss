/* 搜索页样式 */

.page {
  height: 100vh;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
}

/* ============ 搜索栏 ============ */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx 24rpx;
  gap: 20rpx;
  flex-shrink: 0;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: var(--tag-bg);
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}

.search-placeholder {
  color: var(--text-secondary);
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: var(--text-secondary);
  color: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  opacity: 0.5;
}

.search-cancel {
  font-size: 30rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

/* ============ 结果列表 ============ */
.result-list {
  flex: 1;
  overflow-y: auto;
}

.result-item {
  padding: 28rpx 48rpx;
  border-bottom: 1rpx solid var(--divider);
}

.result-item:active {
  background-color: var(--tag-bg);
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.45;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.result-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.category-tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
  font-weight: 500;
  background-color: var(--tag-bg);
  color: var(--tag-text);
}

.result-empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ============ 初始状态 ============ */
.init-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.init-text {
  font-size: 30rpx;
  color: var(--text-secondary);
}
