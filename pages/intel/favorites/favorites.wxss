/* INTEL-MODULE: AI 情报官 · 我的收藏（复用 intel-home 卡片流 + intel-mine 导航样式） */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
}

.status-bar-fill { flex-shrink: 0; }

/* 导航（对齐 intel-detail .nav） */
.nav {
  position: relative;
  height: var(--menu-height, 32px);
  margin-top: var(--menu-top, 44px);
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 32rpx;
}
.nav-home {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  margin-left: -8rpx;
  flex-shrink: 0;
  z-index: 20;
  color: var(--text-primary);
}
.nav-home--hover { background-color: var(--bg-subtle); }
.nav-home-icon-img { width: 44rpx; height: 44rpx; }
.nav-title {
  font-size: calc(32rpx * var(--font-scale));
  font-weight: 600;
  color: var(--text-primary);
}
.nav-dark { display: none; }
.page--dark .nav-light { display: none; }
.page--dark .nav-dark { display: block; }

.content {
  flex: 1;
  height: 0;
  /* 2026-08-24: scroll-view 的 padding-right 对内容可能失效(右贴边)→ 去水平 padding,改用卡片左右 margin */
  padding: 24rpx 0 0;
  background-color: var(--bg-page);
  overflow-x: hidden;
}

/* 卡片（对齐 intel-home .card） */
.card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--divider);
  border-radius: 32rpx;
  padding: 28rpx;
  /* 2026-08-24: 左右各留 32rpx → 卡片左右对称、完整(不再右贴屏幕边) */
  margin: 0 32rpx 24rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.card-main { flex: 1; min-width: 0; overflow: hidden; }
.card-title {
  display: block;
  font-size: calc(30rpx * var(--font-scale));
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
  word-break: break-word;       /* 2026-08-24: 长英文标题换行，防溢出卡片右侧 */
  overflow-wrap: anywhere;
}
.card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}
.meta-src { color: var(--primary); font-size: calc(22rpx * var(--font-scale-meta, 1)); }
.meta-time { color: var(--text-tertiary); font-size: calc(22rpx * var(--font-scale-meta, 1)); }
.card-desc {
  display: block;
  font-size: calc(26rpx * var(--font-scale));
  color: var(--text-tertiary);
  line-height: 1.6;
  margin-top: 12rpx;
  word-break: break-word;     /* 2026-08-24: 摘要长文本换行 */
  overflow-wrap: anywhere;
}

/* 2026-08-24：红心取消收藏按钮已移除（owner 拍板——本页即已收藏列表，无需逐个提醒） */

/* 状态提示（对齐 intel-home .state-hint） */
.state-hint {
  padding: 120rpx 32rpx 0;
  text-align: center;
}
.state-t {
  display: block;
  font-size: calc(30rpx * var(--font-scale));
  font-weight: 600;
  color: var(--text-primary);
}
.state-s {
  display: block;
  font-size: calc(24rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
  margin-top: 16rpx;
  line-height: 1.6;
}

.foot-note {
  text-align: center;
  font-size: calc(20rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
  padding: 32rpx 0 calc(48rpx + var(--safe-bottom, 0px));
}
