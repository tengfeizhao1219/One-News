<!--
  INTEL-MODULE: AI 情报官模块 · 情报首页（UI 重构 v6 落地：卡片流 · 轻高亮 · 少图标）
  变更要点：去"今日关注"标题；卡片去掉来源/时间（挪详情页）；rank 1 重点卡带"对你最重要"tag + 浅蓝底"对你"行；FAB 未动。
-->
<view class="page {{themeClass}} intel-home" style="--menu-top: {{topBarH}}px; --menu-height: {{menuHeight}}px; --page-h: {{pageH}}px; --safe-bottom: {{safeBottom}}px; --font-scale: {{_fontScaleValue}}; --font-scale-meta: {{_metaScaleValue}};" bindtouchstart="onSlideTouchStart" bindtouchend="onSlideTouchEnd">

  <!-- 状态栏背景层（对齐胶囊顶部 menuTop，与 One News 首页一致） -->
  <view class="status-bar-fill" style="height: {{topBarH}}px; background-color: var(--bg-page);"></view>

  <!-- 自定义导航：‹ 返回 / 标题 -->
  <view class="nav">
    <text class="nav-back" bindtap="goBack">‹</text>
    <text class="nav-title">AI 情报</text>
  </view>

  <!-- 摘要：重点前置（今日条数 + 数据截至/源健康） -->
  <view class="hero">
    <view class="hero-count">今日 <text class="hero-num">{{items.length}}</text> 条值得关注</view>
    <view class="hero-sub" wx:if="{{meta.dataAsOf || meta.healthTitle}}">
      <text wx:if="{{meta.dataAsOf}}">{{meta.dataAsOf}}</text>
      <text class="hero-warn" wx:if="{{meta.healthTitle}}"> · {{meta.healthTitle}}</text>
    </view>
  </view>

  <scroll-view class="content" scroll-y show-scrollbar="{{false}}">
    <!-- 加载态 -->
    <block wx:if="{{meta.loading}}">
      <view class="state-hint"><text class="state-t">情报官正在梳理中…</text><text class="state-s">通常在 5 分钟内完成</text></view>
    </block>

    <!-- 空态 -->
    <block wx:elif="{{meta.empty || meta.placeholder}}">
      <view class="state-hint"><text class="state-t">{{meta.placeholder ? '今日暂无可靠更新' : '本期暂无内容'}}</text><text class="state-s">情报官继续盯盘中 · 稍后再来看看</text></view>
    </block>

    <!-- 卡片流 -->
    <block wx:else>
      <view class="card {{item.contract ? 'card-contract' : ''}} {{index === 0 ? 'card-focus' : ''}}" wx:for="{{items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <!-- 重点卡（首条）：对你最重要 tag + 浅蓝底对你行 -->
        <text class="focus-tag" wx:if="{{item.focus}}">对你最重要</text>
        <text class="card-title">{{item.title}}</text>
        <view class="card-for" wx:if="{{item.focus && (item.focusFor || item.desc)}}">
          <text class="for-k">对你：</text><text>{{item.focusFor || item.desc}}</text>
        </view>
        <text class="card-desc" wx:if="{{!item.focus && item.desc}}">{{item.desc}}</text>
      </view>
    </block>

    <!-- 本周可试用清单 -->
    <block wx:if="{{tryable.length}}">
      <view class="sect-head">本周可试用清单</view>
      <view class="card card-try" wx:for="{{tryable}}" wx:key="id" bindtap="toggleTryable" data-id="{{item.id}}">
        <view class="try-check {{item.done ? 'on' : ''}}"></view>
        <view class="try-body">
          <text class="try-title {{item.done ? 'done' : ''}}">{{item.title}}</text>
          <text class="try-min" wx:if="{{item.minAction}}">{{item.minAction}}</text>
        </view>
      </view>
    </block>

    <view class="foot-note">由 AI 情报官生成 · 仅供参考</view>
  </scroll-view>

  <!-- 悬浮按钮：完全复刻 One News 首页 .floating-more，作为「我的」入口（未动） -->
  <view class="floating-more" bindtap="goMine">
    <image class="more-icon-img more-light" src="/assets/icons/settings.svg" mode="aspectFit"></image>
    <image class="more-icon-img more-dark" src="/assets/icons/settings-dark.svg" mode="aspectFit"></image>
  </view>
</view>
