/* INTEL-MODULE: AI 情报官 · 情报详情样式（UI 重构 v6）。设计令牌全部引用 theme.json，零新增 hex。 */
.intel-detail {
  height: 100vh;
  background-color: var(--bg-page);
}
.page--dark .intel-detail { background-color: #000000; } /* 暗色兜底 */
.intel-detail {
  display: flex;
  flex-direction: column;
  position: relative;
}
.status-bar-fill {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  z-index: 16;
}
.nav {
  /* 与原生胶囊垂直居中对齐：容器 top=胶囊顶(menu-top)、height=胶囊高(menu-height)、内部 flex 居中（对齐 One News panel-header 做法） */
  position: relative;
  height: var(--menu-height, 32px);
  margin-top: var(--menu-top, 44px);
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 32rpx;
}

.nav-home {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  margin-left: -8rpx;
  flex-shrink: 0;
}
.nav-home--hover { background-color: var(--bg-subtle); }
.nav-home-icon-img { width: 44rpx; height: 44rpx; }
.nav-title { font-size: calc(32rpx * var(--font-scale)); font-weight: 600; color: var(--text-primary); }

.content {
  background-color: #F5F3F0;
  flex: 1;
  height: 0;
  /* owner 2026-08-19：标题与顶部导航保留呼吸空间（16rpx → 44rpx） */
  padding: 44rpx 32rpx calc(16rpx + var(--safe-bottom, 0px));
  box-sizing: border-box;
  overflow-y: auto;
}
.page--dark .content { background-color: #000000; }

/* 结论式标题 + 来源 */
.detail-title {
  display: block;
  font-size: calc(40rpx * var(--font-scale));
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.5;
}
.meta {
  margin-top: 16rpx;
  font-size: calc(24rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
}
.meta-src { color: var(--text-link); }

/* 区块标题（系统蓝）*/
.block-label {
  display: block;
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 700;
  color: var(--primary);
  margin: 40rpx 4rpx 16rpx;
}

/* 正文（发生了什么 / 可以怎么做 / 最小行动）*/
.prose {
  font-size: calc(26rpx * var(--font-scale));
  color: var(--text-body);
  line-height: 1.75;
  margin-bottom: 8rpx;
}
.prose-2 { margin-top: 4rpx; }

/* 落到你这里：浅蓝底卡 */
.for-card {
  background: var(--highlight-bg);
  border-radius: 24rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 16rpx;
}
.for-k {
  display: block;
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 8rpx;
}
.for-body {
  font-size: calc(26rpx * var(--font-scale));
  color: var(--text-body);
  line-height: 1.7;
}
.relate-skip {
  font-size: calc(24rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
  margin: 8rpx 4rpx;
}

/* 了解更多 */
.expand {
  background: var(--bg-card);
  border: 1rpx solid var(--divider);
  border-radius: 24rpx;
  margin-top: 24rpx;
  overflow: hidden;
}
.expand-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 600;
  color: var(--text-primary);
}
.chev { color: var(--text-tertiary); font-size: calc(24rpx * var(--font-scale-meta, 1)); }
.expand-body { padding: 0 28rpx 24rpx; }
.src-link { padding: 8rpx 0; }
.src-txt {
  font-size: calc(24rpx * var(--font-scale-meta, 1));
  color: var(--text-link);
  word-break: break-all;
  line-height: 1.6;
}

/* 分隔线 */
.divider { height: 1rpx; background: var(--divider); margin: 32rpx 4rpx; }

/* 状态占位 */
.state-hint {
  padding: 120rpx 0;
  text-align: center;
}
.state-t {
  display: block;
  font-size: calc(30rpx * var(--font-scale));
  font-weight: 600;
  color: var(--text-secondary);
}
.state-s {
  display: block;
  font-size: calc(24rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
  margin-top: 14rpx;
}

.foot-note {
  text-align: center;
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
  margin: 32rpx 0 calc(16rpx + var(--safe-bottom, 0px));
}

/* UI 重构：试试看 —— 引导式语气容器（owner 2026-08-19：轻松推荐，非命令式步骤） */
.try-guide {
  font-size: calc(28rpx * var(--font-scale));
  color: var(--text-body);
  line-height: 1.8;
  background: var(--bg-subtle);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}
