/* INTEL-MODULE: AI 情报官 · 情报详情样式。设计令牌全部引用 theme.json，零新增 hex。 */
.intel-detail {
  min-height: 100vh;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
}
.status-bar { width: 100%; }

.nav {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 32rpx 16rpx;
}
.nav-back { font-size: 44rpx; color: var(--primary); line-height: 1; }
.nav-title { font-size: 34rpx; font-weight: 700; color: var(--text-primary); }
.src-chip {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--bg-subtle);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.content {
  flex: 1;
  padding: 8rpx 32rpx calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 状态条：降噪 */
.status-strip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg-subtle);
  color: var(--text-secondary);
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}
.status-strip .dot-g { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--flash-life); }

.detail-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.4;
  margin: 4rpx 2rpx 20rpx;
}

.block-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 0.5rpx;
  margin: 0 0 16rpx;
}

/* 正文：13px(≈26rpx) / 1.6，与「落到你这里」一致 */
.prose {
  font-size: 26rpx;
  color: var(--text-body);
  line-height: 1.6;
}
.prose-2 { margin-top: 20rpx; }

/* 高亮：淡浅蓝底 + 柔和灰字，不重、不抢眼 */
.hl {
  background: rgba(0, 122, 255, 0.07);
  color: var(--text-body);
  font-weight: 500;
  padding: 0 6rpx;
  border-radius: 8rpx;
}

.divider { height: 1rpx; background: var(--divider); margin: 32rpx 0; }

/* 落到你这里 */
.relate { display: flex; flex-direction: column; gap: 24rpx; }
.relate-item {
  background: var(--bg-card);
  border: 1rpx solid var(--divider);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
}
.who { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.who-ic {
  width: 32rpx; height: 32rpx; border-radius: 10rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; font-weight: 700; color: var(--primary); background: transparent;
}
.who-txt { font-size: 24rpx; font-weight: 600; color: var(--text-secondary); }
.relate-txt { font-size: 26rpx; color: var(--text-body); line-height: 1.6; }
.relate-skip { font-size: 26rpx; color: var(--text-tertiary); line-height: 1.6; font-style: italic; }

/* 可展开区 */
.expand {
  background: var(--bg-card);
  border: 1rpx solid var(--divider);
  border-radius: 28rpx;
  margin-top: 24rpx;
  overflow: hidden;
}
.expand-head {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  padding: 26rpx 28rpx;
}
.expand-head .chev { margin-left: auto; font-size: 26rpx; color: var(--text-tertiary); transition: transform 0.2s; }
.expand.open .expand-head .chev { transform: rotate(90deg); }
.expand-body { padding: 0 28rpx 28rpx; }

/* 了解更多：来源链接（点击复制） */
.src-link {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg-subtle);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.src-ico { font-size: 28rpx; }
.src-txt { flex: 1; font-size: 26rpx; color: var(--text-link); }
.src-arr { color: var(--text-tertiary); opacity: 0.6; }

/* 上手试试：步骤 */
.steps { display: flex; flex-direction: column; }
.step { display: flex; gap: 20rpx; padding: 20rpx 0; position: relative; }
.step:not(:last-child)::before {
  content: ""; position: absolute; left: 22rpx; top: 56rpx; bottom: 0;
  width: 2rpx; background: var(--divider);
}
.step-n {
  flex: 0 0 44rpx; height: 44rpx; border-radius: 50%;
  background: var(--primary); color: #fff;
  font-size: 24rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; z-index: 1;
}
.step-c { flex: 1; }
.step-t { font-size: 28rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 6rpx; }
.step-d { font-size: 26rpx; color: var(--text-body); line-height: 1.55; }
.code {
  background: var(--bg-subtle);
  border-radius: 10rpx;
  padding: 2rpx 10rpx;
  font-size: 24rpx;
  color: var(--text-primary);
}

.risk {
  margin-top: 24rpx;
  background: var(--color-warning-subtle);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-warning);
  line-height: 1.55;
}

.ref-links { margin-top: 24rpx; display: flex; flex-direction: column; gap: 14rpx; }
.ref-lab { font-size: 24rpx; font-weight: 700; color: var(--text-secondary); }
.ref-link { font-size: 24rpx; color: var(--text-link); line-height: 1.5; word-break: break-all; }

.foot-note {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin: 32rpx 0;
}
