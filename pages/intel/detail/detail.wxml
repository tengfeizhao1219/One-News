<!--
  INTEL-MODULE: AI 情报官模块 · 情报详情（UI 重构 v6 落地）
  变更要点：去顶部状态条；来源在标题下方展示；"落到你这里"浅蓝底卡；了解更多保持可展开。
  数据结构不变（title/srcName/whatHappenedParagraphs/descText/relateItems/practiceText/minActionText/hasMore/sourceUrl）；标签"最小行动"→"想试试"→"试试看"（owner 2026-08-19 拍板：轻松引导语气，非命令式）。
-->
<view class="page {{themeClass}} intel-detail" style="--menu-top: {{topBarH}}px; --menu-height: {{menuHeight}}px; --safe-bottom: {{safeBottom}}px; --font-scale: {{_fontScaleValue}}; --font-scale-meta: {{_metaScaleValue}};">
  <!-- 顶部条带（对齐原生胶囊） -->
  <view class="status-bar-fill" style="height: {{topBarH}}px; background-color: var(--bg-page);"></view>

  <!-- 导航 -->
  <view class="nav">
    <view class="nav-home" bindtap="goBack" hover-class="nav-home--hover">
      <image class="nav-home-icon-img nav-light" src="/assets/icons/home.svg" mode="aspectFit"></image>
      <image class="nav-home-icon-img nav-dark" src="/assets/icons/home-dark.svg" mode="aspectFit"></image>
    </view>
    <!-- 收藏（2026-08-20：纯本地，对齐 One News ♡/♥ 双态；空态/加载态隐藏） -->
    <view wx:if="{{!loading && !empty}}" class="nav-fav {{heartAnim ? 'heart-anim' : ''}}" bindtap="onToggleFavorite" hover-class="nav-fav--hover">
      <image wx:if="{{!isFavorited}}" class="nav-fav-icon-img nav-light" src="/assets/icons/favorite.svg" mode="aspectFit"></image>
      <image wx:if="{{!isFavorited}}" class="nav-fav-icon-img nav-dark" src="/assets/icons/favorite-dark.svg" mode="aspectFit"></image>
      <image wx:if="{{isFavorited}}" class="nav-fav-icon-img" src="/assets/icons/favorite-fill.svg" mode="aspectFit"></image>
    </view>
  </view>

  <!-- 2026-08-20: scroll-view 改普通 view 滚动（隐藏滚动条最可靠；show-scrollbar=false 在部分基础库仍显示） -->
  <view class="content">

    <!-- 加载态 -->
    <block wx:if="{{loading}}">
      <view class="state-hint"><text class="state-t">情报官正在梳理详情…</text></view>
    </block>

    <!-- 空态 -->
    <block wx:elif="{{empty}}">
      <view class="state-hint"><text class="state-t">这条情报的详情尚未生成</text><text class="state-s">稍后再来看看</text></view>
    </block>

    <!-- 真实数据 -->
    <block wx:else>
      <!-- 结论式标题 + 来源（时间字段后端补上后自动展示） -->
      <text class="detail-title">{{title}}</text>
      <view class="meta" wx:if="{{srcName || pubTime}}">
        <text class="meta-src" wx:if="{{srcName}}">{{srcName}}</text>
        <text wx:if="{{pubTime}}">{{pubTime}}</text>
      </view>

      <!-- 发生了什么（2026-08-20 v5.1：结构化块——正文自然段落 + 大白话/AI预测/定义整段浅灰底；AI 预测标识放段尾） -->
      <text class="block-label">发生了什么</text>
      <block wx:if="{{whatHappenedBlocks.length}}">
        <block wx:for="{{whatHappenedBlocks}}" wx:key="index" wx:for-item="blk">
          <!-- 正文段落（默认） -->
          <view wx:if="{{blk.type === 'text'}}" class="prose {{index ? 'prose-2' : ''}}">{{blk.text}}</view>
          <!-- 解读/预测/定义：整段浅灰底圆角块 -->
          <view wx:elif="{{blk.text}}" class="wh-panel wh-panel-{{blk.type}}">
            <text class="wh-panel-body">{{blk.text}}</text>
            <!-- AI 预测标识：段尾小字（不明显） -->
            <text wx:if="{{blk.type === 'predict'}}" class="wh-panel-tag">AI 预测</text>
          </view>
        </block>
      </block>
      <block wx:elif="{{whatHappenedParagraphs.length}}">
        <view class="prose {{index ? 'prose-2' : ''}}" wx:for="{{whatHappenedParagraphs}}" wx:key="index">{{item}}</view>
      </block>
      <view class="prose" wx:else>{{descText}}</view>

      <view class="divider" wx:if="{{relateItems.length}}"></view>

      <!-- 落到你这里（浅蓝底卡） -->
      <block wx:if="{{relateItems.length}}">
        <text class="block-label">落到你这里</text>
        <view class="for-card" wx:for="{{relateItems}}" wx:key="who">
          <text class="for-k">{{item.who}}</text>
          <view class="for-body">
            <view class="for-line" wx:for="{{item.lines}}" wx:key="index">
              <text wx:for="{{item.segments}}" wx:for-item="seg" wx:for-index="segIdx" wx:key="segIdx" class="{{seg.bold ? 'for-bold' : ''}}">{{seg.text}}</text>
            </view>
          </view>
        </view>
        <view class="relate-skip" wx:if="{{relateSkip}}">{{relateSkip}}</view>
      </block>

      <!-- 可以怎么做 -->
      <view class="divider" wx:if="{{practiceText}}"></view>
      <block wx:if="{{practiceText}}">
        <text class="block-label">可以怎么做</text>
        <view class="prose">{{practiceText}}</view>
      </block>

      <!-- 试试看（owner 2026-08-19：最小行动 → 试试看，轻松引导语气推荐；文案引导风格由后端 SOP 生成，见 COMMLOG） -->
      <block wx:if="{{minActionText}}">
        <view class="divider"></view>
        <text class="block-label">试试看</text>
        <view class="try-guide">{{minActionText}}</view>
      </block>

      <!-- 了解更多 ▸（有真实来源时才展示） -->
      <block wx:if="{{hasMore}}">
        <view class="expand {{showMore ? 'open' : ''}}">
          <view class="expand-head" bindtap="toggleMore"><text>了解更多</text><text class="chev">{{showMore ? '▾' : '▸'}}</text></view>
          <view class="expand-body" wx:if="{{showMore}}">
            <view class="src-link" wx:if="{{sourceUrl}}" bindtap="copyLink" data-url="{{sourceUrl}}">
              <text class="src-txt">{{sourceUrl}}</text>
            </view>
          </view>
        </view>
      </block>
    </block>

    <view class="foot-note">由 AI 情报官生成 · 内容基于公开信息整理，仅供参考</view>
  </view>
</view>
