<!--
  INTEL-MODULE: AI 情报官模块 · 情报详情（2026-08-21 恢复 v0.4.3 demo 叙事结构）
  结构（对齐 AI情报官_UI规范_v1.md §3）：
    状态条(🟢 已完成梳理) → 结论式标题+来源 → 发生了什么 → 落到你这里 → 了解更多▸(fold) → 试试看▸(fold)
  注：2026-08-21 移除「可以怎么做」独立区块（demo 无此区块；实操并入试试看 fold）；
      状态条 8-21 恢复（v6 重构时删过，owner 拍板完整对齐 demo）。
-->
<view class="page {{themeClass}} intel-detail" style="--menu-top: {{topBarH}}px; --menu-height: {{menuHeight}}px; --safe-bottom: {{safeBottom}}px; --font-scale: {{_fontScaleValue}}; --font-scale-meta: {{_metaScaleValue}};">
  <!-- 顶部条带（对齐原生胶囊） -->
  <view class="status-bar-fill" style="height: {{topBarH}}px; background-color: var(--bg-page);"></view>

  <!-- 导航 -->
  <view class="nav">
    <view class="nav-home" bindtap="goBack" hover-class="nav-home--hover">
      <image class="nav-home-icon-img nav-light" src="/assets/icons/home.svg" mode="aspectFit"></image>
      <image class="nav-home-icon-img nav-dark" src="/assets/icons/home-dark.svg" mode="aspectFit"></image>
    </view>
  </view>

  <view class="content">

    <!-- 加载态 -->
    <block wx:if="{{loading}}">
      <view class="state-hint"><text class="state-t">情报官正在梳理详情…</text></view>
    </block>

    <!-- 空态 -->
    <block wx:elif="{{empty}}">
      <view class="state-hint"><text class="state-t">这条情报的详情尚未生成</text><text class="state-s">稍后再来看看</text></view>
    </block>

    <!-- 真实数据 -->
    <block wx:else>
      <!-- 2026-08-21 问题②：状态条已按要求去掉（用户明确不需要「情报官已完成梳理」提示条） -->

      <!-- 结论式标题 + 来源/时间 -->
      <text class="detail-title">{{title}}</text>
      <view class="meta">
        <text class="meta-src" wx:if="{{srcName}}">{{srcName}}</text>
        <text class="meta-time" wx:if="{{pubTime}}">{{pubTime}}</text>
        <!-- 收藏入口 -->
        <view class="meta-fav {{heartAnim ? 'heart-anim' : ''}}" catchtap="onToggleFavorite" hover-class="meta-fav--hover">
          <image wx:if="{{!isFavorited}}" class="meta-fav-icon nav-light" src="/assets/icons/favorite.svg" mode="aspectFit"></image>
          <image wx:if="{{!isFavorited}}" class="meta-fav-icon nav-dark" src="/assets/icons/favorite-dark.svg" mode="aspectFit"></image>
          <image wx:if="{{isFavorited}}" class="meta-fav-icon" src="/assets/icons/favorite-fill.svg" mode="aspectFit"></image>
          <text class="meta-fav-label {{isFavorited ? 'is-favorited' : ''}}">{{isFavorited ? '已收藏' : '收藏'}}</text>
        </view>
      </view>

      <!-- 发生了什么（2026-08-21 问题③⑥：正文自然段落；仅 AI 预测用浅灰底块+段尾 UI 提示，
           大白话/定义归为普通正文段（不显示标签文字）） -->
      <text class="block-label">发生了什么</text>
      <block wx:if="{{whatHappenedBlocks.length}}">
        <block wx:for="{{whatHappenedBlocks}}" wx:key="index" wx:for-item="blk">
          <!-- 普通正文段（text / plain / def 都按自然段落渲染，不显示标记文字） -->
          <view wx:if="{{blk.type !== 'predict'}}" class="prose {{index ? 'prose-2' : ''}}">{{blk.text}}</view>
          <!-- AI 预测：浅灰底块 + 段尾小字「AI 预测」（UI 提示，非正文文字） -->
          <view wx:elif="{{blk.text}}" class="wh-panel">
            <text class="wh-panel-body">{{blk.text}}</text>
            <text class="wh-panel-tag">AI 预测</text>
          </view>
        </block>
      </block>
      <block wx:elif="{{whatHappenedParagraphs.length}}">
        <view class="prose {{index ? 'prose-2' : ''}}" wx:for="{{whatHappenedParagraphs}}" wx:key="index">{{item}}</view>
      </block>
      <view class="prose" wx:else>{{descText}}</view>

      <!-- 落到你这里（浅蓝底卡，命中身份才显示） -->
      <block wx:if="{{relateItems.length}}">
        <view class="divider"></view>
        <text class="block-label">落到你这里</text>
        <view class="for-card" wx:for="{{relateItems}}" wx:key="who">
          <text class="for-k">{{item.who}}</text>
          <view class="for-body">
            <view class="for-line" wx:for="{{item.lines}}" wx:key="index">
              <text wx:for="{{item.segments}}" wx:for-item="seg" wx:for-index="segIdx" wx:key="segIdx" class="{{seg.bold ? 'for-bold' : ''}}">{{seg.text}}</text>
            </view>
          </view>
        </view>
        <view class="relate-skip" wx:if="{{relateSkip}}">{{relateSkip}}</view>
      </block>

      <!-- 了解更多 ▸（可展开：真实来源链接） -->
      <block wx:if="{{hasMore}}">
        <view class="divider"></view>
        <view class="fold {{showMore ? 'open' : ''}}">
          <view class="fold-head" bindtap="toggleMore"><text>了解更多</text><text class="fold-arrow">{{showMore ? '▾' : '▸'}}</text></view>
          <view class="fold-body" wx:if="{{showMore}}">
            <view class="step" wx:if="{{sourceUrl}}" bindtap="copyLink" data-url="{{sourceUrl}}">
              <view class="step-n">1</view>
              <view class="step-txt"><text class="link">{{sourceUrl}}</text></view>
            </view>
            <view class="step" wx:for="{{references}}" wx:key="url" wx:for-item="ref" bindtap="copyLink" data-url="{{ref.url || ref}}">
              <view class="step-n">{{index + 2}}</view>
              <view class="step-txt"><text class="link">{{ref.url || ref}}</text></view>
            </view>
          </view>
        </view>
      </block>

      <!-- 试试看 ▸（可展开：轻松引导 + 参考链接 + 风险提示） -->
      <block wx:if="{{minActionText || practiceText}}">
        <view class="fold {{showTry ? 'open' : ''}}">
          <view class="fold-head" bindtap="toggleTry"><text>试试看</text><text class="fold-arrow">{{showTry ? '▾' : '▸'}}</text></view>
          <view class="fold-body" wx:if="{{showTry}}">
            <view class="body" wx:if="{{minActionText}}">{{minActionText}}</view>
            <view class="step" wx:for="{{references}}" wx:key="url" wx:for-item="ref" bindtap="copyLink" data-url="{{ref.url || ref}}">
              <view class="step-n">→</view>
              <view class="step-txt"><text class="link">{{ref.url || ref}}</text></view>
            </view>
            <view class="risk">小提示：先按最轻量的一步试试最顺手；涉及敏感数据记得先脱敏。</view>
          </view>
        </view>
      </block>
    </block>

    <view class="foot-note">由 AI 情报官生成 · 内容基于公开信息整理，仅供参考</view>
  </view>
</view>
