<!--
  INTEL-MODULE: AI 情报官模块 · 情报详情（UI 重构 v6 落地）
  变更要点：去顶部状态条；来源在标题下方展示；"落到你这里"浅蓝底卡；了解更多保持可展开。
  数据结构不变（title/srcName/whatHappenedParagraphs/descText/relateItems/practiceText/minActionText/hasMore/sourceUrl）；标签"最小行动"→"想试试"（对齐 owner 拍板）。
-->
<view class="page {{themeClass}} intel-detail" style="--menu-top: {{topBarH}}px; --menu-height: {{menuHeight}}px; --safe-bottom: {{safeBottom}}px; --font-scale: {{_fontScaleValue}}; --font-scale-meta: {{_metaScaleValue}};">
  <!-- 顶部条带（对齐原生胶囊） -->
  <view class="status-bar-fill" style="height: {{topBarH}}px; background-color: var(--bg-page);"></view>

  <!-- 导航 -->
  <view class="nav">
    <text class="nav-back" bindtap="goBack">‹</text>
    <text class="nav-title">情报详情</text>
  </view>

  <scroll-view class="content" scroll-y show-scrollbar="{{false}}">

    <!-- 加载态 -->
    <block wx:if="{{loading}}">
      <view class="state-hint"><text class="state-t">情报官正在梳理详情…</text></view>
    </block>

    <!-- 空态 -->
    <block wx:elif="{{empty}}">
      <view class="state-hint"><text class="state-t">这条情报的详情尚未生成</text><text class="state-s">稍后再来看看</text></view>
    </block>

    <!-- 真实数据 -->
    <block wx:else>
      <!-- 结论式标题 + 来源（时间字段后端补上后自动展示） -->
      <text class="detail-title">{{title}}</text>
      <view class="meta" wx:if="{{srcName}}">
        <text class="meta-src">{{srcName}}</text>
      </view>

      <!-- 发生了什么 -->
      <text class="block-label">发生了什么</text>
      <block wx:if="{{whatHappenedParagraphs.length}}">
        <view class="prose {{index ? 'prose-2' : ''}}" wx:for="{{whatHappenedParagraphs}}" wx:key="index">{{item}}</view>
      </block>
      <view class="prose" wx:else>{{descText}}</view>

      <view class="divider" wx:if="{{relateItems.length}}"></view>

      <!-- 落到你这里（浅蓝底卡） -->
      <block wx:if="{{relateItems.length}}">
        <text class="block-label">落到你这里</text>
        <view class="for-card" wx:for="{{relateItems}}" wx:key="who">
          <text class="for-k">{{item.who}}</text>
          <view class="for-body">{{item.txt}}</view>
        </view>
        <view class="relate-skip" wx:if="{{relateSkip}}">{{relateSkip}}</view>
      </block>

      <!-- 可以怎么做 -->
      <view class="divider" wx:if="{{practiceText}}"></view>
      <block wx:if="{{practiceText}}">
        <text class="block-label">可以怎么做</text>
        <view class="prose">{{practiceText}}</view>
      </block>

      <!-- 想试试（owner 2026-08-19：最小行动改名想试试，仅可落地案例才展示） -->
      <block wx:if="{{minActionText}}">
        <view class="divider"></view>
        <text class="block-label">想试试</text>
        <view class="prose">{{minActionText}}</view>
      </block>

      <!-- 了解更多 ▸（有真实来源时才展示） -->
      <block wx:if="{{hasMore}}">
        <view class="expand {{showMore ? 'open' : ''}}">
          <view class="expand-head" bindtap="toggleMore"><text>了解更多</text><text class="chev">{{showMore ? '▾' : '▸'}}</text></view>
          <view class="expand-body" wx:if="{{showMore}}">
            <view class="src-link" wx:if="{{sourceUrl}}" bindtap="copyLink" data-url="{{sourceUrl}}">
              <text class="src-txt">{{sourceUrl}}</text>
            </view>
          </view>
        </view>
      </block>
    </block>

    <view class="foot-note">由 AI 情报官生成 · 内容基于公开信息整理，仅供参考</view>
  </scroll-view>
</view>
