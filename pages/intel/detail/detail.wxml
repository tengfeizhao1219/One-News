<!--
  INTEL-MODULE: AI 情报官模块 · 情报详情
  设计要点：
  - 后端 SOP 藏为「看不见的劳动力」，用户只看到成品。
  - 区块标题用系统蓝；正文 28rpx/1.6；高亮为系统蓝底+灰字，不抢眼。
  - 方案A：详情内容与所选卡片匹配，统一走云函数 intelGetDetail 拉真实数据。
  - owner 2026-08-18 19:45：不放 mock，空态展示友好提示。
  - 融合说明：以 Desktop(intel-officer) 的加载态/空态/安全区为骨架，融入 main 的
    whatHappened 科普多段叙事 + 可以怎么做 + 最小行动。
-->
<view class="page {{themeClass}} intel-detail" style="--menu-top: {{topBarH}}px; --menu-height: {{menuHeight}}px; --safe-bottom: {{safeBottom}}px; --font-scale: {{_fontScaleValue}}; --font-scale-meta: {{_metaScaleValue}};">
  <!-- 顶部条带（对齐原生胶囊）：先铺背景，再把导航顶到胶囊下方，避免与胶囊重叠 -->
  <view class="status-bar-fill" style="height: {{topBarH}}px; background-color: var(--bg-card);"></view>

  <!-- 导航（顶到胶囊下方，避开原生胶囊）；title/back 垂直居中于胶囊高度区 -->
  <view class="nav">
    <text class="nav-back" bindtap="goBack">‹</text>
    <text class="nav-title">情报详情</text>
    <view class="src-chip" wx:if="{{srcName}}">{{srcName}}</view>
  </view>

  <scroll-view class="content" scroll-y show-scrollbar="{{false}}">

    <!-- 加载态 -->
    <block wx:if="{{loading}}">
      <view class="state-hint">情报官正在梳理详情…</view>
    </block>

    <!-- 空态 -->
    <block wx:elif="{{empty}}">
      <view class="state-hint">这条情报的详情尚未生成，稍后再来看看</view>
    </block>

    <!-- 真实数据 -->
    <block wx:else>
      <!-- 状态条 -->
      <view class="status-strip">
        <view class="dot-g"></view>
        <text>情报官已完成梳理</text>
      </view>

      <!-- 结论式标题 -->
      <text class="detail-title">{{title}}</text>

      <!-- 发生了什么：优先展示科普向详细叙事（多段），无则回退一句话摘要 descText -->
      <text class="block-label">发生了什么</text>
      <block wx:if="{{whatHappenedParagraphs.length}}">
        <view class="prose {{index ? 'prose-2' : ''}}" wx:for="{{whatHappenedParagraphs}}" wx:key="index">{{item}}</view>
      </block>
      <view class="prose" wx:else>{{descText}}</view>

      <view class="divider" wx:if="{{relateItems.length}}"></view>

      <!-- 落到你这里 -->
      <block wx:if="{{relateItems.length}}">
        <text class="block-label">落到你这里</text>
        <view class="relate">
          <view class="relate-item" wx:for="{{relateItems}}" wx:key="who">
            <view class="who"><text class="who-ic">工</text><text class="who-txt">{{item.who}}</text></view>
            <view class="relate-txt">{{item.txt}}</view>
          </view>
          <view class="relate-skip" wx:if="{{relateSkip}}">{{relateSkip}}</view>
        </view>
      </block>

      <!-- 可以怎么做（实操案例）：后端 sop.practice 已生成，补渲染供用户直接落地 -->
      <view class="divider" wx:if="{{practiceText}}"></view>
      <block wx:if="{{practiceText}}">
        <text class="block-label">可以怎么做</text>
        <view class="prose">{{practiceText}}</view>
        <view class="divider"></view>
      </block>

      <!-- 最小行动：一个可勾选的具体下一步 -->
      <block wx:if="{{minActionText}}">
        <text class="block-label">最小行动</text>
        <view class="prose">{{minActionText}}</view>
        <view class="divider"></view>
      </block>

      <!-- 了解更多 ▸（有真实来源时才展示） -->
      <block wx:if="{{hasMore}}">
        <view class="expand {{showMore ? 'open' : ''}}">
          <view class="expand-head" bindtap="toggleMore">了解更多 <text class="chev">›</text></view>
          <view class="expand-body" wx:if="{{showMore}}">
            <view class="src-link" wx:if="{{sourceUrl}}" bindtap="copyLink" data-url="{{sourceUrl}}">
              <text class="src-ico">📄</text><text class="src-txt">{{sourceUrl}}</text><text class="src-arr">↗</text>
            </view>
          </view>
        </view>
      </block>
    </block>

    <view class="foot-note">由 AI 情报官生成 · 内容基于公开信息整理，仅供参考</view>
  </scroll-view>
</view>
