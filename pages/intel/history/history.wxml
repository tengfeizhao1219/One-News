<!-- INTEL-MODULE: AI 情报官 · 浏览历史（2026-08-21：纯本地，30 天 TTL 滚动清除） -->
<view class="page {{themeClass}} intel-history" style="--menu-top: {{topBarH}}px; --menu-height: {{menuHeight}}px; --safe-bottom: {{safeBottom}}px; --font-scale: {{_fontScaleValue}}; --font-scale-meta: {{_metaScaleValue}};">
  <!-- 状态栏背景层 -->
  <view class="status-bar-fill" style="height: {{topBarH}}px; background-color: var(--bg-page);"></view>

  <!-- 导航：‹ 返回 / 标题 + 清空 -->
  <view class="nav">
    <view class="nav-home" bindtap="goBack" hover-class="nav-home--hover">
      <image class="nav-home-icon-img nav-light" src="/assets/icons/home.svg" mode="aspectFit"></image>
      <image class="nav-home-icon-img nav-dark" src="/assets/icons/home-dark.svg" mode="aspectFit"></image>
    </view>
    <text class="nav-title">浏览历史</text>
    <text class="nav-clear" wx:if="{{list.length}}" bindtap="onClearAll" hover-class="nav-clear--hover">清空</text>
  </view>

  <scroll-view class="content" scroll-y show-scrollbar="{{false}}">
    <!-- 加载态 -->
    <block wx:if="{{loading}}">
      <view class="state-hint"><text class="state-t">正在读取记录…</text></view>
    </block>

    <!-- 空态 -->
    <block wx:elif="{{empty}}">
      <view class="state-hint">
        <text class="state-t">还没有浏览记录</text>
        <text class="state-s">看过的情报会自动留在这里，30 天内有效</text>
      </view>
    </block>

    <!-- 历史卡片 -->
    <block wx:else>
      <view class="card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="card-main">
          <text class="card-title">{{item.title}}</text>
          <view class="card-meta" wx:if="{{item.src || item.time}}">
            <text class="meta-src" wx:if="{{item.src}}">{{item.src}}</text>
            <text class="meta-time" wx:if="{{item.time}}">{{item.time}}</text>
          </view>
          <text class="card-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
        </view>
        <!-- 单条删除 -->
        <view class="card-del" catchtap="onRemove" data-id="{{item.id}}" hover-class="card-del--hover">×</view>
      </view>
    </block>

    <view class="foot-note">浏览记录保存在本机 · 30 天自动清除</view>
  </scroll-view>
</view>
