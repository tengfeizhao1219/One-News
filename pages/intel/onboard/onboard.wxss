/* INTEL-MODULE: AI 情报官 · 初始化引导样式。设计令牌全部引用 theme.json，零新增 hex。 */
.intel-onboard {
  height: 100vh;
  overflow: hidden;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
}

.status-bar-fill {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  z-index: 16;
}

/* ===== 顶部 ===== */
.nav {
  padding: calc(var(--menu-top, 44px) + var(--menu-height, 32px) + 16rpx) 32rpx 16rpx;
  background-color: var(--bg-card);
}
.nav-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.nav-title {
  font-size: calc(36rpx * var(--font-scale));
  font-weight: 700;
  color: var(--text-primary);
}
.nav-sub {
  margin-left: auto;
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
}

.step-bar {
  height: 8rpx;
  border-radius: 8rpx;
  background: var(--bg-subtle);
  overflow: hidden;
}
.step-bar-fill {
  height: 100%;
  background: var(--primary);
  transition: width 0.25s ease;
}
.step-dots {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
  justify-content: center;
}
.step-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--divider);
}
.step-dot.on {
  background: var(--primary);
}

/* ===== 内容区 ===== */
.content {
  /* 底部空白区（padding/占位）默认渲染为白色——显式硬编码着色与背景同色；
     不用 var()（带 fallback 的 var() 在部分版本整条声明被丢弃，退回默认白） */
  background-color: #FAF9F7;
  flex: 1;
  height: 0;
  padding: 8rpx 32rpx calc(8rpx + var(--safe-bottom, 0px));
  box-sizing: border-box;
  overflow-y: auto;
}
/* 深色模式：与 --bg-card dark(#0D0D0D) 同色 */
.page--dark .content { background-color: #0D0D0D; }


.step-h {
  font-size: calc(34rpx * var(--font-scale));
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
  margin: 8rpx 0 8rpx;
}
.step-sub {
  font-size: calc(24rpx * var(--font-scale));
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.step-section-label {
  font-size: calc(24rpx * var(--font-scale));
  color: var(--text-secondary);
  margin: 28rpx 0 12rpx;
  font-weight: 500;
}

/* ===== Step 0 字段 ===== */
.field {
  margin-bottom: 24rpx;
}
.field-label {
  display: block;
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}
.field-meta {
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
  font-weight: 400;
  margin-left: 4rpx;
}
.field-input {
  display: block;
  width: 100%;
  min-height: 96rpx;
  padding: 18rpx 20rpx;
  font-size: calc(28rpx * var(--font-scale));
  color: var(--text-primary);
  background: var(--bg-page);
  border: 1rpx solid var(--divider);
  border-radius: 16rpx;
  box-sizing: border-box;
  line-height: 1.5;
}

/* ===== Step 1 chip ===== */
.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.chip {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  font-size: calc(26rpx * var(--font-scale));
  color: var(--text-secondary);
  background: var(--tag-bg);
  border: 1rpx solid var(--divider);
  transition: all 0.15s;
}
.chip.on {
  background: var(--primary);
  color: var(--chip-text);
  border-color: var(--primary);
}

.custom-tag {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.custom-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: calc(26rpx * var(--font-scale));
  color: var(--text-primary);
  background: var(--bg-page);
  border: 1rpx solid var(--divider);
  border-radius: 16rpx;
  box-sizing: border-box;
}
.custom-add {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  background: var(--primary);
  color: var(--chip-text);
  border-radius: 16rpx;
  font-size: calc(26rpx * var(--font-scale));
}

.picked {
  margin-top: 8rpx;
  padding: 18rpx 20rpx;
  background: var(--bg-page);
  border: 1rpx solid var(--divider);
  border-radius: 16rpx;
}
.picked-label {
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
  margin-right: 8rpx;
}
.picked-item {
  display: inline-block;
  margin: 4rpx 8rpx 4rpx 0;
  font-size: calc(24rpx * var(--font-scale));
  color: var(--primary);
}

/* ===== Step 2 分段控制器 + 开关（复刻 settings.wxss 范式） ===== */
.seg {
  display: flex;
  background: var(--seg-bg);
  border-radius: 12rpx;
  padding: 4rpx;
  gap: 0;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: calc(26rpx * var(--font-scale));
  padding: 14rpx 0;
  border-radius: 10rpx;
  color: var(--text-primary);
  transition: all 0.15s;
}
.seg-item.on {
  background: var(--seg-on-bg);
  color: var(--seg-on-text);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.12);
  font-weight: 600;
}
.depth-desc {
  margin-top: 14rpx;
  padding: 16rpx 20rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: var(--text-secondary);
  background: var(--bg-page);
  border: 1rpx solid var(--divider);
  border-radius: 16rpx;
  line-height: 1.5;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx;
  margin-top: 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--divider);
  border-radius: 20rpx;
}
.switch-row-body {
  flex: 1;
  padding-right: 16rpx;
}
.switch-row-label {
  display: block;
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 600;
  color: var(--text-primary);
}
.switch-row-sub {
  display: block;
  margin-top: 4rpx;
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
}
.switch {
  width: 96rpx;
  height: 58rpx;
  border-radius: 29rpx;
  position: relative;
  background: var(--switch-off);
  transition: background 0.22s;
  flex-shrink: 0;
}
.switch.on {
  background: var(--primary);
}
.switch-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: var(--switch-knob);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.18);
  transition: left 0.22s;
}
.switch.on .switch-knob {
  left: 42rpx;
}

/* ===== Step 3 告知 + 授权 ===== */
.notice-card {
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  background: var(--bg-page);
  border: 1rpx solid var(--divider);
  border-radius: 20rpx;
}
.notice-title {
  display: block;
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}
.notice-body {
  display: block;
  font-size: calc(24rpx * var(--font-scale));
  color: var(--text-body);
  line-height: 1.6;
}

.consent {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  margin-top: 8rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--divider);
  border-radius: 20rpx;
}
.consent-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--divider);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  box-sizing: border-box;
  transition: all 0.15s;
}
.consent-box.on {
  background: var(--primary);
  border-color: var(--primary);
}
.consent-check {
  color: var(--chip-text);
  font-size: 28rpx;
  line-height: 1;
  font-weight: 700;
}
.consent-text {
  flex: 1;
  font-size: calc(24rpx * var(--font-scale));
  color: var(--text-primary);
  line-height: 1.6;
}

/* ===== 错误 & 页脚 ===== */
.err-msg {
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  background: var(--color-warning-subtle);
  color: var(--color-warning);
  border-radius: 16rpx;
  font-size: calc(24rpx * var(--font-scale));
  line-height: 1.5;
}

.foot-note {
  text-align: center;
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-tertiary);
  margin: 24rpx 0 calc(16rpx + var(--safe-bottom, 0px));
}

/* ===== 底部固定按钮 ===== */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 32rpx calc(18rpx + var(--safe-bottom, 0px));
  background: var(--bg-card);
  border-top: 1rpx solid var(--divider);
  z-index: 18;
}
.btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: calc(30rpx * var(--font-scale));
  font-weight: 600;
  transition: all 0.15s;
}
.btn-primary {
  background: var(--primary);
  color: var(--chip-text);
}
.btn-primary.disabled,
.btn-ghost.disabled {
  opacity: 0.35;
  pointer-events: none;
}
.btn-ghost {
  background: var(--bg-subtle);
  color: var(--text-primary);
}
.btn:active {
  transform: scale(0.97);
}
