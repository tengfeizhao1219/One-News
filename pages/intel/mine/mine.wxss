/* INTEL-MODULE: AI 情报官 · 我的样式。设计令牌全部引用 theme.json，零新增 hex。 */
.intel-mine {
  min-height: 100vh;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
}
.status-bar { width: 100%; }

.nav {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 32rpx 16rpx;
}
.nav-back { font-size: 44rpx; color: var(--primary); line-height: 1; }
.nav-title { font-size: 34rpx; font-weight: 700; color: var(--text-primary); }

.content {
  flex: 1;
  padding: 8rpx 32rpx calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sect-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin: 24rpx 4rpx 20rpx;
}
.sect-head .dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--primary); }

.card {
  background: var(--bg-card);
  border: 1rpx solid var(--divider);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.card-title { display: block; font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.card-desc { display: block; font-size: 26rpx; color: var(--text-body); margin-top: 8rpx; line-height: 1.5; }

.foot-note {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin: 24rpx 0 32rpx;
}
