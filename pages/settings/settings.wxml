<!-- 设置页 — UI-B9 独立全屏页 · D-09 v1.2（BUG-20260806-007） -->
<!-- BUG-20260807-003: 根节点注入 --font-scale / --font-scale-meta，预览卡摘要随档位缩放（对齐 UX-FIX-F13） -->
<view class="page {{themeClass}}" style="--font-scale: {{_fontScaleValue}}; --font-scale-meta: {{_metaScaleValue}}; --nav-offset: {{navOffset}}px;">

  <!-- 顶部导航栏：主页（左）+ 标题 · D-09 v1.2（仅下扩展 12px，按钮锚定胶囊中心） -->
  <!-- BUG-20260806-009 v3: 状态栏不透明背景层 -->
  <view class="status-bar-fill" style="height: {{statusBarHeight}}px; background-color: var(--bg-page);"></view>
  <view class="nav-bar" style="top: {{menuTop}}px; height: calc({{menuHeight}}px + 24rpx); background-color: var(--bg-page);">
    <!-- BUG-20260806-003: 第 2 层页面统一使用主页按钮（home.svg + reLaunch） -->
    <!-- BUG-20260806-009 follow-up: 按钮是 .nav-bar 子元素 absolute 定位，相对 nav-bar 偏移。
         正确公式：top = menuHeight/2 - 32rpx（去掉 menuTop，避免双重定位） -->
    <view class="nav-home" bindtap="goHome" hover-class="nav-home--hover" style="top: calc({{menuHeight}}px / 2 - 32rpx);">
      <image class="nav-home-icon-img" src="/assets/icons/home{{isDark ? '-dark' : ''}}.svg" mode="aspectFit"></image>
    </view>
    <view class="nav-title">设置</view>
  </view>

  <scroll-view class="scroller" scroll-y>

    <!-- 显示 -->
    <view class="group">
      <view class="group-label">显示</view>
      <view class="card">
        <view class="row" bindtap="toggleFollowSystem">
          <view>
            <view class="row-label">跟随系统</view>
            <view class="row-sub">开启时深色模式由系统决定</view>
          </view>
          <view class="switch {{followSystem ? 'on' : ''}}">
            <view class="switch-knob"></view>
          </view>
        </view>
        <view class="row" bindtap="toggleDarkMode">
          <view>
            <view class="row-label">深色模式</view>
            <view class="row-sub">{{followSystem ? '关闭手动切换后可调整' : '手动覆盖外观'}}</view>
          </view>
          <view class="switch {{darkMode ? 'on' : ''}} {{followSystem ? 'disabled' : ''}}">
            <view class="switch-knob"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 阅读 -->
    <view class="group">
      <view class="group-label">阅读</view>
      <view class="card">
        <view class="row row--block">
          <view class="row-label">字体大小</view>
          <view class="seg">
            <view
              class="seg-item {{fontScaleTier === item.value ? 'on' : ''}}"
              wx:for="{{tiers}}"
              wx:key="value"
              data-tier="{{item.value}}"
              bindtap="onSelectTier">
              {{item.label}}
            </view>
          </view>
        </view>

        <!-- 实时预览卡 -->
        <view class="preview-wrap">
          <view class="preview-label">实时预览（随上方档位缩放）</view>
          <view class="preview-card">
            <view class="pv-title">量子计算机首次实现千比特纠错运算</view>
            <view class="pv-meta">
              <text class="pv-tag">科技</text>
              <text>科技日报</text>
              <text>·</text>
              <text>2 小时前</text>
            </view>
            <view class="pv-summary">
              <text class="pv-chip">AI 摘要</text>研究团队宣布在超导量子芯片上实现了千比特级别的实时纠错，错误率降至十万分之一以下。
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 关于 -->
    <view class="group">
      <view class="group-label">关于</view>
      <view class="card">
        <view class="row" bindtap="onTapVersion" hover-class="row--hover">
          <view class="row-label">版本</view>
          <view class="row-val">
            <text>{{appVersion}}</text>
            <text class="row-chev">›</text>
          </view>
        </view>
        <view class="row" bindtap="onFeedback">
          <view class="row-label">意见反馈</view>
          <text class="row-chev">›</text>
        </view>
        <view class="row" bindtap="openContactModal">
          <view class="row-label">联系开发者</view>
          <text class="row-chev">›</text>
        </view>
      </view>
    </view>

    <!-- 底部品牌 splash logo -->
    <view class="brand-footer">
      <view class="brand-card">
        <logo id="settings-logo" mode="splash" fluid></logo>
      </view>
      <view class="brand-text">一页 · 简单到极致</view>
    </view>

  </scroll-view>

  <!-- 更新日志弹窗（2026-08-09） -->
  <changelog-modal visible="{{showChangelog}}" latest="{{latestChangelog}}" bind:close="onCloseChangelog"></changelog-modal>

  <!-- 联系开发者弹窗（2026-08-26 owner 要求） -->
  <view class="contact-modal-backdrop {{contactModalVisible ? 'show' : ''}}" bindtap="closeContactModal">
    <view class="contact-modal" catchtap="noop">
      <view class="contact-modal-title">联系开发者</view>
      <view class="contact-modal-item">
        <view class="contact-modal-info">
          <text class="contact-modal-name">邮箱</text>
          <text class="contact-modal-key" bindtap="onEmailTap">ztengfei@hotmail.com</text>
        </view>
        <view class="contact-modal-copy" bindtap="copyEmail">复制</view>
      </view>
      <view class="contact-modal-item">
        <view class="contact-modal-info">
          <text class="contact-modal-name">微信</text>
          <text class="contact-modal-key">jiaowotengfei</text>
        </view>
        <view class="contact-modal-copy" bindtap="copyWechat">复制</view>
      </view>
      <view class="contact-modal-btn" bindtap="closeContactModal">关闭</view>
    </view>
  </view>
</view>
