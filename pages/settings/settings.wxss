/* 设置页 — UI-B9 独立全屏页 · BUG-20260806-004 */

.page {
  height: 100vh;
  background-color: var(--bg-page);
  display: flex;
  flex-direction: column;
  color: var(--text-primary);
}

/* ========== 导航栏（D-09 v1.2 · BUG-20260806-007） ========== */
.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 22;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* D-09 v1.2: explicit 锚定胶囊中心 — top 由 wxml inline 注入 */
.nav-home {
  position: absolute;
  left: 12rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.nav-home--hover {
  background-color: var(--bg-subtle);
}
.nav-home-icon-img {
  width: 44rpx;
  height: 44rpx;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.scroller {
  flex: 1;
  /* BUG-FE-20260805-001：flex 子项默认 min-height:auto 会被内容撑开，超出 .page 被裁剪
     导致内容超过一屏无法滚动。min-height:0 允许收缩到 flex 分配高度 + overflow-y:auto
     CSS 滚动兜底（与 detail 页 .content 已验证方案对齐）。 */
  min-height: 0;
  overflow-y: auto;
  /* D-09 v1.2: 内容从导航栏下方 8rpx 开始 */
  padding: calc(var(--nav-offset, 0px) + 8rpx) 0 40rpx;
}

.group {
  margin: 0 32rpx 28rpx;
}
.group-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin: 0 8rpx 12rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}
.card {
  background: var(--bg-card);
  border-radius: 18rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  min-height: 96rpx;
  gap: 20rpx;
}
.row + .row {
  border-top: 1rpx solid var(--divider);
}
.row--hover {
  background-color: var(--bg-subtle);
}
.row--block {
  display: block;
  padding-bottom: 26rpx;
}
.row-label {
  font-size: 30rpx;
  color: var(--text-primary);
}
.row-sub {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}
.row-val {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.row-chev {
  font-size: 34rpx;
  color: var(--text-tertiary);
  line-height: 1;
  transition: transform 0.2s ease;
}
.row-chev--open {
  transform: rotate(90deg);
}

/* iOS 开关 */
.switch {
  width: 96rpx;
  height: 58rpx;
  border-radius: 29rpx;
  position: relative;
  background: var(--switch-off);
  transition: background 0.22s;
  flex-shrink: 0;
}
.switch.on {
  background: var(--primary);
}
.switch.disabled {
  opacity: 0.35;
  pointer-events: none;
}
.switch-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  /* D-07 S3 #2（FE 2026-08-05）：#fff → var(--switch-knob)，深浅两态均白（iOS 规范），
     裸色收敛至 app.wxss 变量块 */
  background: var(--switch-knob);
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.18);
  transition: left 0.22s;
}
/* D-07 S3（G-07）：knob 白色已收敛至 theme.json --switch-knob（深浅两态均白，iOS 规范） */
.switch.on .switch-knob {
  left: 42rpx;
}

/* 分段控制器 */
.seg {
  display: flex;
  background: var(--seg-bg);
  border-radius: 12rpx;
  padding: 4rpx;
  gap: 0;
  margin-top: 18rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 14rpx 0;
  border-radius: 10rpx;
  color: var(--text-primary);
  transition: all 0.15s;
}
.seg-item.on {
  background: var(--seg-on-bg);
  color: var(--seg-on-text);
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.12);
  font-weight: 600;
}

/* 实时预览卡 */
.preview-wrap {
  padding: 2rpx 28rpx 20rpx;
}
.preview-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin: 4rpx 4rpx 14rpx;
  letter-spacing: 0.5rpx;
}
.preview-card {
  background: var(--preview-bg);
  border: 1rpx solid var(--divider);
  border-radius: 18rpx;
  padding: 20rpx 26rpx;
}
.pv-title {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.45;
  letter-spacing: 0.5rpx;
}
.pv-meta {
  display: flex;
  gap: 10rpx;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin: 12rpx 0;
  letter-spacing: 0.5rpx;
}
.pv-tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  font-size: 18rpx;
  font-weight: 500;
  background: var(--tag-bg);
  color: var(--tag-text);
}
.pv-summary {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
  /* BUG-20260807-003: 预览卡摘要=正文，保留无障碍缩放（对齐 detail .text-p；标题/元信息仍固定） */
  font-size: calc(30rpx * var(--font-scale));
  color: var(--text-body);
  line-height: calc(1.8 * var(--font-scale));
  letter-spacing: 0.5rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.pv-chip {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: var(--primary);
  background: var(--primary-subtle);
  margin-right: 10rpx;
  vertical-align: middle;
}

/* 联系开发者展开面板 */
.contact {
  background: var(--bg-subtle);
  border-radius: 14rpx;
  margin: 0 8rpx;
  padding: 6rpx 24rpx;
  display: none;
}
.contact.show {
  display: block;
}
.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--text-primary);
}
.contact-item + .contact-item {
  border-top: 1rpx solid var(--divider);
}
.contact-key {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}
.contact-copy {
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-subtle);
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

/* ============ 暗色模式（D-08 方案 A：删除 BUG-20260805-002 硬编码兜底块）============
   D-07 S1-S4 后变量注入已改为 app.wxss 显式变量块（class 注入），变量失效问题已解决；
   正常路径各选择器均已 var() 引用（--seg-bg/--seg-on-bg/--switch-off 等 token 已存在）
   → 兜底硬编码为纯冗余（双轨漂移风险源），整块删除。 */

/* 底部品牌 splash logo */
.brand-footer {
  margin-top: 24rpx;
  padding: 0 32rpx;
  display: flex;
  justify-content: center;
}
