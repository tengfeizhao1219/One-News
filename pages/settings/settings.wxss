/* 设置页 — UI-B9 独立全屏页 */

.page {
  height: 100vh;
  background-color: var(--bg-page);
  display: flex;
  flex-direction: column;
  color: var(--text-primary);
}

/* 手动暗色覆盖（当 theme.json 仍跟随系统时，设置页内可独立预览） */
.page--dark {
  --bg-page: #000000;
  --bg-card: #0D0D0D;
  --bg-subtle: #1A1A1C;
  --text-primary: #FFFFFF;
  --text-secondary: #999999;
  --text-body: #D4D4D4;
  --text-tertiary: #666666;
  --divider: #1C1C1E;
  --tag-bg: #1C1C1E;
  --tag-text: #999999;
  --primary: #0A84FF;
  --primary-subtle: rgba(10, 132, 255, 0.18);
  --preview-bg: #141416;
  --seg-bg: #2C2C2E;
  --seg-on-bg: #636366;
  --seg-on-text: #FFFFFF;
  --switch-off: #39393D;
}

/* 顶部栏 */
.nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  padding: 6rpx 14rpx 10rpx;
  flex-shrink: 0;
}
.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
}
.nav-back--hover {
  opacity: 0.6;
}
.nav-back-icon {
  color: var(--primary);
  font-size: 48rpx;
  line-height: 1;
  margin-top: -4rpx;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-left: 4rpx;
}

.scroller {
  flex: 1;
  padding: 6rpx 0 40rpx;
}

.group {
  margin: 0 32rpx 28rpx;
}
.group-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin: 0 8rpx 12rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}
.card {
  background: var(--bg-card);
  border-radius: 18rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  min-height: 96rpx;
  gap: 20rpx;
}
.row + .row {
  border-top: 1rpx solid var(--divider);
}
.row--block {
  display: block;
  padding-bottom: 26rpx;
}
.row-label {
  font-size: 30rpx;
  color: var(--text-primary);
}
.row-sub {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}
.row-val {
  font-size: 28rpx;
  color: var(--text-secondary);
}
.row-chev {
  font-size: 34rpx;
  color: var(--text-tertiary);
  line-height: 1;
  transition: transform 0.2s ease;
}
.row-chev--open {
  transform: rotate(90deg);
}

/* iOS 开关 */
.switch {
  width: 96rpx;
  height: 58rpx;
  border-radius: 29rpx;
  position: relative;
  background: var(--switch-off, #E9E9EA);
  transition: background 0.22s;
  flex-shrink: 0;
}
.switch.on {
  background: var(--primary);
}
.switch.disabled {
  opacity: 0.35;
  pointer-events: none;
}
.switch-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.18);
  transition: left 0.22s;
}
.switch.on .switch-knob {
  left: 42rpx;
}

/* 分段控制器 */
.seg {
  display: flex;
  background: var(--seg-bg, #E4E4E6);
  border-radius: 12rpx;
  padding: 4rpx;
  gap: 0;
  margin-top: 18rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 14rpx 0;
  border-radius: 10rpx;
  color: var(--text-primary);
  transition: all 0.15s;
}
.seg-item.on {
  background: var(--seg-on-bg, #FFFFFF);
  color: var(--seg-on-text, #1C1C1E);
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.12);
  font-weight: 600;
}

/* 实时预览卡 */
.preview-wrap {
  padding: 2rpx 28rpx 20rpx;
}
.preview-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin: 4rpx 4rpx 14rpx;
  letter-spacing: 0.5rpx;
}
.preview-card {
  background: var(--preview-bg, var(--bg-page));
  border: 1rpx solid var(--divider);
  border-radius: 18rpx;
  padding: 20rpx 26rpx;
}
.pv-title {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
  font-size: calc(32rpx * var(--font-scale, 1));
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.45;
  letter-spacing: 0.5rpx;
}
.pv-meta {
  display: flex;
  gap: 10rpx;
  align-items: center;
  font-size: calc(22rpx * var(--font-scale-meta, 1));
  color: var(--text-secondary);
  margin: 12rpx 0;
  letter-spacing: 0.5rpx;
}
.pv-tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  font-size: 18rpx;
  font-weight: 500;
  background: var(--tag-bg);
  color: var(--tag-text);
}
.pv-summary {
  font-family: "PingFang SC", "Noto Serif SC", "Songti SC", Georgia, serif;
  font-size: calc(30rpx * var(--font-scale, 1));
  color: var(--text-body);
  line-height: calc(1.8 * var(--font-scale, 1));
  letter-spacing: 0.5rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.pv-chip {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  font-size: calc(20rpx * var(--font-scale-meta, 1));
  font-weight: 500;
  color: var(--primary);
  background: var(--primary-subtle);
  margin-right: 10rpx;
  vertical-align: middle;
}

/* 联系开发者展开面板 */
.contact {
  background: var(--bg-subtle);
  border-radius: 14rpx;
  margin: 0 8rpx;
  padding: 6rpx 24rpx;
  display: none;
}
.contact.show {
  display: block;
}
.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--text-primary);
}
.contact-item + .contact-item {
  border-top: 1rpx solid var(--divider);
}
.contact-key {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}
.contact-copy {
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-subtle);
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-weight: 500;
}
