/* 全局样式重置 */
page {
  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
  height: 100%;
  overflow: hidden;
}

/* ============ BUG-20260805-003: 全局手动暗色主题 ============
   设置页「深色模式」开关（非跟随系统时）→ app.applyTheme() 给所有页面根节点
   注入 class="page--dark"。此处变量定义作用于任意页面根节点（原定义在
   settings.wxss，仅设置页自身生效——这就是手动夜晚模式只改设置页的根因）。
   变量值 = theme.json dark 分支，与系统暗色一致。 */
.page--dark {
  --bg-page: #000000;
  --bg-card: #0D0D0D;
  --bg-subtle: #1A1A1C;
  --text-primary: #FFFFFF;
  --text-secondary: #999999;
  --text-body: #D4D4D4;
  --text-tertiary: #666666;
  --text-link: #7FA7D9;
  --divider: #1C1C1E;
  --tag-bg: #1C1C1E;
  --tag-text: #999999;
  --overlay: rgba(0, 0, 0, 0.7);
  --primary: #0A84FF;
  --primary-subtle: rgba(10, 132, 255, 0.18);
  --progress: rgba(10, 132, 255, 0.60);
  --highlight-bg: rgba(10, 132, 255, 0.10);
  --color-favorite: #FF453A;
  --color-favorite-tint: rgba(255, 69, 58, 0.16);
  --color-warning: #FBBF24;
  --bottom-bar-bg: rgba(13, 13, 13, 0.55);
  --setting-panel-bg: rgba(13, 13, 13, 0.78);
  --chip-bg: rgba(255, 255, 255, 0.15);
  --chip-text: #FFFFFF;
  /* 设置页专属（原 settings.wxss .page--dark 内定义，随全局提升） */
  --preview-bg: #141416;
  --seg-bg: #2C2C2E;
  --seg-on-bg: #636366;
  --seg-on-text: #FFFFFF;
  --switch-off: #39393D;
  /* D-07 S2：category-wheel 滚轮 token（theme.json dark 分支同步，G-03 关闭关键） */
  --wheel-opacity-idle: 0.35;
  --wheel-opacity-active: 0.92;
  --wheel-text-idle: rgba(255, 255, 255, 0.12);
  --wheel-text-selected: rgba(255, 255, 255, 0.5);
  --wheel-text-active: rgba(255, 255, 255, 0.45);
  --wheel-scale-active: 1.08;
  --wheel-bg-selected: rgba(10, 132, 255, 0.10);
  /* D-07 发现 A：详情页分类着色（theme.json dark 分支同步，手动模式正确） */
  --flash-tech: #60A5FA;
  --flash-world: #818CF8;
  --flash-sports: #FBBF24;
  --flash-life: #34D399;
  --flash-tech-bg: rgba(96, 165, 250, 0.12);
}

/* ============ D-07 S1: 全局浅色主题变量块 ============
   始终注入生效主题 class（page--dark / page--light），浅色显式声明，
   保证「手动浅色 + 系统深色」下浅色 token 覆盖原生 var()（关闭 G-01）。
   变量值 = theme.json light 分支，与系统浅色一致，不允许顺手改色值。 */
.page--light {
  --bg-page: #F5F3F0;
  --bg-card: #FAF9F7;
  --bg-subtle: #F0EEEA;
  --text-primary: #1C1C1E;
  --text-secondary: #6B6B70;
  --text-body: #5E5E60;
  --text-tertiary: #8A8A8E;
  --text-link: #576b95;
  --divider: #E8E6E1;
  --tag-bg: #EEECE8;
  --tag-text: #7A7A7A;
  --overlay: rgba(0, 0, 0, 0.25);
  --primary: #007AFF;
  --primary-subtle: rgba(0, 122, 255, 0.12);
  --progress: rgba(0, 122, 255, 0.55);
  --highlight-bg: rgba(0, 122, 255, 0.06);
  --color-favorite: #FF3B30;
  --color-favorite-tint: rgba(255, 59, 48, 0.10);
  --color-warning: #F59E0B;
  --bottom-bar-bg: rgba(250, 249, 247, 0.55);
  --setting-panel-bg: rgba(250, 249, 247, 0.78);
  --chip-bg: rgba(28, 28, 30, 0.85);
  --chip-text: #FFFFFF;
  /* 设置页专属浅色（对照 .page--dark；值取 settings.wxss 原 fallback，防视觉漂移） */
  --preview-bg: #F5F3F0;
  --seg-bg: #E4E4E6;
  --seg-on-bg: #FFFFFF;
  --seg-on-text: #1C1C1E;
  --switch-off: #E9E9EA;
  /* D-07 S2：category-wheel 滚轮 token（theme.json light 分支同步） */
  --wheel-opacity-idle: 0.35;
  --wheel-opacity-active: 0.92;
  --wheel-text-idle: rgba(0, 0, 0, 0.12);
  --wheel-text-selected: rgba(0, 0, 0, 0.5);
  --wheel-text-active: rgba(0, 0, 0, 0.45);
  --wheel-scale-active: 1.08;
  --wheel-bg-selected: rgba(0, 122, 255, 0.06);
  /* D-07 发现 A：详情页分类着色（theme.json light 分支同步） */
  --flash-tech: #007AFF;
  --flash-world: #5856D6;
  --flash-sports: #FF9500;
  --flash-life: #34C759;
  --flash-tech-bg: rgba(0, 122, 255, 0.08);
}

/* 暗色模式统一由 theme.json 的 CSS 变量驱动，此处不再硬编码覆盖 */

/* 状态栏占位 */
.status-bar {
  flex-shrink: 0;
}

/* 全局组件样式 */
.category-tag {
  display: inline-block;
  padding: 3rpx 14rpx;
  border-radius: 16rpx;
  font-size: 18rpx;
  font-weight: 500;
  background-color: var(--tag-bg);
  color: var(--tag-text);
}

/* UX-FIX-F9: 全局减弱动效偏好适配（D-02 §2.2）
   所有动画、过渡 ≤100ms；保持 opacity/display 切换瞬达，
   避免 vestibular disorder 用户在快速翻页/滚轮 snap 时产生眩晕。
   小程序环境不支持 prefers-reduced-motion 媒体查询？实际上 iOS/Android 均可传递系统设置，
   微信基础库 2.8.0+ 已支持；若旧设备不支持，本媒体查询只是静默失效，无负面影响。
   ⚠️ 修复记录（2026-08-02 20:56, PM 代前端）：原写法用通配选择器 `* {}`，
   微信 WXSS 不支持通配符（IDE 报 unexpected token '*'，app.wxss(1:809)），
   已改为 WXSS 支持的元素选择器列表（element, element），效果等价全局。 */
@media (prefers-reduced-motion: reduce) {
  page, view, scroll-view, swiper, swiper-item, text, image, button, navigator, icon, cover-view, movable-area, movable-view {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
