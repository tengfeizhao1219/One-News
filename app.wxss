/* 全局样式重置 */
page {
  /* iOS 底部 Home Indicator 安全区显示 page 根元素背景——硬编码 --bg-card 两档，
     与内容背景恒同色（不依赖 theme.json 变量注入，部分真机注入失败会回退纯白）；
     height + env 把背景铺进底部安全区。 */
  background-color: #FAF9F7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
  height: calc(100% + env(safe-area-inset-bottom));
  overflow: hidden;
}
@media (prefers-color-scheme: dark) {
  page {
    background-color: #0D0D0D;
  }
}

/* 全局手动暗色主题变量块。
   设置页深色模式开关（非跟随系统时）通过 app.applyTheme() 给所有页面根节点
   注入 class="page--dark"。变量值 = theme.json dark 分支，与系统暗色一致。
   D-07 补全：flash 和 wheel 变量族、color-favorite-active、setting-panel-blur。 */
.page--dark {
  --bg-page: #000000;
  --bg-card: #0D0D0D;
  --overlay-surface: #1C1C1E;
  --bg-subtle: #1A1A1C;
  --text-primary: #FFFFFF;
  --text-secondary: #999999;
  --text-body: #D4D4D4;
  --text-tertiary: #666666;
  --text-link: #7FA7D9;
  --divider: #1C1C1E;
  --tag-bg: #1C1C1E;
  --tag-text: #999999;
  --overlay: rgba(0, 0, 0, 0.7);
  --primary: #0A84FF;
  --primary-subtle: rgba(10, 132, 255, 0.18);
  --brand-green: #4FAD5B;
  --brand-green-subtle: rgba(79, 173, 91, 0.18);
  --progress: rgba(10, 132, 255, 0.60);
  --highlight-bg: rgba(10, 132, 255, 0.10);
  --color-favorite: #FF453A;
  --color-favorite-active: #FF453A;
  --color-favorite-tint: rgba(255, 69, 58, 0.16);
  --color-warning: #FBBF24;
  /* D-08（2026-08-06）：琥珀警告色 alpha 版 token（警告条/同步失败条背景） */
  --color-warning-subtle: rgba(255, 159, 10, 0.15);
  --bottom-bar-bg: rgba(13, 13, 13, 0.55);
  --setting-panel-bg: rgba(13, 13, 13, 0.78);
  --setting-panel-blur: blur(20px);
  --chip-bg: rgba(255, 255, 255, 0.15);
  --chip-text: #FFFFFF;
  --flash-tech: #60A5FA;
  --flash-world: #818CF8;
  --flash-science: #FBBF24;
  --flash-life: #34D399;
  --flash-tech-bg: rgba(96, 165, 250, 0.12);
  --wheel-opacity-idle: 0.35;
  --wheel-opacity-active: 0.92;
  --wheel-text-idle: rgba(255, 255, 255, 0.12);
  --wheel-text-selected: rgba(255, 255, 255, 0.5);
  /* BUG-20260806-004: 选中态字体淡蓝（D-02 v2.4），语义独立于 --wheel-text-selected */
  --wheel-text-selected-color: #0A84FF;
  --wheel-text-active: rgba(255, 255, 255, 0.45);
  --wheel-scale-active: 1.5;
  --wheel-bg-selected: rgba(10, 132, 255, 0.10);
  --preview-bg: #141416;
  --seg-bg: #2C2C2E;
  --seg-on-bg: #636366;
  --seg-on-text: #FFFFFF;
  --switch-off: #39393D;
  --switch-knob: #FFFFFF;
}

/* 全局浅色主题变量块（D-07 S1）。
   始终注入生效主题 class（page--dark 和 page--light），浅色显式声明，
   保证手动浅色 + 系统深色下浅色 token 覆盖原生 var()（关闭 G-01）。
   变量值 = theme.json light 分支，与系统浅色一致。 */
.page--light {
  --bg-page: #F5F3F0;
  --bg-card: #FAF9F7;
  --overlay-surface: #FAF9F7;
  --bg-subtle: #F0EEEA;
  --text-primary: #1C1C1E;
  --text-secondary: #6B6B70;
  --text-body: #5E5E60;
  --text-tertiary: #8A8A8E;
  --text-link: #576b95;
  --divider: #E8E6E1;
  --tag-bg: #EEECE8;
  --tag-text: #7A7A7A;
  --overlay: rgba(0, 0, 0, 0.25);
  --primary: #007AFF;
  --primary-subtle: rgba(0, 122, 255, 0.12);
  --brand-green: #4FAD5B;
  --brand-green-subtle: rgba(79, 173, 91, 0.12);
  --progress: rgba(0, 122, 255, 0.55);
  --highlight-bg: rgba(0, 122, 255, 0.06);
  --color-favorite: #FF3B30;
  --color-favorite-active: #FF3B30;
  --color-favorite-tint: rgba(255, 59, 48, 0.10);
  --color-warning: #F59E0B;
  /* D-08（2026-08-06）：琥珀警告色 alpha 版 token */
  --color-warning-subtle: rgba(245, 158, 11, 0.15);
  --bottom-bar-bg: rgba(250, 249, 247, 0.55);
  --setting-panel-bg: rgba(250, 249, 247, 0.78);
  --setting-panel-blur: blur(20px);
  --chip-bg: rgba(28, 28, 30, 0.85);
  --chip-text: #FFFFFF;
  --preview-bg: #F5F3F0;
  --seg-bg: #E4E4E6;
  --seg-on-bg: #FFFFFF;
  --seg-on-text: #1C1C1E;
  --switch-off: #E9E9EA;
  /* D-08 v2.1（2025-08-10 fix）: —page--light 缺少 —switch-knob 声明，
     导致 switch-knob background var 仅依赖 theme.json fallback，fallback 不可靠时
     knob 透明 → 蓝色 switch.on 背景透出 → 现象：'整个按钮变蓝'。
     深色模式没问题因为 .page--dark 显式声明了 —switch-knob。浅色补齐使两者一致。 */
  --switch-knob: #FFFFFF;
  --wheel-opacity-idle: 0.35;
  --wheel-opacity-active: 0.92;
  --wheel-text-idle: rgba(0, 0, 0, 0.12);
  --wheel-text-selected: rgba(0, 0, 0, 0.5);
  /* BUG-20260806-004: 选中态字体淡蓝（D-02 v2.4），语义独立于 --wheel-text-selected */
  --wheel-text-selected-color: #007AFF;
  --wheel-text-active: rgba(0, 0, 0, 0.45);
  --wheel-scale-active: 1.5;
  --wheel-bg-selected: rgba(0, 122, 255, 0.06);
  --flash-tech: #007AFF;
  --flash-world: #5856D6;
  --flash-science: #FF9500;
  --flash-life: #34C759;
  --flash-tech-bg: rgba(0, 122, 255, 0.08);
}

/* 状态栏占位 */
.status-bar {
  flex-shrink: 0;
}

/* BUG-20260806-009 v3（2026-08-06）：状态栏不透明背景层。
   navigationStyle:custom 模式下 wx.setNavigationBarColor 无效（原生导航栏被隐藏），
   微信官方做法 = 页面顶部加 fixed 等高背景层覆盖状态栏区域。
   高度与背景色由页面 WXML 内联注入（height: statusBarHeight; background-color: 页面背景色）。
   z-index 21：高于内容（1~20），低于 nav-bar（22），保证内容滚动不从状态栏区域透出。 */
.status-bar-fill {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 21;
}

/* 全局组件样式 */
.category-tag {
  display: inline-block;
  padding: 3rpx 14rpx;
  border-radius: 16rpx;
  font-size: 18rpx;
  font-weight: 500;
  background-color: var(--tag-bg);
  color: var(--tag-text);
}

/* 全局减弱动效偏好适配（prefers-reduced-motion）。
   所有动画和过渡缩短至 0.01ms，避免 vestibular disorder 用户眩晕。
   微信基础库 2.8.0+ 支持此媒体查询。 */
@media (prefers-reduced-motion: reduce) {
  page, view, scroll-view, swiper, swiper-item, text, image, button, navigator, icon, cover-view, movable-area, movable-view {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
