node_modules/wx-server-sdk

# Notion 同步构建产物（章节切分可重建，仅保留 sync_state.json 用于幂等复用父页）
.notion_build/ch*.md
.notion_build/chapters.json

# Python 缓存
__pycache__/

# Notion 集成 token（本地文件，绝不进仓库）
.notion_token

# GitHub 推送/冲突解决临时脚本（含硬编码 PAT 或一次性工具，绝不进仓库）
push_retry.py
push_retry.sh
resolve_rebase_conflicts.py

# node_modules（云端安装依赖，不入库）
node_modules/

# WorkBuddy 工作区元数据（keys/memory/reports/automation 状态，绝不进仓库）
.workbuddy/

# macOS 系统文件
.DS_Store
**/.DS_Store

# 微信开发者工具私有配置（本机编译/编辑器设置，避免改写 project.config.json 造成 git 冲突）
project.private.config.json

.git-auto/

